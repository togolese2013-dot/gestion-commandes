      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .no-print button:hover { background: #e0e7ff; }
    .no-print a {
      color: #bfdbfe;
      text-decoration: none;
      font-size: 13px;
      font-weight: 600;
    }
