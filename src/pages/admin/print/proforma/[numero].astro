---
import { requireAuth } from '../../../../lib/auth';
import { getOrderByNumber } from '../../../../lib/orders';

const redirect = requireAuth(Astro);
if (redirect) return redirect;

const { numero } = Astro.params;
const order = numero ? getOrderByNumber(numero) : null;

const fmt = (n: number) => n.toLocaleString('fr-FR');
const dateStr = (d: string) => new Date(d).toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });

// Validity: 30 days from today
const today = new Date();
const validityDate = new Date(today.getTime() + 30 * 24 * 60 * 60 * 1000);
const validityStr = validityDate.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });
const todayStr = today.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });

// Estimated delivery: 14 days for air, 45 days for sea
const deliveryDays = order?.delivery_type === 'avion' ? 14 : 45;
const estimatedDeliveryStr = order
  ? dateStr(new Date(new Date(order.created_at!).getTime() + deliveryDays * 24 * 60 * 60 * 1000).toISOString())
  : '';

// Expected deposit (70% of total)
const expectedDeposit = order ? Math.round(order.total_amount * 0.7) : 0;
const expectedBalance = order ? order.total_amount - expectedDeposit : 0;
