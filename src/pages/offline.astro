---
// Offline fallback page — served by Service Worker when network is unavailable
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TOGOLESE — Hors ligne</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #f8fafc;
      color: #1e293b;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px;
      text-align: center;
    }
    .logo {
      width: 80px; height: 80px;
      background: #2563eb;
      border-radius: 20px;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 24px;
      box-shadow: 0 8px 24px rgba(37,99,235,.25);
    }
    .logo span {
      color: white;
      font-size: 40px;
      font-weight: 800;
      letter-spacing: -1px;
    }
    h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 8px; }
    p  { font-size: 0.95rem; color: #64748b; line-height: 1.6; max-width: 320px; }
    .icon {
      font-size: 3rem;
      margin-bottom: 16px;
      display: block;
    }
    .card {
      background: white;
      border-radius: 20px;
      border: 1px solid #e2e8f0;
      padding: 40px 32px;
      max-width: 360px;
      width: 100%;
      box-shadow: 0 4px 24px rgba(0,0,0,.06);
    }
    .retry-btn {
      margin-top: 28px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #2563eb;
      color: white;
      font-weight: 600;
      font-size: 0.9rem;
      padding: 12px 24px;
      border-radius: 12px;
      border: none;
      cursor: pointer;
      transition: background .2s;
      text-decoration: none;
    }
    .retry-btn:hover { background: #1d4ed8; }
    .tips {
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid #f1f5f9;
      font-size: 0.8rem;
      color: #94a3b8;
    }
    .tips ul { list-style: none; text-align: left; }
    .tips li { padding: 3px 0; }
    .tips li::before { content: "→ "; color: #cbd5e1; }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo"><span>T</span></div>
    <span class="icon">📶</span>
    <h1>Vous êtes hors ligne</h1>
    <p>
      Vérifiez votre connexion internet et réessayez.<br/>
      Vos données sont en sécurité.
    </p>
    <button class="retry-btn" onclick="window.location.reload()">
      <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
      </svg>
      Réessayer
    </button>
    <div class="tips">
      <ul>
        <li>Activez votre Wi-Fi ou données mobiles</li>
        <li>Vérifiez votre connexion</li>
        <li>Retournez en arrière et réessayez</li>
      </ul>
    </div>
  </div>
</body>
</html>
