---
import '../styles/global.css';
import { getCurrentUser } from '../lib/auth';

interface Props {
  title: string;
  isAdmin?: boolean;
}

const { title, isAdmin = false } = Astro.props;
const currentUser = isAdmin ? getCurrentUser(Astro.request) : null;
const isAdminRole = currentUser?.role === 'admin';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — Gestion Commandes</title>
    <!-- Apply dark mode before paint to avoid flash -->
    <script is:inline>
      if (localStorage.getItem('theme') === 'dark') document.documentElement.classList.add('dark');
      if (history.scrollRestoration) history.scrollRestoration = 'manual';
    </script>
  </head>
  <body class="bg-gray-50 min-h-screen text-gray-900">
    {isAdmin && (
      <header style="background:#047857;position:sticky;top:0;z-index:100;box-shadow:0 2px 20px rgba(0,0,0,0.18);">
        <div class="max-w-7xl mx-auto px-4 sm:px-6">
          <div class="flex items-center justify-between gap-4 h-16">

            <!-- Logo -->
            <a href="/" class="font-black text-xl shrink-0 text-white" style="letter-spacing:-0.04em;">Togolese.</a>

            <!-- Nav centrale — desktop uniquement -->
            <nav class="hidden sm:flex items-center gap-0.5 text-sm font-medium overflow-x-auto scrollbar-none flex-1 justify-center">
              <a href="/admin/dashboard" class="nav-link py-1.5 px-3 rounded-lg transition-colors whitespace-nowrap" style="color:rgba(255,255,255,0.8);">Dashboard</a>
              <a href="/admin/orders" class="nav-link py-1.5 px-3 rounded-lg transition-colors whitespace-nowrap flex items-center gap-1.5" style="color:rgba(255,255,255,0.8);">
                Commandes
                <span id="pending-badge" class="hidden items-center justify-center min-w-[18px] h-[18px] px-1 bg-red-400 text-white text-[10px] font-bold rounded-full leading-none"></span>
              </a>
              <a href="/admin/inquiries" class="nav-link py-1.5 px-3 rounded-lg transition-colors whitespace-nowrap flex items-center gap-1.5" style="color:rgba(255,255,255,0.8);">
                Demandes
                <span id="inquiry-badge" class="hidden items-center justify-center min-w-[18px] h-[18px] px-1 bg-amber-400 text-white text-[10px] font-bold rounded-full leading-none"></span>
              </a>
              <a href="/admin/analytics" class="nav-link py-1.5 px-3 rounded-lg transition-colors whitespace-nowrap" style="color:rgba(255,255,255,0.8);">📊 Stats</a>
              <a href="/admin/clients" class="nav-link py-1.5 px-3 rounded-lg transition-colors whitespace-nowrap" style="color:rgba(255,255,255,0.8);">Clients</a>
              {isAdminRole && (
                <a href="/admin/payments" class="nav-link py-1.5 px-3 rounded-lg transition-colors whitespace-nowrap" style="color:rgba(255,255,255,0.8);">Paiements</a>
              )}
              {isAdminRole && (
                <a href="/admin/settings" class="nav-link py-1.5 px-3 rounded-lg transition-colors whitespace-nowrap" style="color:rgba(255,255,255,0.8);">Paramètres</a>
              )}
            </nav>

            <!-- Droite : recherche + user + déco -->
            <div class="flex items-center gap-2 shrink-0">
              <div class="relative hidden sm:block" style="width:190px;">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 pointer-events-none" style="color:rgba(255,255,255,0.5);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
                </svg>
                <input
                  id="global-search"
                  type="text"
                  autocomplete="off"
                  placeholder="Rechercher…"
                  class="w-full pl-9 pr-3 py-1.5 rounded-lg text-xs text-white focus:outline-none transition"
                  style="background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.2);"
                />
                <div id="global-results" class="absolute z-30 left-0 right-0 top-full mt-1 bg-white border border-gray-200 rounded-xl shadow-lg hidden overflow-hidden min-w-[320px]"></div>
              </div>
              {currentUser && (
                <button
                  id="profile-btn"
                  class="text-xs font-medium transition-colors whitespace-nowrap cursor-pointer px-2 py-1.5 rounded-lg"
                  style="color:rgba(255,255,255,0.8);"
                  data-id={currentUser.id}
                  data-name={currentUser.full_name}
                >
                  👤 <span class="hidden md:inline">{currentUser.full_name}</span>
                </button>
              )}
              <form action="/api/auth/logout" method="POST" style="display:flex;align-items:center;">
                <button type="submit" class="text-xs transition-colors whitespace-nowrap px-2 py-1.5 rounded-lg" style="color:rgba(255,255,255,0.6);">
                  Déconnexion
                </button>
              </form>
            </div>

          </div>
        </div>
      </header>
    )}

    <!-- Profile edit modal -->
    {isAdmin && currentUser && (
      <div id="profile-modal" class="fixed inset-0 bg-black/40 flex items-center justify-center z-50 hidden">
        <div class="bg-white rounded-2xl shadow-xl p-6 w-full max-w-sm mx-4">
          <h2 class="text-base font-semibold text-gray-900 mb-4">Mon profil</h2>
          <form id="profile-form" class="space-y-3">
            <input type="hidden" name="id" value={currentUser.id} />
            <div>
              <label class="block text-xs font-medium text-gray-600 mb-1">Nom complet</label>
              <input type="text" name="full_name" required value={currentUser.full_name}
                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-600" />
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-600 mb-1">Nouveau mot de passe</label>
              <input type="password" name="password" placeholder="Laisser vide pour ne pas changer"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-600" />
            </div>
            <p id="profile-error" class="text-sm text-red-600 hidden"></p>
            <p id="profile-success" class="text-sm text-green-600 hidden">Modifications enregistrées ✓</p>
            <div class="flex gap-2 pt-1">
              <button type="submit"
                class="flex-1 text-white text-sm font-semibold py-2 rounded-lg transition-colors" style="background:#047857;" onmouseover="this.style.background='#065f46'" onmouseout="this.style.background='#047857'">
                Enregistrer
              </button>
              <button type="button" id="profile-cancel"
                class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold py-2 rounded-lg transition-colors">
                Annuler
              </button>
            </div>
          </form>
        </div>
      </div>
    )}

    <main class="max-w-7xl mx-auto px-3 sm:px-4 py-6 sm:py-8 w-full pb-24 sm:pb-8">
      <slot />
    </main>

    <!-- ── Barre de navigation mobile (sm:hidden) ─────────────────────── -->
    {isAdmin && (
      <>
        <!-- Overlay "Plus" -->
        <div id="mob-more-overlay" class="fixed inset-0 z-40 sm:hidden hidden" style="background:rgba(0,0,0,0.4);">
          <div id="mob-more-sheet" class="absolute bottom-16 left-0 right-0 rounded-t-2xl shadow-2xl overflow-hidden" style="background:#fff;">
            <div class="px-4 pt-4 pb-2">
              <div class="w-10 h-1 rounded-full mx-auto mb-4" style="background:#e2e8f0;"></div>
              <div class="grid grid-cols-2 gap-3">
                <a href="/admin/analytics" class="mob-more-link flex items-center gap-3 px-4 py-3 rounded-xl font-medium text-sm" style="background:#f0fdf4;color:#047857;">
                  <span class="text-xl">📊</span> Stats
                </a>
                <a href="/admin/clients" class="mob-more-link flex items-center gap-3 px-4 py-3 rounded-xl font-medium text-sm" style="background:#f0fdf4;color:#047857;">
                  <span class="text-xl">👥</span> Clients
                </a>
                {isAdminRole && (
                  <a href="/admin/payments" class="mob-more-link flex items-center gap-3 px-4 py-3 rounded-xl font-medium text-sm" style="background:#f0fdf4;color:#047857;">
                    <span class="text-xl">💳</span> Paiements
                  </a>
                )}
                {isAdminRole && (
                  <a href="/admin/settings" class="mob-more-link flex items-center gap-3 px-4 py-3 rounded-xl font-medium text-sm" style="background:#f0fdf4;color:#047857;">
                    <span class="text-xl">⚙️</span> Paramètres
                  </a>
                )}
              </div>
            </div>
            <div class="px-4 pb-4 pt-2 border-t border-gray-100 mt-2">
              <form action="/api/auth/logout" method="POST">
                <button type="submit" class="w-full py-3 rounded-xl text-sm font-medium" style="background:#fef2f2;color:#dc2626;">
                  Déconnexion
                </button>
              </form>
            </div>
          </div>
        </div>

        <!-- Barre fixe bas -->
        <nav class="fixed bottom-0 left-0 right-0 sm:hidden z-50 flex items-stretch" style="background:#047857;box-shadow:0 -2px 16px rgba(0,0,0,0.18);padding-bottom:env(safe-area-inset-bottom);">

          <!-- Dashboard -->
          <a href="/admin/dashboard" class="mob-tab nav-link flex-1 flex flex-col items-center justify-center gap-0.5 py-2" style="color:rgba(255,255,255,0.7);">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            <span class="text-[10px] font-medium leading-none">Dashboard</span>
          </a>

          <!-- Commandes -->
          <a href="/admin/orders" class="mob-tab nav-link flex-1 flex flex-col items-center justify-center gap-0.5 py-2 relative" style="color:rgba(255,255,255,0.7);">
            <span id="mob-pending-badge" class="hidden absolute top-1.5 right-5 items-center justify-center min-w-[16px] h-4 px-1 bg-red-400 text-white text-[9px] font-bold rounded-full leading-none"></span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
            <span class="text-[10px] font-medium leading-none">Commandes</span>
          </a>

          <!-- Demandes -->
          <a href="/admin/inquiries" class="mob-tab nav-link flex-1 flex flex-col items-center justify-center gap-0.5 py-2 relative" style="color:rgba(255,255,255,0.7);">
            <span id="mob-inquiry-badge" class="hidden absolute top-1.5 right-5 items-center justify-center min-w-[16px] h-4 px-1 bg-amber-400 text-white text-[9px] font-bold rounded-full leading-none"></span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
            <span class="text-[10px] font-medium leading-none">Demandes</span>
          </a>

          <!-- Plus -->
          <button id="mob-more-btn" class="flex-1 flex flex-col items-center justify-center gap-0.5 py-2" style="color:rgba(255,255,255,0.7);background:transparent;border:none;cursor:pointer;">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
            <span class="text-[10px] font-medium leading-none">Plus</span>
          </button>

        </nav>
      </>
    )}

    <!-- Toast container -->
    <div id="toast-container"></div>

    <!-- Dark mode toggle + global toast function -->
    <script is:inline>
      // ── Active nav link ───────────────────────────────────────────────────
      (function () {
        var path = window.location.pathname;
        document.querySelectorAll('.nav-link').forEach(function (a) {
          var href = a.getAttribute('href');
          if (!href) return;
          var active = href === '/admin' ? path === '/admin' : path === href || path.startsWith(href + '/');
          if (active) {
            a.classList.add('active');
            // Mobile tab: full opacity
            if (a.classList.contains('mob-tab')) {
              a.style.color = 'white';
            }
          }
        });
      })();

      // ── Mobile more drawer ────────────────────────────────────────────────
      (function () {
        var overlay = document.getElementById('mob-more-overlay');
        var btn     = document.getElementById('mob-more-btn');
        if (!overlay || !btn) return;
        function openMore() {
          overlay.classList.remove('hidden');
          overlay.classList.add('flex');
          overlay.style.alignItems = 'flex-end';
        }
        function closeMore() {
          overlay.classList.add('hidden');
          overlay.classList.remove('flex');
        }
        btn.addEventListener('click', function () {
          overlay.classList.contains('hidden') ? openMore() : closeMore();
        });
        overlay.addEventListener('click', function (e) {
          if (e.target === overlay) closeMore();
        });
        // Active state for "Plus" links
        var path = window.location.pathname;
        var moreLinks = ['/admin/analytics', '/admin/clients', '/admin/payments', '/admin/settings'];
        if (moreLinks.some(function(l){ return path === l || path.startsWith(l + '/'); })) {
          btn.style.color = 'white';
        }
      })();

      // ── Dark mode icons ───────────────────────────────────────────────────
      (function () {
        const moonIcon = document.getElementById('icon-moon');
        const sunIcon  = document.getElementById('icon-sun');
        function updateIcons() {
          const dark = document.documentElement.classList.contains('dark');
          if (moonIcon) moonIcon.classList.toggle('hidden', dark);
          if (sunIcon)  sunIcon.classList.toggle('hidden', !dark);
        }
        updateIcons();
        document.getElementById('dark-toggle')?.addEventListener('click', function () {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
          updateIcons();
        });
      })();

      // ── Toast notifications ───────────────────────────────────────────────
      window.__showToast = function (message, type, duration) {
        type     = type     || 'info';
        duration = duration || 3500;
        var container = document.getElementById('toast-container');
        if (!container) return;
        var icons = { success: '✓', error: '✕', warning: '⚠', info: 'ℹ' };
        var toast = document.createElement('div');
        toast.className = 'toast toast-' + type;
        toast.innerHTML = '<span>' + (icons[type] || '') + '</span><span>' + message + '</span>';
        container.appendChild(toast);
        setTimeout(function () {
          toast.classList.add('hide');
          toast.addEventListener('animationend', function () { toast.remove(); }, { once: true });
        }, duration);
      };
    </script>

    {isAdmin && currentUser && (
      <script>
        const modal   = document.getElementById('profile-modal')!;
        const form    = document.getElementById('profile-form') as HTMLFormElement;
        const errEl   = document.getElementById('profile-error')!;
        const okEl    = document.getElementById('profile-success')!;

        document.getElementById('profile-btn')?.addEventListener('click', () => {
          errEl.classList.add('hidden');
          okEl.classList.add('hidden');
          (form.querySelector('[name=password]') as HTMLInputElement).value = '';
          modal.classList.remove('hidden');
        });

        document.getElementById('profile-cancel')?.addEventListener('click', () => modal.classList.add('hidden'));
        modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.add('hidden'); });

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          errEl.classList.add('hidden');
          okEl.classList.add('hidden');
          const id        = (form.querySelector('[name=id]') as HTMLInputElement).value;
          const full_name = (form.querySelector('[name=full_name]') as HTMLInputElement).value.trim();
          const password  = (form.querySelector('[name=password]') as HTMLInputElement).value.trim();

          const body: Record<string, string> = { full_name };
          if (password) body.password = password;

          const res = await fetch(`/api/users/${id}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });

          if (res.ok) {
            okEl.classList.remove('hidden');
            // Update displayed name in header
            const btn = document.getElementById('profile-btn');
            if (btn) btn.textContent = '👤 ' + full_name;
            setTimeout(() => modal.classList.add('hidden'), 1000);
          } else {
            const err = await res.json();
            errEl.textContent = err.error ?? 'Erreur';
            errEl.classList.remove('hidden');
          }
        });

        // ── Badge commandes en attente ────────────────────────────────────────
        function setBadge(ids: string[], count: number) {
          ids.forEach(id => {
            const badge = document.getElementById(id);
            if (!badge) return;
            if (count > 0) {
              badge.textContent = count > 99 ? '99+' : String(count);
              badge.classList.remove('hidden');
              badge.classList.add('inline-flex');
            } else {
              badge.classList.add('hidden');
              badge.classList.remove('inline-flex');
            }
          });
        }
        async function updatePendingBadge() {
          try {
            const res = await fetch('/api/orders/count');
            if (!res.ok) return;
            const { en_attente } = await res.json();
            setBadge(['pending-badge', 'mob-pending-badge'], en_attente);
          } catch { /* silent */ }
        }
        updatePendingBadge();
        setInterval(updatePendingBadge, 30_000);

        // ── Badge demandes en attente ─────────────────────────────────────────
        async function updateInquiryBadge() {
          try {
            const res = await fetch('/api/inquiries/count');
            if (!res.ok) return;
            const { en_attente } = await res.json();
            setBadge(['inquiry-badge', 'mob-inquiry-badge'], en_attente);
          } catch { /* silent */ }
        }
        updateInquiryBadge();
        setInterval(updateInquiryBadge, 30_000);

        // ── Recherche globale ─────────────────────────────────────────────────
        const globalSearch  = document.getElementById('global-search') as HTMLInputElement | null;
        const globalResults = document.getElementById('global-results')!;

        const statusIcon: Record<string, string> = {
          en_attente: '⏳',
          disponible: '✅',
          recupere:   '📦',
        };

        function esc(s: string) {
          return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        function renderGlobalResults(data: { orders: any[]; clients: any[] }) {
          const { orders, clients } = data;
          if (!orders.length && !clients.length) {
            globalResults.innerHTML = '<div class="px-4 py-3 text-sm text-gray-400">Aucun résultat</div>';
            globalResults.classList.remove('hidden');
            return;
          }
          let html = '';
          if (orders.length) {
            html += `<div class="px-3 py-1.5 text-[10px] font-bold text-gray-400 uppercase tracking-wider bg-gray-50 border-b border-gray-100">Commandes</div>`;
            html += orders.map((o: any) => `
              <a href="/admin/orders" data-order="${esc(o.order_number)}"
                class="search-order-link flex items-center justify-between gap-3 px-4 py-2.5 hover:bg-emerald-50 transition-colors border-b border-gray-50">
                <div>
                  <span class="font-mono text-xs font-bold text-emerald-700">${esc(o.order_number)}</span>
                  <span class="ml-2 text-sm text-gray-700">${esc(o.client_name)}</span>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <span class="text-xs">${statusIcon[o.status] ?? ''}</span>
                  <span class="text-xs text-gray-500 font-semibold">${Number(o.total_amount).toLocaleString('fr-FR')} F</span>
                </div>
              </a>`).join('');
          }
          if (clients.length) {
            html += `<div class="px-3 py-1.5 text-[10px] font-bold text-gray-400 uppercase tracking-wider bg-gray-50 border-b border-gray-100 ${orders.length ? 'border-t border-gray-200' : ''}">Clients</div>`;
            html += clients.map((c: any) => `
              <a href="/admin/clients"
                class="flex items-center justify-between gap-3 px-4 py-2.5 hover:bg-emerald-50 transition-colors border-b border-gray-50">
                <span class="text-sm font-medium text-gray-900">${esc(c.name)}</span>
                <span class="text-xs text-gray-400 font-mono">${esc(c.phone)}</span>
              </a>`).join('');
          }
          globalResults.innerHTML = html;
          globalResults.classList.remove('hidden');
        }

        let searchTimer: ReturnType<typeof setTimeout>;
        globalSearch?.addEventListener('input', () => {
          clearTimeout(searchTimer);
          const q = globalSearch.value.trim();
          if (q.length < 2) { globalResults.classList.add('hidden'); return; }
          searchTimer = setTimeout(async () => {
            try {
              const res = await fetch(`/api/search?q=${encodeURIComponent(q)}`);
              if (res.ok) renderGlobalResults(await res.json());
            } catch { /* silent */ }
          }, 200);
        });

        globalSearch?.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') { globalResults.classList.add('hidden'); globalSearch.blur(); }
        });

        document.addEventListener('click', (e) => {
          if (!globalSearch?.contains(e.target as Node) && !globalResults.contains(e.target as Node)) {
            globalResults.classList.add('hidden');
          }
        });

        // ── Raccourcis clavier ────────────────────────────────────────────────
        document.addEventListener('keydown', (e) => {
          const tag = (e.target as HTMLElement).tagName;
          if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
          if (e.metaKey || e.ctrlKey || e.altKey) return;
          switch (e.key.toLowerCase()) {
            case 'n': window.location.href = '/admin'; break;
            case 'o': window.location.href = '/admin/orders'; break;
            case 'c': window.location.href = '/admin/clients'; break;
          }
        });
      </script>
    )}
  </body>
</html>
