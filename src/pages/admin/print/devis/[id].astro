---
import { requireAuth } from '../../../../lib/auth';
import { getDevisById } from '../../../../lib/devis';

const redirect = requireAuth(Astro);
if (redirect) return redirect;

const { id } = Astro.params;
const devis = id ? getDevisById(parseInt(id)) : null;

const fmt = (n: number) => n.toLocaleString('fr-FR');
const dateStr = (d: string) => new Date(d).toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });
const today = new Date();
const todayStr = today.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Devis {devis?.devis_number ?? ''} — TOGOLESE</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Helvetica Neue', Arial, sans-serif;
      font-size: 13px;
      color: #111827;
      background: #fff;
      padding: 0;
    }

    /* ── Screen wrapper ── */
    .page-wrapper {
      max-width: 794px;
      margin: 0 auto;
      padding: 32px;
      background: #fff;
    }

    /* ── Print toolbar ── */
    .print-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      background: #047857;
      color: #fff;
      font-size: 13px;
      font-weight: 600;
      gap: 12px;
      margin-bottom: 32px;
      border-radius: 10px;
    }
    .print-bar button {
      padding: 8px 20px;
      background: #fff;
      color: #047857;
      border: none;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
    }
    .print-bar button:hover { background: #ecfdf5; }
    .back-link { color: #d1fae5; text-decoration: none; font-size: 13px; }
    .back-link:hover { color: #fff; }

    /* ── Document ── */
    .doc {
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      overflow: hidden;
    }

    /* Header */
    .doc-header {
      background: linear-gradient(135deg, #047857 0%, #059669 100%);
      color: #fff;
      padding: 32px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }
    .company-name { font-size: 28px; font-weight: 900; letter-spacing: -0.03em; }
    .company-tagline { font-size: 12px; color: #a7f3d0; margin-top: 4px; }
    .doc-type { text-align: right; }
    .doc-type-label { font-size: 11px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: #a7f3d0; }
    .doc-type-number { font-size: 24px; font-weight: 900; font-family: monospace; letter-spacing: 1px; margin-top: 4px; }
    .doc-type-date { font-size: 12px; color: #d1fae5; margin-top: 4px; }

    /* Client + meta strip */
    .doc-meta {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      border-bottom: 1px solid #e5e7eb;
    }
    .doc-meta-block { padding: 20px 24px; }
    .doc-meta-block:first-child { border-right: 1px solid #e5e7eb; }
    .meta-label { font-size: 10px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: #9ca3af; margin-bottom: 6px; }
    .meta-value { font-size: 14px; font-weight: 700; color: #111827; }
    .meta-sub { font-size: 12px; color: #6b7280; margin-top: 2px; }

    /* Products table */
    .products-section { padding: 24px; }
    .products-title { font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: #9ca3af; margin-bottom: 12px; }
    table { width: 100%; border-collapse: collapse; }
    thead tr { background: #f9fafb; border-bottom: 2px solid #e5e7eb; }
    th { padding: 10px 12px; text-align: left; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #6b7280; }
    th:last-child, td:last-child { text-align: right; }
    tbody tr { border-bottom: 1px solid #f3f4f6; }
    tbody tr:last-child { border-bottom: none; }
    td { padding: 12px; font-size: 13px; color: #374151; vertical-align: top; }
    .td-name { font-weight: 600; color: #111827; }
    .td-state { font-size: 11px; color: #9ca3af; font-weight: 400; }
    .td-subtotal { font-weight: 700; color: #111827; white-space: nowrap; }

    /* Totals */
    .totals-section {
      border-top: 2px solid #e5e7eb;
      padding: 20px 24px;
      display: flex;
      justify-content: flex-end;
    }
    .totals-table { width: 280px; }
    .totals-row { display: flex; justify-content: space-between; align-items: center; padding: 5px 0; font-size: 13px; }
    .totals-row.total-row {
      border-top: 2px solid #047857;
      margin-top: 6px;
      padding-top: 10px;
      font-size: 16px;
      font-weight: 900;
      color: #047857;
    }
    .totals-label { color: #6b7280; }
    .totals-value { font-weight: 700; color: #111827; }

    /* Info strip */
    .info-strip {
      background: #f0fdf4;
      border-top: 1px solid #d1fae5;
      padding: 16px 24px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    .info-item-label { font-size: 10px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: #059669; margin-bottom: 3px; }
    .info-item-value { font-size: 13px; font-weight: 600; color: #111827; }

    /* Footer */
    .doc-footer {
      padding: 16px 24px;
      border-top: 1px solid #e5e7eb;
      text-align: center;
      font-size: 11px;
      color: #9ca3af;
    }

    /* Error state */
    .error-page { padding: 80px; text-align: center; color: #6b7280; }

    /* ── Print styles ── */
    @media print {
      body { padding: 0; }
      .page-wrapper { padding: 0; max-width: none; }
      .print-bar { display: none !important; }
      .doc { border: none; border-radius: 0; }
      .doc-header { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .info-strip { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      @page { margin: 12mm 14mm; size: A4; }
    }
  </style>
</head>
<body>
  {!devis ? (
    <div class="page-wrapper">
      <div class="error-page">
        <p style="font-size:32px;margin-bottom:12px;">📄</p>
        <p style="font-size:18px;font-weight:700;color:#111827;">Devis introuvable</p>
        <p style="margin-top:8px;">Vérifiez l'identifiant ou <a href="/admin/inquiries" style="color:#047857;">retournez aux demandes</a>.</p>
      </div>
    </div>
  ) : (
    <div class="page-wrapper">
      <!-- Print toolbar (hidden when printing) -->
      <div class="print-bar">
        <a href="/admin/inquiries" class="back-link">← Retour aux demandes</a>
        <span>Devis {devis.devis_number} · {devis.client_name}</span>
        <button onclick="window.print()">🖨️ Imprimer / PDF</button>
      </div>

      <!-- Document -->
      <div class="doc">
        <!-- Header -->
        <div class="doc-header">
          <div>
            <div class="company-name">Togolese.</div>
            <div class="company-tagline">Importateur depuis 2018 - www.togolese.fr</div>
          </div>
          <div class="doc-type">
            <div class="doc-type-label">Devis</div>
            <div class="doc-type-number">{devis.devis_number}</div>
            <div class="doc-type-date">Émis le {dateStr(devis.created_at!)}</div>
          </div>
        </div>

        <!-- Client + info -->
        <div class="doc-meta">
          <div class="doc-meta-block">
            <div class="meta-label">Client</div>
            <div class="meta-value">{devis.client_name}</div>
            <div class="meta-sub">{devis.client_phone}</div>
          </div>
          <div class="doc-meta-block">
            <div class="meta-label">Détails</div>
            <div class="meta-value">{devis.delivery_type === 'avion' ? '✈️ Express (Avion)' : '🚢 Économique (Bateau)'}</div>
            <div class="meta-sub">Livraison estimée : {devis.estimated_delivery}</div>
          </div>
        </div>

        <!-- Products -->
        <div class="products-section">
          <div class="products-title">Produits</div>
          <table>
            <thead>
              <tr>
                <th style="width:40%">Désignation</th>
                <th style="width:10%;text-align:center">Qté</th>
                <th style="width:10%;text-align:center">État</th>
                <th style="width:20%;text-align:right">Prix unit.</th>
                <th style="width:20%">Sous-total</th>
              </tr>
            </thead>
            <tbody>
              {devis.products_summary.map((p: any) => (
                <tr>
                  <td class="td-name">{p.name}</td>
                  <td style="text-align:center">{p.quantity || 1}</td>
                  <td style="text-align:center"><span class="td-state">{p.state || p.condition || '—'}</span></td>
                  <td style="text-align:right">{fmt(p.price || p.budget || 0)} FCFA</td>
                  <td class="td-subtotal">{fmt((p.price || p.budget || 0) * (p.quantity || 1))} FCFA</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Totals -->
        <div class="totals-section">
          <div class="totals-table">
            <div class="totals-row">
              <span class="totals-label">Sous-total</span>
              <span class="totals-value">{fmt(devis.total_amount)} FCFA</span>
            </div>
            <div class="totals-row total-row">
              <span>Total</span>
              <span>{fmt(devis.total_amount)} FCFA</span>
            </div>
          </div>
        </div>

        <!-- Payment info strip -->
        <div class="info-strip">
          <div>
            <div class="info-item-label">Acompte (70%)</div>
            <div class="info-item-value">{fmt(devis.acompte_amount)} FCFA</div>
          </div>
          <div>
            <div class="info-item-label">Solde (30%)</div>
            <div class="info-item-value">{fmt(devis.solde_amount)} FCFA</div>
          </div>
          <div>
            <div class="info-item-label">Validité</div>
            <div class="info-item-value">Jusqu'au {devis.validity_until}</div>
          </div>
        </div>

        <!-- Footer -->
        <div class="doc-footer">
          Document généré le {todayStr} · Togolese Group · Ce devis est valable {devis.validity_days} jours
        </div>
      </div>
    </div>
  )}
</body>
</html>
