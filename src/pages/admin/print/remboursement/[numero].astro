---
import { requireAuth } from '../../../../lib/auth';
import { getOrderByNumber, getPaymentsByOrderId } from '../../../../lib/orders';

const redirect = requireAuth(Astro);
if (redirect) return redirect;

const { numero } = Astro.params;
const order = numero ? getOrderByNumber(numero) : null;
const payments = order?.id ? getPaymentsByOrderId(order.id) : [];

const fmt = (n: number) => n.toLocaleString('fr-FR');
const dateStr = (d: string) =>
  new Date(d).toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });

const today = dateStr(new Date().toISOString());
const todayISO = new Date().toISOString().split('T')[0];

const refEngagement = order ? `ENG-${order.order_number}` : '—';

const totalPaid = payments.reduce((sum, p) => sum + p.amount, order?.deposit ?? 0);
const montantARembourser = order ? Math.min(totalPaid, order.total_amount) : 0;

const orderDateStr = order?.created_at ? dateStr(order.created_at) : '—';
const motif = (order as any)?.cancellation_reason ?? order?.notes ?? 'Colis non livré / perdu en transit';
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Engagement de Remboursement — {order?.order_number ?? 'introuvable'}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;
      font-size: 13px; color: #111; background: #f3f4f6;
    }

    .no-print {
      position: sticky; top: 0; z-index: 100;
      background: #1e40af; padding: 10px 24px;
      display: flex; align-items: center; gap: 16px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.15); flex-wrap: wrap;
    }
    .no-print button {
      background: #fff; color: #1e40af; border: none; border-radius: 6px;
      padding: 8px 18px; font-size: 14px; font-weight: 700; cursor: pointer;
      display: flex; align-items: center; gap: 6px; font-family: inherit;
    }
    .no-print button:hover { background: #e0e7ff; }
    .no-print a { color: #bfdbfe; text-decoration: none; font-size: 13px; font-weight: 600; }
    .no-print a:hover { color: #fff; }
    .no-print .spacer { flex: 1; }
    .no-print .hint { color: #93c5fd; font-size: 12px; }
    .date-field {
      display: flex; align-items: center; gap: 8px;
      background: rgba(255,255,255,0.15); border-radius: 6px; padding: 6px 12px;
    }
    .date-field label { color: #bfdbfe; font-size: 12px; font-weight: 600; white-space: nowrap; }
    .date-field input[type="date"] {
      background: #fff; color: #1e40af; border: none; border-radius: 4px;
      padding: 4px 8px; font-size: 13px; font-weight: 600; font-family: inherit; cursor: pointer;
    }

    .page-wrapper {
      display: flex; flex-direction: column; align-items: center;
      padding: 24px 16px 48px;
    }
    .page {
      background: #fff; width: 210mm; min-height: 297mm;
      padding: 15mm 18mm 14mm;
      box-shadow: 0 4px 24px rgba(0,0,0,0.10);
      border-radius: 4px; display: flex; flex-direction: column;
    }

    .doc-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px; }
    .logo-t {
      width: 48px; height: 48px; background: #1e40af; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 24px; font-weight: 900; flex-shrink: 0;
    }
    .contact-block { text-align: right; font-size: 11px; color: #111; line-height: 1.75; }
    .contact-block strong { color: #1e40af; }
    .divider { height: 3px; background: linear-gradient(90deg,#1e40af 0%,#3b82f6 60%,#bfdbfe 100%); border-radius: 2px; margin: 8px 0 18px; }

    .doc-ref-row { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 20px; }
    .doc-badge {
      display: inline-flex; align-items: center;
      background: #1e40af; color: #fff;
      font-size: 12px; font-weight: 800; letter-spacing: 1.5px;
      padding: 7px 16px; border-radius: 6px; text-transform: uppercase;
    }
    .doc-num {
      font-family: 'Courier New', Courier, monospace;
      font-size: 12px; font-weight: 700; color: #1e40af;
      background: #eff6ff; border: 1.5px solid #bfdbfe;
      padding: 4px 12px; border-radius: 5px; letter-spacing: 0.5px; margin-top: 7px;
    }
    .doc-meta { text-align: right; font-size: 11.5px; color: #111; line-height: 1.75; }
    .doc-meta strong { display: block; font-size: 13px; }

    .parties-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 22px; }
    .partie-box { border: 1px solid #111; border-radius: 6px; overflow: hidden; }
    .partie-hd {
      background: #f8fafc; border-bottom: 1px solid #111;
      padding: 6px 14px; font-size: 9.5px; font-weight: 800;
      text-transform: uppercase; letter-spacing: 1.2px; color: #111;
    }
    .partie-body { padding: 11px 14px; line-height: 1.9; font-size: 12.5px; }
    .partie-body .nom { font-size: 14px; font-weight: 700; color: #1e40af; }
    .partie-lbl { font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #555; }

    .objet-box {
      background: #eff6ff; border-left: 4px solid #1e40af;
      border-radius: 0 6px 6px 0; padding: 12px 16px; margin-bottom: 22px;
    }
    .objet-box p { font-size: 12.5px; color: #111; line-height: 1.75; }

    .article { margin-bottom: 16px; }
    .article-title {
      font-size: 11px; font-weight: 800; text-transform: uppercase;
      letter-spacing: 1px; color: #1e40af; margin-bottom: 6px;
      padding-bottom: 4px; border-bottom: 1px solid #bfdbfe;
    }
    .article-body { font-size: 12.5px; color: #111; line-height: 1.85; text-align: justify; }

    .recap-table { width: 100%; border-collapse: collapse; margin: 10px 0 0; font-size: 12.5px; }
    .recap-table th {
      background: #1e40af; color: #fff; padding: 7px 12px;
      text-align: left; font-size: 10px; text-transform: uppercase; letter-spacing: 0.8px;
    }
    .recap-table th:last-child { text-align: right; }
    .recap-table td { padding: 8px 12px; border-bottom: 1px solid #e5e7eb; color: #111; }
    .recap-table td:last-child { text-align: right; font-weight: 700; }
    .recap-table tr:nth-child(even) { background: #f8fafc; }
    .recap-table tfoot td {
      background: #eff6ff; font-weight: 700; color: #1e40af;
      border-top: 2px solid #bfdbfe; font-size: 14px;
    }
    .recap-table tfoot td:last-child { text-align: right; font-size: 16px; }

    .engagement-strong {
      background: #fff7ed; border: 1.5px solid #fed7aa; border-radius: 8px;
      padding: 14px 18px; margin-bottom: 20px;
    }
    .engagement-strong p { font-size: 12.5px; color: #111; line-height: 1.8; }

    .error-page {
      display: flex; flex-direction: column; align-items: center;
      justify-content: center; min-height: 300px; gap: 12px; color: #6b7280;
    }
    .error-page h2 { font-size: 20px; color: #374151; font-weight: 700; }

    .sig-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: auto; padding-top: 24px; }
    .sig-box { border: 1.5px dashed #aaa; border-radius: 6px; padding: 14px 18px; min-height: 120px; display: flex; flex-direction: column; }
    .sig-title { font-size: 9.5px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.2px; color: #111; margin-bottom: 5px; }
    .sig-name { font-size: 12px; color: #111; font-weight: 600; }
    .sig-role { font-size: 10px; color: #6b7280; margin-bottom: auto; }
    .sig-line { border-bottom: 1px solid #111; margin-top: auto; margin-bottom: 6px; }
    .sig-hint { font-size: 9.5px; color: #6b7280; font-style: italic; }

    .doc-footer {
      margin-top: 20px; padding-top: 10px; border-top: 1px solid #111;
      text-align: center; font-size: 10px; color: #111; line-height: 1.7;
    }
    .doc-footer strong { font-size: 11.5px; display: block; margin-bottom: 2px; }

    @media print {
      * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
      .no-print { display: none !important; }
      body { background: #fff !important; }
      .page-wrapper { padding: 0 !important; }
      .page { width: 100% !important; min-height: auto !important; box-shadow: none !important; border-radius: 0 !important; padding: 15mm 18mm 14mm !important; }
      @page { size: A4; margin: 0; }
    }
  </style>
</head>
<body>

  <div class="no-print">
    <button onclick="window.print()">
      <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
      </svg>
      Imprimer / PDF
    </button>
    <a href="/admin/orders">← Retour aux commandes</a>
    <div class="date-field">
      <label for="deadline-input">Date limite de remboursement :</label>
      <input type="date" id="deadline-input" value={todayISO} />
    </div>
    <span class="spacer"></span>
    {order && <span class="hint">Engagement · {refEngagement}</span>}
  </div>

  <div class="page-wrapper">
    <div class="page">

      {!order ? (
        <div class="error-page">
          <svg width="48" height="48" fill="none" stroke="#d1d5db" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
          <h2>Commande introuvable</h2>
          <p>Le numéro <strong>{numero}</strong> n'existe pas.</p>
          <a href="/admin/orders" style="margin-top:8px; color:#1e40af; font-weight:600;">← Retour aux commandes</a>
        </div>
      ) : (
        <>
          <div class="doc-header">
            <div style="display:flex; align-items:center; gap:12px;">
              <div class="logo-t">T</div>
              <div>
                <div style="font-size:24px; font-weight:900; color:#111; letter-spacing:-0.5px; line-height:1;">Togolese.</div>
                <div style="font-size:10px; color:#6b7280; margin-top:3px;">togolese.fr · Import depuis l'étranger</div>
              </div>
            </div>
            <div class="contact-block">
              <div>Kégué derrière l'hôtel O'Balkan, Lomé - TOGO</div>
              <div><strong>Tél :</strong> +228 90 22 64 91</div>
              <div><strong>Email :</strong> contact@togolese.fr</div>
            </div>
          </div>
          <div class="divider"></div>

          <div class="doc-ref-row">
            <div>
              <span class="doc-badge">Lettre d'Engagement de Remboursement</span>
              <div class="doc-num">{refEngagement}</div>
              <div style="font-size:10px; color:#6b7280; margin-top:4px;">Réf. commande : {order.order_number}</div>
            </div>
            <div class="doc-meta">
              <span style="font-size:10px; color:#555; text-transform:uppercase; letter-spacing:0.8px;">Lomé, le</span>
              <strong>{today}</strong>
            </div>
          </div>

          <div class="parties-grid">
            <div class="partie-box">
              <div class="partie-hd">L'Engagé — TOGOLESE</div>
              <div class="partie-body">
                <div class="nom">TOGOLESE</div>
                <div style="margin-top:6px;"><span class="partie-lbl">Représenté par</span><br/>Kent · Gérant</div>
                <div style="margin-top:5px;"><span class="partie-lbl">Adresse</span><br/>Kégué derrière l'hôtel O'Balkan, Lomé</div>
                <div style="margin-top:5px;"><span class="partie-lbl">Contact</span><br/>+228 90 22 64 91 · contact@togolese.fr</div>
              </div>
            </div>
            <div class="partie-box">
              <div class="partie-hd">Le Bénéficiaire — Client</div>
              <div class="partie-body">
                <div class="nom">{order.client_name}</div>
                <div style="margin-top:6px;"><span class="partie-lbl">Téléphone</span><br/>{order.client_phone}</div>
                <div style="margin-top:5px;"><span class="partie-lbl">Commande concernée</span><br/><span style="font-family:'Courier New',monospace; font-size:12px; color:#1e40af;">{order.order_number}</span></div>
                <div style="margin-top:5px;"><span class="partie-lbl">Date de commande</span><br/>{orderDateStr}</div>
              </div>
            </div>
          </div>

          <div class="objet-box">
            <p>
              <strong>Objet :</strong> Engagement ferme de remboursement suite à la non-livraison de la commande&nbsp;
              <span style="font-family:'Courier New',monospace; font-weight:700; color:#1e40af;">{order.order_number}</span>
              &nbsp;passée le {orderDateStr} pour un montant total de <strong>{fmt(order.total_amount)} FCFA</strong>.
            </p>
          </div>

          <div class="article">
            <div class="article-title">Article 1 — Constat de non-livraison</div>
            <div class="article-body">
              TOGOLESE reconnaît que la commande <strong style="font-family:'Courier New',monospace;">{order.order_number}</strong>,
              passée par <strong>{order.client_name}</strong> le {orderDateStr}, n'a pas pu être livrée dans les délais convenus.
              Motif : <strong>{motif}</strong>.
              TOGOLESE assume l'entière responsabilité de ce manquement et s'engage à y remédier par le remboursement intégral des sommes versées par le client.
            </div>
          </div>

          <div class="article">
            <div class="article-title">Article 2 — Montants versés et à rembourser</div>
            <div class="article-body" style="margin-bottom:8px;">
              Les sommes ci-dessous ont été reçues par TOGOLESE au titre de la commande mentionnée :
            </div>
            <table class="recap-table">
              <thead>
                <tr>
                  <th>Nature du versement</th>
                  <th>Date</th>
                  <th style="text-align:right;">Montant</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Acompte à la commande</td>
                  <td>{orderDateStr}</td>
                  <td style="text-align:right;">{fmt(order.deposit)} FCFA</td>
                </tr>
                {payments.filter(p => p.amount > 0).map((p) => (
                  <tr>
                    <td>Versement complémentaire</td>
                    <td>{p.created_at ? dateStr(p.created_at) : '—'}</td>
                    <td style="text-align:right;">{fmt(p.amount)} FCFA</td>
                  </tr>
                ))}
              </tbody>
              <tfoot>
                <tr>
                  <td colspan="2">Total à rembourser</td>
                  <td style="text-align:right; font-size:15px;">{fmt(montantARembourser)} FCFA</td>
                </tr>
              </tfoot>
            </table>
          </div>

          <div class="article">
            <div class="article-title">Article 3 — Engagement ferme de remboursement</div>
            <div class="article-body">
              TOGOLESE s'engage irrévocablement à rembourser la somme de <strong style="color:#1e40af;">{fmt(montantARembourser)} FCFA</strong> à <strong>{order.client_name}</strong>
              au plus tard le <strong style="color:#1e40af;" id="deadline-display">—</strong>,
              selon les modalités convenues entre les parties.
              Le paiement sera effectué selon le mode suivant : <strong>___________________________________</strong>.
              Passé ce délai, et sans accord écrit des deux parties pour un report, TOGOLESE s'expose à une majoration de <strong>2 000 FCFA par semaine</strong> de retard.
            </div>
          </div>

          <div class="article">
            <div class="article-title">Article 4 — Effets de la présente lettre</div>
            <div class="article-body">
              La signature de la présente lettre par les deux parties vaut accord sur les montants, les délais et les modalités de remboursement.
              Le remboursement effectif sera constaté par un <strong>Bon de Remboursement</strong> (réf. BDR-{order.order_number}) remis au client lors du versement,
              lequel constituera la décharge définitive de toute créance liée à la commande {order.order_number}.
              La présente lettre est établie en deux (2) exemplaires originaux, un pour chaque partie.
            </div>
          </div>

          <div class="engagement-strong">
            <p>
              <strong>Engagement de TOGOLESE :</strong> Je soussigné Kent, gérant de TOGOLESE, m'engage personnellement et au nom de la société à honorer le remboursement de <strong>{fmt(montantARembourser)} FCFA</strong> dans les conditions et délais stipulés aux articles ci-dessus.
              Tout manquement pourra faire l'objet d'une réclamation auprès des juridictions compétentes de Lomé, Togo.
            </p>
          </div>

          <div class="sig-grid">
            <div class="sig-box">
              <div class="sig-title">Lu et approuvé — Le Bénéficiaire</div>
              <div class="sig-name">{order.client_name}</div>
              <div class="sig-role">Client — « Lu et approuvé, bon pour accord »</div>
              <div class="sig-line"></div>
              <div class="sig-hint">Signature + date : ____________________</div>
            </div>
            <div class="sig-box">
              <div class="sig-title">L'Engagé — TOGOLESE</div>
              <div class="sig-name">Kent · Gérant</div>
              <div class="sig-role">Cachet officiel + Signature</div>
              <div class="sig-line"></div>
              <div class="sig-hint">Fait à Lomé, le {today}</div>
            </div>
          </div>

          <div class="doc-footer">
            <strong>TOGOLESE — Lettre d'Engagement de Remboursement {refEngagement}</strong>
            Document établi en 2 exemplaires originaux · togolese.fr · contact@togolese.fr · +228 90 22 64 91
          </div>
        </>
      )}

    </div>
  </div>

  <script>
    const input = document.getElementById('deadline-input') as HTMLInputElement;
    const display = document.getElementById('deadline-display');

    function updateDeadline() {
      if (!input || !display) return;
      const val = input.value;
      if (!val) { display.textContent = '—'; return; }
      const d = new Date(val + 'T12:00:00');
      display.textContent = d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });
    }

    input?.addEventListener('change', updateDeadline);
    updateDeadline();
  </script>

</body>
</html>
