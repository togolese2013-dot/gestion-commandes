---
import Layout from '../../layouts/Layout.astro';
import { requireAuth, getCurrentUser } from '../../lib/auth';
import { getActivityLogs, ACTION_LABELS, ENTITY_COLORS, ACTION_COLORS } from '../../lib/audit';

const redirect = requireAuth(Astro);
if (redirect) return redirect;

const currentUser = getCurrentUser(Astro.request);

// Pagination & filter from query params
const PAGE_SIZE = 50;
const rawPage   = parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const page      = isNaN(rawPage) || rawPage < 1 ? 1 : rawPage;
const filter    = Astro.url.searchParams.get('type') ?? 'all';

const { logs, total } = getActivityLogs({
  entity_type: filter === 'all' ? undefined : filter,
  limit: PAGE_SIZE,
  offset: (page - 1) * PAGE_SIZE,
});

const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

// Helper: format date to French locale with time
function fmtDate(iso: string) {
  if (!iso) return '—';
  const d = new Date(iso);
  return d.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' })
    + ' ' + d.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
}

function actionLabel(action: string) {
  return ACTION_LABELS[action] ?? action;
}

function entityColor(entity_type: string, action: string) {
  if (ACTION_COLORS[action]) return ACTION_COLORS[action];
  return ENTITY_COLORS[entity_type] ?? 'bg-gray-100 text-gray-600';
}

function entityIcon(entity_type: string) {
  switch (entity_type) {
    case 'order':   return '📦';
    case 'inquiry': return '📋';
    case 'devis':   return '📄';
    case 'auth':    return '🔐';
    case 'backup':  return '💾';
    default:        return '⚙️';
  }
}

const FILTER_OPTIONS = [
  { value: 'all',     label: 'Tout' },
  { value: 'order',   label: '📦 Commandes' },
  { value: 'inquiry', label: '📋 Demandes' },
  { value: 'devis',   label: '📄 Devis' },
  { value: 'auth',    label: '🔐 Connexions' },
  { value: 'backup',  label: '💾 Sauvegardes' },
];

function buildUrl(p: number, t: string) {
  const u = new URL(Astro.url);
  u.searchParams.set('page', String(p));
  u.searchParams.set('type', t);
  return u.pathname + u.search;
}

// Pre-parse details JSON for each log to avoid TypeScript generics in JSX templates
const parsedLogs = logs.map(log => {
  let details: Record<string, unknown> = {};
  try { details = JSON.parse(log.details || '{}'); } catch { /* ignore */ }
  return { ...log, parsedDetails: details, hasDetails: Object.keys(details).length > 0 };
});
---

<Layout title="Journal d'activité" isAdmin={true}>
  <div class="max-w-6xl mx-auto px-4 py-8">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Journal d'activité</h1>
        <p class="text-sm text-gray-500 mt-0.5">
          {total.toLocaleString('fr-FR')} entrée{total > 1 ? 's' : ''} enregistrée{total > 1 ? 's' : ''}
        </p>
      </div>

      <!-- Filter tabs -->
      <div class="flex flex-wrap gap-1.5">
        {FILTER_OPTIONS.map(opt => (
          <a
            href={buildUrl(1, opt.value)}
            class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-colors border ${
              filter === opt.value
                ? 'bg-blue-600 text-white border-blue-600 shadow-sm'
                : 'bg-white text-gray-600 border-gray-200 hover:bg-gray-50'
            }`}
          >
            {opt.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Log table (desktop) -->
    <div class="hidden md:block bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
      {logs.length === 0 ? (
        <div class="py-20 text-center text-gray-400">
          <div class="text-5xl mb-3">📭</div>
          <p class="text-lg font-medium">Aucune activité enregistrée</p>
          <p class="text-sm mt-1">Les actions apparaîtront ici au fur et à mesure.</p>
        </div>
      ) : (
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-100 text-left">
              <th class="px-5 py-3 font-semibold text-gray-500 uppercase tracking-wider text-xs">Date</th>
              <th class="px-5 py-3 font-semibold text-gray-500 uppercase tracking-wider text-xs">Type</th>
              <th class="px-5 py-3 font-semibold text-gray-500 uppercase tracking-wider text-xs">Action</th>
              <th class="px-5 py-3 font-semibold text-gray-500 uppercase tracking-wider text-xs">Référence</th>
              <th class="px-5 py-3 font-semibold text-gray-500 uppercase tracking-wider text-xs">Par</th>
              <th class="px-5 py-3 font-semibold text-gray-500 uppercase tracking-wider text-xs">Détails</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-50">
            {parsedLogs.map(log => {
              const color = entityColor(log.entity_type, log.action);
              const icon  = entityIcon(log.entity_type);
              return (
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-5 py-3.5 text-gray-500 whitespace-nowrap font-mono text-xs">{fmtDate(log.created_at)}</td>
                  <td class="px-5 py-3.5">
                    <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium ${color}`}>
                      {icon} {log.entity_type}
                    </span>
                  </td>
                  <td class="px-5 py-3.5 font-medium text-gray-800">{actionLabel(log.action)}</td>
                  <td class="px-5 py-3.5 text-gray-600 max-w-[160px] truncate" title={log.entity_ref || '—'}>
                    {log.entity_ref || <span class="text-gray-300">—</span>}
                  </td>
                  <td class="px-5 py-3.5 text-gray-600 max-w-[120px] truncate" title={log.performed_by || '—'}>
                    {log.performed_by || <span class="text-gray-300">—</span>}
                  </td>
                  <td class="px-5 py-3.5">
                    {log.hasDetails ? (
                      <button
                        class="details-btn text-blue-500 hover:text-blue-700 text-xs underline underline-offset-2"
                        data-details={log.details}
                      >
                        Voir
                      </button>
                    ) : (
                      <span class="text-gray-300 text-xs">—</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      )}
    </div>

    <!-- Log cards (mobile) -->
    <div class="md:hidden space-y-3">
      {logs.length === 0 ? (
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 py-16 text-center text-gray-400">
          <div class="text-4xl mb-3">📭</div>
          <p class="font-medium">Aucune activité</p>
        </div>
      ) : parsedLogs.map(log => {
        const color = entityColor(log.entity_type, log.action);
        const icon  = entityIcon(log.entity_type);
        return (
          <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-4">
            <div class="flex items-start justify-between gap-3">
              <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium ${color} shrink-0`}>
                {icon} {log.entity_type}
              </span>
              <span class="text-xs text-gray-400 font-mono shrink-0">{fmtDate(log.created_at)}</span>
            </div>
            <p class="mt-2 font-semibold text-gray-800 text-sm">{actionLabel(log.action)}</p>
            {log.entity_ref && <p class="text-xs text-gray-500 mt-0.5 truncate">{log.entity_ref}</p>}
            {log.performed_by && <p class="text-xs text-gray-400 mt-0.5">Par : {log.performed_by}</p>}
            {log.hasDetails && (
              <button
                class="details-btn mt-2 text-blue-500 hover:text-blue-700 text-xs underline underline-offset-2"
                data-details={log.details}
              >
                Voir les détails
              </button>
            )}
          </div>
        );
      })}
    </div>

    <!-- Pagination -->
    {totalPages > 1 && (
      <div class="flex items-center justify-between mt-6">
        <p class="text-sm text-gray-500">
          Page {page} / {totalPages}
        </p>
        <div class="flex gap-2">
          {page > 1 && (
            <a
              href={buildUrl(page - 1, filter)}
              class="px-4 py-2 rounded-lg border border-gray-200 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors"
            >
              ← Précédent
            </a>
          )}
          {page < totalPages && (
            <a
              href={buildUrl(page + 1, filter)}
              class="px-4 py-2 rounded-lg border border-gray-200 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors"
            >
              Suivant →
            </a>
          )}
        </div>
      </div>
    )}
  </div>

  <!-- Details modal -->
  <div id="details-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" id="modal-backdrop"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-md p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-bold text-gray-900">Détails de l'action</h3>
        <button id="modal-close" class="text-gray-400 hover:text-gray-600 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <pre id="modal-content" class="text-xs bg-gray-50 rounded-xl p-4 overflow-auto max-h-80 font-mono text-gray-700 whitespace-pre-wrap"></pre>
    </div>
  </div>

  <script is:inline>
    // Details modal
    const modal    = document.getElementById('details-modal');
    const content  = document.getElementById('modal-content');
    const closeBtn = document.getElementById('modal-close');
    const backdrop = document.getElementById('modal-backdrop');

    function openModal(rawJson) {
      try {
        const obj = JSON.parse(rawJson);
        content.textContent = JSON.stringify(obj, null, 2);
      } catch {
        content.textContent = rawJson;
      }
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

    document.querySelectorAll('.details-btn').forEach(btn => {
      btn.addEventListener('click', () => openModal(btn.dataset.details ?? '{}'));
    });

    // Live SSE: auto-refresh badge if new events come in
    window.addEventListener('sse:badge_update', () => {
      // Optionally show a "new activity" banner — for now just refresh silently is enough.
    });
  </script>
</Layout>
