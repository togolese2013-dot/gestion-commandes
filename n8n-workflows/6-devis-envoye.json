      "parameters": {
        "jsCode": "const d = $input.first().json.body ?? $input.first().json;\n\n// Strip ALL non-digit characters (spaces, dashes, +, parentheses)\nconst phone = String(d.client_phone ?? '').replace(/\\D/g, '');\n\nreturn [{\n  json: {\n    client_name: String(d.client_name ?? '').trim(),\n    client_phone: phone,\n    devis_number: String(d.devis_number ?? '').trim(),\n    share_url: String(d.share_url ?? '').trim(),\n    phone_valid: phone.length >= 8\n  }\n}];"
      },
