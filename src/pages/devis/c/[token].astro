---
import { getDevisByToken, updateDevisStatus, saveClientCounterProposal } from '../../../lib/devis';
import type { Devis } from '../../../lib/devis';

const { token } = Astro.params;
let devis: Devis | null = null;
let error = '';
let success = '';
let successType = '';

if (!token) {
  error = 'Lien invalide';
} else {
  const { getDevisByNumber } = await import('../../../lib/devis');
  devis = getDevisByNumber(token) ?? getDevisByToken(token);
  if (!devis) {
    error = 'Devis introuvable ou lien invalide';
  }
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action');

  if (devis && action) {
    if (action === 'accept') {
      const updated = updateDevisStatus(devis.id!, 'accepte');
      if (updated) {
        devis = updated;
        success = 'Devis accepté ! Nous vous contactons très prochainement pour confirmer les détails.';
        successType = 'accept';
      }
    } else if (action === 'reject') {
      const reason = formData.get('reason') as string;
      const updated = updateDevisStatus(devis.id!, 'refuse', reason || '');
      if (updated) {
        devis = updated;
        success = "Votre retour a bien été enregistré. Nous vous recontacterons pour explorer d'autres options.";
        successType = 'reject';
      }
    } else if (action === 'counterpropose') {
      const message = formData.get('counter_message') as string;
      const priceStr = formData.get('counter_price') as string;
      const counterPrice = priceStr ? parseFloat(priceStr) : null;
      if (message?.trim()) {
        const updated = saveClientCounterProposal(devis.id!, message.trim(), counterPrice);
        if (updated) {
          devis = updated;
          success = 'Votre message a bien été envoyé. Notre équipe vous répondra très prochainement.';
          successType = 'counter';
        }
      }
    }
  }
}

const fmt = (n: number) => n.toLocaleString('fr-FR', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
const dateStr = (d: string) => new Date(d).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const GA_ID = import.meta.env.PUBLIC_GA_ID;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{devis ? `Devis ${devis.devis_number}` : 'Votre Devis'} — TOGOLESE</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  {GA_ID && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
      <script define:vars={{ GA_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', GA_ID);
      </script>
    </>
  )}
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --green:        #059669;
      --green-dark:   #047857;
      --green-deep:   #064e3b;
      --green-light:  #ecfdf5;
      --green-mid:    #d1fae5;
      --green-border: #6ee7b7;
      --text:         #111827;
      --muted:        #6b7280;
      --border:       #e5e7eb;
    }

    html { overflow-x: clip; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;
      background: #f0f9f4;
      min-height: 100vh;
      padding: 0 16px 80px;
      color: var(--text);
      -webkit-font-smoothing: antialiased;
      overflow-x: clip;
    }
    input:not([type=checkbox]):not([type=radio]),
    textarea, select { font-size: max(16px, 1em); }

    /* ── Header ── */
    .header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: var(--green-dark);
      box-shadow: 0 2px 12px rgba(0,0,0,0.12);
      margin: 0 -16px 32px;
    }
    .header-inner {
      max-width: 1120px; margin: 0 auto; padding: 0 20px;
      display: flex; align-items: center; justify-content: space-between;
      height: 64px; position: relative;
    }
    .logo { text-decoration: none; flex-shrink: 0; }
    .logo-text { font-size: 22px; font-weight: 900; color: #fff; letter-spacing: -0.03em; }
    .nav-center {
      position: absolute; left: 50%; transform: translateX(-50%);
      display: flex; align-items: center; gap: 2px;
    }
    .nav-center a {
      font-size: 14px; font-weight: 500; color: rgba(255,255,255,0.88);
      text-decoration: none; padding: 8px 14px; border-radius: 8px; transition: all 0.15s;
    }
    .nav-center a:hover { color: #fff; background: rgba(255,255,255,0.12); }
    @media (max-width: 900px) { .nav-center { display: none; } }
    .btn-nav-header {
      padding: 9px 20px; background: #fff; color: var(--green-dark);
      border-radius: 50px; font-size: 14px; font-weight: 700;
      text-decoration: none; transition: all 0.2s; flex-shrink: 0;
    }
    .btn-nav-header:hover { background: #f0fdf4; transform: translateY(-1px); }

    /* ── Page wrapper ── */
    .page-wrap { max-width: 680px; margin: 0 auto; }

    /* ── Flash ── */
    .flash {
      border-radius: 14px; padding: 16px 20px; margin-bottom: 16px;
      display: flex; align-items: flex-start; gap: 12px;
      font-size: 14px; line-height: 1.5;
    }
    .flash-success { background: linear-gradient(135deg,#d1fae5,#ecfdf5); border: 1.5px solid #6ee7b7; color: #065f46; }
    .flash-error   { background: #fff1f2; border: 1.5px solid #fca5a5; color: #9f1239; }
    .flash-icon { font-size: 16px; flex-shrink: 0; margin-top: 1px; }

    /* ── Main card ── */
    .main-card {
      background: #fff;
      border-radius: 24px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.04), 0 20px 60px rgba(4,120,87,0.1);
      overflow: hidden;
      margin-bottom: 16px;
    }

    /* Animated top stripe */
    .stripe {
      height: 5px;
      background: linear-gradient(90deg, #059669, #34d399, #6ee7b7, #059669);
      background-size: 200% 100%;
      animation: shimmer 3s linear infinite;
    }
    @keyframes shimmer { 0%{background-position:0 0} 100%{background-position:200% 0} }

    .main-inner { padding: 28px 32px; }
    @media (max-width: 480px) { .main-inner { padding: 22px 20px; } }

    /* Top row: logo ↔ numéro */
    .top-row {
      display: flex; align-items: flex-start; justify-content: space-between;
      margin-bottom: 28px; gap: 16px;
    }
    .logo-block .logo-name { font-size: 20px; font-weight: 900; color: var(--green-dark); letter-spacing: -0.03em; }
    .logo-block .logo-sub  { font-size: 11px; color: #9ca3af; margin-top: 2px; }
    .number-block { text-align: right; flex-shrink: 0; }
    .number-tag {
      display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: 1.2px;
      text-transform: uppercase; color: var(--green); background: var(--green-light);
      border-radius: 5px; padding: 3px 8px; margin-bottom: 5px;
    }
    .number-value { font-size: 20px; font-weight: 900; color: var(--text); letter-spacing: 1px; }
    .number-date  { font-size: 12px; color: #9ca3af; margin-top: 2px; }

    .sep { height: 1px; background: #f3f4f6; margin: 0 0 24px; }

    /* Client + delivery */
    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 28px; }
    @media (max-width: 480px) { .info-grid { grid-template-columns: 1fr; } }
    .info-label { font-size: 10px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: #9ca3af; margin-bottom: 8px; }
    .client-row { display: flex; align-items: center; gap: 10px; }
    .avatar {
      width: 38px; height: 38px; border-radius: 50%;
      background: linear-gradient(135deg, var(--green-dark), var(--green));
      color: #fff; font-size: 15px; font-weight: 700;
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
      box-shadow: 0 4px 12px rgba(4,120,87,0.25);
    }
    .client-name  { font-size: 14px; font-weight: 700; color: var(--text); }
    .client-phone { font-size: 12px; color: var(--muted); margin-top: 1px; }
    .delivery-pill {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 13px; font-weight: 600; color: var(--green-dark);
      background: var(--green-light); border: 1.5px solid var(--green-border);
      border-radius: 10px; padding: 8px 14px;
    }
    .delivery-sub { font-size: 11px; color: var(--muted); font-weight: 400; display: block; margin-top: 2px; }

    /* Products */
    .products-label { font-size: 10px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: #9ca3af; margin-bottom: 12px; }
    .product-row {
      border-radius: 12px; margin-bottom: 8px;
      background: #fafafa; border: 1px solid #f3f4f6;
      overflow: hidden;
    }
    .product-row-inner {
      display: flex; justify-content: space-between; align-items: center;
      padding: 12px 14px; gap: 12px;
    }
    .product-left { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .product-icon {
      width: 36px; height: 36px; border-radius: 8px;
      background: var(--green-light); border: 1px solid var(--green-mid);
      display: flex; align-items: center; justify-content: center;
      font-size: 16px; flex-shrink: 0;
    }
    .p-name { font-size: 13px; font-weight: 600; color: var(--text); }
    .p-meta { font-size: 11px; color: #9ca3af; margin-top: 2px; display: flex; align-items: center; gap: 5px; flex-wrap: wrap; }
    .p-tag {
      display: inline-block; font-size: 10px; font-weight: 700;
      background: var(--green-light); border: 1px solid var(--green-border);
      color: var(--green-dark); border-radius: 4px; padding: 1px 6px;
    }
    .p-price { font-size: 14px; font-weight: 700; color: var(--text); text-align: right; white-space: nowrap; flex-shrink: 0; }
    .p-price-sub { font-size: 11px; color: #9ca3af; font-weight: 400; }

    /* Photos strip */
    .photos-strip {
      padding: 0 14px 12px;
      display: flex; gap: 8px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .photos-strip::-webkit-scrollbar { display: none; }
    .photo-thumb {
      width: 72px; height: 72px; border-radius: 8px;
      object-fit: cover; flex-shrink: 0;
      border: 1.5px solid var(--green-mid);
      cursor: pointer;
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .photo-thumb:hover {
      transform: scale(1.04);
      box-shadow: 0 4px 14px rgba(4,120,87,0.2);
    }
    @media (max-width: 480px) {
      .photo-thumb { width: 64px; height: 64px; }
    }

    /* Total block */
    .total-block {
      margin-top: 20px;
      background: linear-gradient(135deg, var(--green-dark), var(--green));
      border-radius: 16px; padding: 22px 24px; color: #fff;
    }
    .total-label-sm { font-size: 10px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; opacity: 0.55; margin-bottom: 4px; }
    .total-big { font-size: clamp(32px, 8vw, 44px); font-weight: 900; letter-spacing: -1px; line-height: 1; }
    .total-fcfa { font-size: 14px; font-weight: 600; opacity: 0.6; margin-left: 4px; }
    .total-note { font-size: 11px; opacity: 0.4; margin: 5px 0 18px; }
    .bp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .bp {
      background: rgba(0,0,0,0.15); border-radius: 10px; padding: 12px 14px;
    }
    .bp-key { font-size: 10px; font-weight: 600; letter-spacing: 0.8px; text-transform: uppercase; opacity: 0.5; margin-bottom: 4px; }
    .bp-pct { background: rgba(255,255,255,0.15); border-radius: 3px; padding: 0 4px; font-size: 9px; margin-left: 3px; }
    .bp-val { font-size: 16px; font-weight: 800; }
    .bp-unit { font-size: 10px; opacity: 0.5; margin-left: 2px; }

    /* Validity bottom strip */
    .validity-row {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      padding: 13px 20px;
      background: var(--green-light); border-top: 1px solid var(--green-mid);
    }
    .v-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); animation: pulse 2s infinite; flex-shrink: 0; }
    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(.8)} }
    .v-text { font-size: 13px; font-weight: 600; color: var(--green-dark); }

    /* Status banners */
    .status-banner {
      border-radius: 16px; padding: 18px 20px;
      display: flex; align-items: flex-start; gap: 14px;
      margin-bottom: 16px;
    }
    .status-accepted { background: linear-gradient(135deg,#d1fae5,#ecfdf5); border: 1.5px solid #6ee7b7; }
    .status-rejected { background: #fff1f2; border: 1.5px solid #fca5a5; }
    .status-icon {
      width: 38px; height: 38px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0;
    }
    .status-accepted .status-icon { background: #10b981; color: white; box-shadow: 0 4px 12px rgba(16,185,129,.35); }
    .status-rejected .status-icon { background: #ef4444; color: white; box-shadow: 0 4px 12px rgba(239,68,68,.3); }
    .status-title { font-size: 14px; font-weight: 700; color: var(--text); }
    .status-sub   { font-size: 12px; color: var(--muted); margin-top: 3px; line-height: 1.5; }

    /* CTA card */
    .cta-card {
      background: #fff;
      border-radius: 20px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.04), 0 12px 40px rgba(4,120,87,0.08);
      padding: 24px; margin-bottom: 16px;
    }
    .cta-title { font-size: 16px; font-weight: 800; color: var(--text); margin-bottom: 4px; }
    .cta-sub   { font-size: 13px; color: var(--muted); margin-bottom: 18px; line-height: 1.55; }
    .btn-accept {
      display: flex; align-items: center; justify-content: center; gap: 10px;
      width: 100%; padding: 15px;
      background: linear-gradient(135deg, var(--green-dark), var(--green));
      color: white; border: none; border-radius: 50px;
      font-family: inherit; font-size: 15px; font-weight: 700; cursor: pointer;
      box-shadow: 0 6px 20px rgba(4,120,87,0.3); margin-bottom: 10px;
      transition: all 0.2s;
    }
    .btn-accept:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(4,120,87,0.4); }
    .btn-reject {
      display: flex; align-items: center; justify-content: center;
      width: 100%; padding: 13px;
      background: #f9fafb; color: var(--muted);
      border: 1.5px solid var(--border); border-radius: 50px;
      font-family: inherit; font-size: 14px; font-weight: 500; cursor: pointer;
      transition: all 0.15s;
    }
    .btn-reject:hover { background: #f3f4f6; color: #374151; }

    /* Payment button */
    .btn-payment {
      display: flex; align-items: center; justify-content: center; gap: 10px;
      width: 100%; padding: 14px;
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: #fff; border: none; border-radius: 50px;
      font-family: inherit; font-size: 14px; font-weight: 700;
      text-decoration: none; margin-bottom: 10px;
      box-shadow: 0 4px 16px rgba(245,158,11,0.3);
      transition: all 0.2s;
    }
    .btn-payment:hover { opacity: 0.9; transform: translateY(-1px); }

    /* Counter-proposal card */
    .counter-card {
      background: #fff; border-radius: 20px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.04), 0 12px 40px rgba(4,120,87,0.08);
      padding: 24px; margin-bottom: 16px;
    }
    .counter-title { font-size: 15px; font-weight: 800; color: var(--text); margin-bottom: 4px; }
    .counter-sub { font-size: 13px; color: var(--muted); margin-bottom: 16px; line-height: 1.5; }
    .counter-field { margin-bottom: 12px; }
    .counter-label { display: block; font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
    .counter-textarea {
      width: 100%; padding: 12px 14px; border: 1.5px solid var(--border-color);
      border-radius: 12px; font-family: inherit; font-size: 14px; color: var(--text);
      resize: vertical; min-height: 90px; outline: none; transition: border-color 0.15s;
    }
    .counter-textarea:focus { border-color: var(--green); }
    .counter-price-row { display: flex; gap: 10px; align-items: center; }
    .counter-input {
      flex: 1; padding: 11px 14px; border: 1.5px solid var(--border-color);
      border-radius: 12px; font-family: inherit; font-size: 14px; color: var(--text);
      outline: none; transition: border-color 0.15s;
    }
    .counter-input:focus { border-color: var(--green); }
    .counter-unit { font-size: 13px; color: var(--muted); font-weight: 600; white-space: nowrap; }
    .btn-counter {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      width: 100%; padding: 13px; margin-top: 4px;
      background: var(--green-light); color: var(--green-dark);
      border: 1.5px solid var(--green-border); border-radius: 50px;
      font-family: inherit; font-size: 14px; font-weight: 700; cursor: pointer;
      transition: all 0.15s;
    }
    .btn-counter:hover { background: var(--green-mid); }
    .counter-sent {
      display: flex; align-items: center; gap: 8px; padding: 14px 16px;
      background: var(--green-light); border: 1px solid var(--green-border);
      border-radius: 12px; font-size: 13px; color: var(--green-dark); font-weight: 600;
    }

    /* Error page */
    .error-page {
      min-height: 60vh; display: flex; flex-direction: column;
      align-items: center; justify-content: center; text-align: center; padding: 40px 20px;
    }
    .error-icon {
      width: 72px; height: 72px; background: rgba(255,255,255,0.85); border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 30px; margin: 0 auto 20px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    }
    .error-title { font-size: 20px; font-weight: 800; color: var(--text); margin-bottom: 8px; }
    .error-sub   { font-size: 14px; color: var(--muted); line-height: 1.6; }
    .error-link {
      display: inline-flex; margin-top: 20px; padding: 11px 24px;
      background: var(--green-dark); color: white; border-radius: 50px;
      font-size: 14px; font-weight: 700; text-decoration: none;
    }

    /* Lightbox */
    #lightbox { display: none; }
    #lightbox.open { display: flex; }
    .lb-overlay {
      position: fixed; inset: 0; z-index: 500;
      background: rgba(0,0,0,0.92);
      display: flex; align-items: center; justify-content: center;
      padding: 20px;
    }
    .lb-inner { position: relative; max-width: 90vw; max-height: 90vh; }
    .lb-img { max-width: 90vw; max-height: 80vh; border-radius: 12px; object-fit: contain; display: block; }
    .lb-close {
      position: fixed; top: 16px; right: 16px;
      width: 40px; height: 40px; border-radius: 50%;
      background: rgba(255,255,255,0.12); color: white; border: none;
      font-size: 20px; cursor: pointer; display: flex; align-items: center; justify-content: center;
      transition: background 0.15s;
    }
    .lb-close:hover { background: rgba(255,255,255,0.22); }
    .lb-arrow {
      position: fixed; top: 50%; transform: translateY(-50%);
      width: 44px; height: 44px; border-radius: 50%;
      background: rgba(255,255,255,0.12); color: white; border: none;
      font-size: 20px; cursor: pointer; display: flex; align-items: center; justify-content: center;
      transition: background 0.15s;
    }
    .lb-arrow:hover { background: rgba(255,255,255,0.22); }
    .lb-prev { left: 12px; }
    .lb-next { right: 12px; }
    .lb-counter {
      position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
      font-size: 13px; color: rgba(255,255,255,0.55); font-weight: 500;
    }

    /* Reject modal */
    #reject-modal { display: none; }
    #reject-modal.is-open { display: flex; }
    .modal-overlay {
      position: fixed; inset: 0; background: rgba(17,24,39,0.5);
      backdrop-filter: blur(4px); z-index: 300;
      display: flex; align-items: flex-end; justify-content: center; padding: 20px;
    }
    @media (min-width: 480px) { .modal-overlay { align-items: center; } }
    .modal-box {
      background: white; border-radius: 20px; width: 100%; max-width: 440px;
      overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,0.2);
      animation: slideUp 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    @keyframes slideUp {
      from { opacity: 0; transform: translateY(20px) scale(0.97); }
      to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    .modal-header { padding: 22px 24px 18px; border-bottom: 1px solid #f3f4f6; }
    .modal-title  { font-size: 17px; font-weight: 800; color: var(--text); }
    .modal-sub    { font-size: 13px; color: var(--muted); margin-top: 4px; }
    .modal-body   { padding: 20px 24px 24px; }
    .modal-textarea {
      width: 100%; padding: 12px 14px;
      border: 1.5px solid var(--border); border-radius: 12px;
      font-family: inherit; font-size: max(16px, 1em); color: var(--text);
      resize: none; outline: none; background: #f9fafb;
      transition: border-color 0.2s, box-shadow 0.2s; line-height: 1.5;
    }
    .modal-textarea::placeholder { color: #9ca3af; }
    .modal-textarea:focus {
      border-color: var(--green);
      box-shadow: 0 0 0 3px rgba(5,150,105,0.12); background: white;
    }
    .modal-actions { display: flex; gap: 10px; margin-top: 14px; }
    .btn-modal-cancel {
      flex: 1; padding: 12px; background: #f9fafb; border: 1.5px solid var(--border);
      border-radius: 10px; font-family: inherit; font-size: 13px; font-weight: 600;
      color: var(--muted); cursor: pointer;
    }
    .btn-modal-cancel:hover { background: #f3f4f6; }
    .btn-modal-confirm {
      flex: 1.5; padding: 12px; background: #ef4444; border: none;
      border-radius: 10px; font-family: inherit; font-size: 13px; font-weight: 700;
      color: white; cursor: pointer; box-shadow: 0 4px 12px rgba(239,68,68,0.3);
    }
    .btn-modal-confirm:hover { background: #dc2626; }

    /* Footer */
    .page-footer { text-align: center; margin-top: 20px; padding: 16px 0; font-size: 12px; color: #9ca3af; line-height: 1.9; }
    .page-footer strong { color: var(--green-dark); }
    .page-footer a { color: var(--green-dark); text-decoration: none; font-weight: 600; }
  </style>
</head>
<body>

  <!-- Header -->
  <header class="header">
    <div class="header-inner">
      <a href="/" class="logo"><span class="logo-text">Togolese.</span></a>
      <nav class="nav-center">
        <a href="/#fonctionnement">Comment ça marche</a>
        <a href="/#avantages">Avantages</a>
        <a href="/#livraison">Livraison</a>
        <a href="/#faq">FAQ</a>
      </nav>
      <a href="/demande" class="btn-nav-header">Faire une demande</a>
    </div>
  </header>

  <div class="page-wrap">

    {error && (
      <div class="error-page">
        <div class="error-icon">🔍</div>
        <h1 class="error-title">Devis introuvable</h1>
        <p class="error-sub">Ce lien est invalide ou a expiré.<br/>Contactez-nous pour obtenir un nouveau lien.</p>
        <a href="/" class="error-link">Retour à l'accueil</a>
      </div>
    )}

    {success && (
      <div class={`flash ${successType === 'accept' ? 'flash-success' : 'flash-error'}`}>
        <span class="flash-icon">{successType === 'accept' ? '✓' : '○'}</span>
        <span>{success}</span>
      </div>
    )}

    {devis && (
      <>
        <!-- Status banners -->
        {devis.devis_status === 'accepte' && (
          <div class="status-banner status-accepted">
            <div class="status-icon">✓</div>
            <div>
              <div class="status-title">Proposition acceptée</div>
              <div class="status-sub">
                {devis.accepted_at ? dateStr(devis.accepted_at) : ''}
                {' '}— Nous vous contacterons sous peu pour confirmer les détails.
              </div>
            </div>
          </div>
        )}
        {devis.devis_status === 'refuse' && (
          <div class="status-banner status-rejected">
            <div class="status-icon">✗</div>
            <div>
              <div class="status-title">Proposition déclinée</div>
              <div class="status-sub">
                {devis.rejected_at ? dateStr(devis.rejected_at) : ''}
                {devis.rejection_reason ? ` · ${devis.rejection_reason}` : ''}
              </div>
            </div>
          </div>
        )}

        <!-- Main card -->
        <div class="main-card">
          <div class="stripe"></div>
          <div class="main-inner">

            <!-- Logo ↔ Numéro -->
            <div class="top-row">
              <div class="logo-block">
                <div class="logo-name">Togolese.</div>
                <div class="logo-sub">Vente &amp; Distribution</div>
              </div>
              <div class="number-block">
                <div class="number-tag">Proposition commerciale</div>
                <div class="number-value">{devis.devis_number}</div>
                <div class="number-date">{devis.created_at ? dateStr(devis.created_at) : ''}</div>
              </div>
            </div>

            <div class="sep"></div>

            <!-- Client + Livraison -->
            <div class="info-grid">
              <div>
                <div class="info-label">Destinataire</div>
                <div class="client-row">
                  <div class="avatar">{devis.client_name.charAt(0).toUpperCase()}</div>
                  <div>
                    <div class="client-name">{devis.client_name}</div>
                    <div class="client-phone">{devis.client_phone}</div>
                  </div>
                </div>
              </div>
              <div>
                <div class="info-label">Livraison</div>
                <div class="delivery-pill">
                  {devis.delivery_type === 'bateau' ? '🚢' : '✈️'}
                  {devis.delivery_type === 'bateau' ? 'Économique — Bateau' : 'Express — Avion'}
                  <span class="delivery-sub">
                    {devis.delivery_type === 'bateau' ? '45 – 60 jours' : '4 – 14 jours'}
                  </span>
                </div>
              </div>
            </div>

            <!-- Articles -->
            <div class="products-label">Articles commandés</div>
            {devis.products_summary && devis.products_summary.length > 0 ? (
              devis.products_summary.map((p: any, i: number) => {
                const qty   = p.quantity || p._qty || 1;
                const price = p.price    || p._price || 0;
                const subtotal = qty * price;
                const photos: string[] = p.photos || [];
                const emoji = p.name?.toLowerCase().includes('iphone') || p.name?.toLowerCase().includes('samsung') ? '📱'
                            : p.name?.toLowerCase().includes('airpods') || p.name?.toLowerCase().includes('écouteur') || p.name?.toLowerCase().includes('casque') ? '🎧'
                            : p.name?.toLowerCase().includes('mac') || p.name?.toLowerCase().includes('laptop') || p.name?.toLowerCase().includes('ordinateur') ? '💻'
                            : p.name?.toLowerCase().includes('montre') || p.name?.toLowerCase().includes('watch') ? '⌚'
                            : p.name?.toLowerCase().includes('tablette') || p.name?.toLowerCase().includes('ipad') ? '📱'
                            : '📦';
                return (
                  <div class="product-row" key={i}>
                    <div class="product-row-inner">
                      <div class="product-left">
                        <div class="product-icon">{emoji}</div>
                        <div>
                          <div class="p-name">{p.name}</div>
                          <div class="p-meta">
                            {p.state && <span class="p-tag">{p.state}</span>}
                            {qty > 1 && <span>qté {qty}</span>}
                            {qty > 1 && price > 0 && <span>· {fmt(price)} F/u</span>}
                            {photos.length > 0 && <span style="color:#059669;font-weight:600">📸 {photos.length} photo{photos.length > 1 ? 's' : ''}</span>}
                          </div>
                        </div>
                      </div>
                      <div class="p-price">
                        {fmt(subtotal)} <span class="p-price-sub">FCFA</span>
                      </div>
                    </div>
                    {photos.length > 0 && (
                      <div class="photos-strip" data-product-idx={i}>
                        {photos.map((src: string, pi: number) => (
                          <img
                            key={pi}
                            src={src}
                            alt={`${p.name} — photo ${pi + 1}`}
                            class="photo-thumb"
                            data-pi={pi}
                            data-src={src}
                          />
                        ))}
                      </div>
                    )}
                  </div>
                );
              })
            ) : (
              <p style="font-size:14px; color:#9ca3af; font-style:italic; padding: 8px 0;">Aucun article renseigné</p>
            )}

            <!-- Total -->
            <div class="total-block">
              <div class="total-label-sm">Total estimé</div>
              <div>
                <span class="total-big">{fmt(devis.total_amount)}</span>
                <span class="total-fcfa">FCFA</span>
              </div>
              <div class="total-note">Toutes taxes comprises — prix indicatifs</div>
              <div class="bp-grid">
                <div class="bp">
                  <div class="bp-key">Acompte <span class="bp-pct">70%</span></div>
                  <div class="bp-val">{fmt(devis.acompte_amount)}<span class="bp-unit"> F</span></div>
                </div>
                <div class="bp">
                  <div class="bp-key">Solde livraison</div>
                  <div class="bp-val">{fmt(devis.solde_amount)}<span class="bp-unit"> F</span></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Validity strip -->
          <div class="validity-row">
            <span class="v-dot"></span>
            <span class="v-text">
              Offre valable jusqu'au {devis.validity_until ? dateStr(devis.validity_until) : '—'}
            </span>
          </div>
        </div>

        <!-- Payment button (accepté + lien disponible) -->
        {devis.devis_status === 'accepte' && devis.payment_link && (
          <div class="cta-card">
            <div class="cta-title">💳 Payer l'acompte</div>
            <div class="cta-sub">Réglez l'acompte de <strong>{fmt(devis.acompte_amount)} FCFA</strong> pour lancer votre commande.</div>
            <a href={devis.payment_link} target="_blank" rel="noopener noreferrer" class="btn-payment">
              💸 &nbsp;Payer via Wave / Moov Money
            </a>
          </div>
        )}

        <!-- CTA card -->
        {devis.devis_status === 'en_attente' && (
          <div class="cta-card">
            <div class="cta-title">Prêt à confirmer ?</div>
            <div class="cta-sub">En acceptant cette proposition, notre équipe vous contactera pour organiser les détails de votre commande.</div>
            <form method="POST" style="width:100%">
              <button type="submit" name="action" value="accept" class="btn-accept">
                ✓ &nbsp;Accepter cette proposition
              </button>
            </form>
            <button id="btn-reject" class="btn-reject">Décliner la proposition</button>
          </div>
        )}

        <!-- Counter-proposal card -->
        {devis.devis_status === 'en_attente' && (
          <div class="counter-card">
            <div class="counter-title">💬 Une question ou une contre-proposition ?</div>
            <div class="counter-sub">Vous pouvez nous envoyer un message ou proposer un autre prix. Notre équipe vous répondra rapidement.</div>
            {devis.client_message ? (
              <div class="counter-sent">
                ✅ &nbsp;Message envoyé — notre équipe revient vers vous très prochainement.
              </div>
            ) : (
              <form method="POST">
                <div class="counter-field">
                  <label class="counter-label" for="counter_message">Votre message</label>
                  <textarea id="counter_message" name="counter_message" class="counter-textarea" placeholder="Ex : Le prix est un peu élevé, pouvez-vous faire mieux ? Ou : Quel est le délai exact ?" required></textarea>
                </div>
                <div class="counter-field">
                  <label class="counter-label" for="counter_price">Votre budget (optionnel)</label>
                  <div class="counter-price-row">
                    <input id="counter_price" name="counter_price" type="number" min="0" class="counter-input" placeholder="Ex : 450 000" />
                    <span class="counter-unit">FCFA</span>
                  </div>
                </div>
                <button type="submit" name="action" value="counterpropose" class="btn-counter">
                  📨 &nbsp;Envoyer mon message
                </button>
              </form>
            )}
          </div>
        )}
      </>
    )}

    <footer class="page-footer">
      <p>Proposition préparée par <strong>Togolese</strong> · Vente &amp; Distribution</p>
      <p>Montants en francs CFA (FCFA), à titre indicatif · <a href="/">togolese.fr</a></p>
    </footer>

  </div>

  <!-- Lightbox -->
  <div id="lightbox">
    <div class="lb-overlay" id="lb-overlay">
      <button class="lb-close" id="lb-close">✕</button>
      <button class="lb-arrow lb-prev" id="lb-prev">‹</button>
      <div class="lb-inner">
        <img src="" alt="" class="lb-img" id="lb-img" />
      </div>
      <button class="lb-arrow lb-next" id="lb-next">›</button>
      <div class="lb-counter" id="lb-counter"></div>
    </div>
  </div>

  <!-- Reject modal -->
  {devis && devis.devis_status === 'en_attente' && (
    <div id="reject-modal">
      <div class="modal-overlay" id="modal-overlay">
        <div class="modal-box">
          <div class="modal-header">
            <div class="modal-title">Décliner la proposition</div>
            <div class="modal-sub">Votre retour nous aide à mieux vous servir.</div>
          </div>
          <div class="modal-body">
            <form method="POST">
              <textarea name="reason" rows="4" placeholder="Raison du refus (optionnel) — prix, délai, autre…" class="modal-textarea"></textarea>
              <div class="modal-actions">
                <button type="button" id="btn-cancel" class="btn-modal-cancel">Annuler</button>
                <button type="submit" name="action" value="reject" class="btn-modal-confirm">Confirmer le refus</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  )}

  <script>
    // ── Reject modal ──
    const btnReject = document.getElementById('btn-reject');
    const btnCancel = document.getElementById('btn-cancel');
    const modal     = document.getElementById('reject-modal');
    const overlay   = document.getElementById('modal-overlay');

    btnReject?.addEventListener('click', () => modal?.classList.add('is-open'));
    btnCancel?.addEventListener('click', () => modal?.classList.remove('is-open'));
    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) modal?.classList.remove('is-open');
    });

    // ── Lightbox ──
    let allPhotos: string[] = [];
    let lbIndex = 0;

    const lb        = document.getElementById('lightbox')!;
    const lbOverlay = document.getElementById('lb-overlay')!;
    const lbImg     = document.getElementById('lb-img') as HTMLImageElement;
    const lbCounter = document.getElementById('lb-counter')!;
    const lbClose   = document.getElementById('lb-close')!;
    const lbPrev    = document.getElementById('lb-prev')!;
    const lbNext    = document.getElementById('lb-next')!;

    function openLightbox(photos: string[], startIndex: number) {
      allPhotos = photos;
      lbIndex   = startIndex;
      showPhoto();
      lb.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lb.classList.remove('open');
      document.body.style.overflow = '';
    }

    function showPhoto() {
      lbImg.src = allPhotos[lbIndex];
      lbCounter.textContent = `${lbIndex + 1} / ${allPhotos.length}`;
      lbPrev.style.display = allPhotos.length > 1 ? 'flex' : 'none';
      lbNext.style.display = allPhotos.length > 1 ? 'flex' : 'none';
    }

    lbClose.addEventListener('click', closeLightbox);
    lbOverlay.addEventListener('click', (e) => { if (e.target === lbOverlay) closeLightbox(); });
    lbPrev.addEventListener('click', () => { lbIndex = (lbIndex - 1 + allPhotos.length) % allPhotos.length; showPhoto(); });
    lbNext.addEventListener('click', () => { lbIndex = (lbIndex + 1) % allPhotos.length; showPhoto(); });
    document.addEventListener('keydown', (e) => {
      if (!lb.classList.contains('open')) return;
      if (e.key === 'Escape')      closeLightbox();
      if (e.key === 'ArrowLeft')   { lbIndex = (lbIndex - 1 + allPhotos.length) % allPhotos.length; showPhoto(); }
      if (e.key === 'ArrowRight')  { lbIndex = (lbIndex + 1) % allPhotos.length; showPhoto(); }
    });

    // Wire thumbnails — collect all photos per product strip
    document.querySelectorAll('.photos-strip').forEach((strip) => {
      const thumbs = strip.querySelectorAll<HTMLImageElement>('.photo-thumb');
      const photos = Array.from(thumbs).map(t => t.dataset.src!);
      thumbs.forEach((thumb, pi) => {
        thumb.addEventListener('click', () => openLightbox(photos, pi));
      });
    });
  </script>
</body>
</html>
