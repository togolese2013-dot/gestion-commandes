---
import { isAuthenticated } from '../lib/auth';

// Admins get redirected to their dashboard
if (isAuthenticated(Astro.request)) {
  return Astro.redirect('/admin/orders');
}
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TOGOLESE — Commandez depuis le monde entier, livré chez vous</title>
  <meta name="description" content="Téléphone, vêtements, électronique… Dites-nous ce que vous voulez depuis l'étranger, on achète et on livre au Togo." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --green:       #059669;
      --green-dark:  #047857;
      --green-deep:  #064e3b;
      --green-light: #ecfdf5;
      --green-mid:   #d1fae5;
      --amber:       #f59e0b;
      --amber-dark:  #d97706;
      --text:        #111827;
      --muted:       #6b7280;
      --border:      #e5e7eb;
      --white:       #ffffff;
      --radius:      16px;
    }

    html { scroll-behavior: smooth; overflow-x: hidden; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', sans-serif;
      color: var(--text);
      background: var(--white);
      -webkit-font-smoothing: antialiased;
    }

    /* ─── Utilities ─── */
    .container {
      max-width: 1120px;
      margin: 0 auto;
      padding: 0 20px;
    }
    .section { padding: 80px 0; }
    @media (max-width: 768px) { .section { padding: 56px 0; } }

    .section-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: var(--green);
      background: var(--green-light);
      border: 1.5px solid var(--green-mid);
      border-radius: 50px;
      padding: 5px 14px;
      margin-bottom: 16px;
    }
    .section-title {
      font-size: clamp(26px, 5vw, 38px);
      font-weight: 800;
      color: var(--text);
      line-height: 1.2;
      margin-bottom: 14px;
    }
    .section-sub {
      font-size: 16px;
      color: var(--muted);
      line-height: 1.7;
      max-width: 560px;
    }

    /* ─── HEADER (base.com style — blue background) ─── */
    .header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: #1d4ed8;
      transition: box-shadow 0.3s;
    }
    .header.scrolled {
      box-shadow: 0 2px 20px rgba(0,0,0,0.18);
    }
    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 64px;
      position: relative;
    }

    /* Logo — left side */
    .logo {
      display: flex;
      align-items: center;
      gap: 0;
      text-decoration: none;
      flex-shrink: 0;
      z-index: 2;
    }
    .logo-text {
      font-size: 22px;
      font-weight: 900;
      color: #ffffff;
      letter-spacing: -0.03em;
    }

    /* Nav — absolutely centered */
    .nav-center {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      gap: 2px;
    }
    .nav-center a {
      font-size: 14px;
      font-weight: 500;
      color: rgba(255,255,255,0.88);
      text-decoration: none;
      padding: 8px 14px;
      border-radius: 8px;
      transition: all 0.15s;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .nav-center a:hover {
      color: #ffffff;
      background: rgba(255,255,255,0.12);
    }
    .nav-chevron {
      font-size: 11px;
      opacity: 0.7;
    }
    @media (max-width: 900px) { .nav-center { display: none; } }

    /* Right buttons */
    .header-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
      z-index: 2;
    }
    .btn-ghost {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 18px;
      background: transparent;
      color: rgba(255,255,255,0.9);
      border: 1.5px solid rgba(255,255,255,0.35);
      border-radius: 50px;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s;
    }
    .btn-ghost:hover {
      border-color: rgba(255,255,255,0.7);
      color: #ffffff;
      background: rgba(255,255,255,0.1);
    }
    .btn-ghost svg {
      width: 15px;
      height: 15px;
      flex-shrink: 0;
    }
    .btn-nav {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 9px 20px;
      background: #ffffff;
      color: #1d4ed8;
      border: none;
      border-radius: 50px;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.2s;
      letter-spacing: -0.01em;
    }
    .btn-nav:hover {
      background: #f0f7ff;
      transform: translateY(-1px);
      box-shadow: 0 4px 16px rgba(0,0,0,0.15);
    }
    @media (max-width: 640px) { .btn-ghost { display: none; } }

    /* Mobile hamburger */
    .burger {
      display: none;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 6px;
      background: none;
      border: none;
    }
    .burger span {
      display: block;
      width: 22px;
      height: 2px;
      background: rgba(255,255,255,0.9);
      border-radius: 2px;
      transition: all 0.3s;
    }
    @media (max-width: 768px) { .burger { display: flex; } }

    /* ─── HERO (base.com inspired) ─── */
    .hero {
      position: relative;
      padding: 0;
      overflow: hidden;
      min-height: 680px;
    }

    /* Canvas gradient background */
    #hero-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
    }

    /* Wave SVG at the bottom */
    .hero-wave {
      position: absolute;
      bottom: -2px;
      left: 0;
      right: 0;
      z-index: 2;
      line-height: 0;
    }
    .hero-wave svg {
      display: block;
      width: 100%;
      height: 64px;
    }

    /* Hero content */
    .hero-content {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 80px 20px 100px;
      max-width: 780px;
      margin: 0 auto;
      width: 100%;
    }
    @media (max-width: 640px) {
      .hero-content { padding: 60px 20px 90px; }
    }

    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 12.5px;
      font-weight: 700;
      color: var(--green-dark);
      background: rgba(255,255,255,0.88);
      backdrop-filter: blur(8px);
      border: 1.5px solid rgba(5,150,105,0.25);
      border-radius: 50px;
      padding: 6px 16px;
      margin-bottom: 24px;
      box-shadow: 0 2px 12px rgba(5,150,105,0.1);
      letter-spacing: 0.02em;
    }
    .hero-eyebrow-dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      background: var(--green);
      animation: pulse-dot 2s ease-in-out infinite;
    }
    @keyframes pulse-dot {
      0%,100% { transform: scale(1); opacity: 1; }
      50%      { transform: scale(1.5); opacity: 0.5; }
    }

    /* Large title — base.com style */
    .hero-title {
      font-size: clamp(40px, 7vw, 68px);
      font-weight: 900;
      line-height: 1.08;
      color: var(--green-deep);
      margin-bottom: 22px;
      letter-spacing: -0.03em;
    }
    /* Rotating word — block centered on its own line */
    .word-rotate-block {
      display: block;
      position: relative;
      height: 1.15em;
      overflow: hidden;
      margin: 4px 0;
    }
    .word-rotate-block span {
      display: block;
      position: absolute;
      width: 100%;
      text-align: center;
      color: var(--green);
      opacity: 0;
      transform: translateY(110%);
      animation: slideWord 16s linear infinite;
      white-space: nowrap;
    }
    .word-rotate-block span::after {
      content: '';
      position: absolute;
      bottom: 4px;
      left: 50%;
      transform: translateX(-50%);
      width: 80%;
      height: 3px;
      background: linear-gradient(90deg, transparent, var(--amber), #fbbf24, transparent);
      border-radius: 2px;
    }
    .word-rotate-block span:nth-child(1) { animation-delay: 0s; }
    .word-rotate-block span:nth-child(2) { animation-delay: 4s; }
    .word-rotate-block span:nth-child(3) { animation-delay: 8s; }
    .word-rotate-block span:nth-child(4) { animation-delay: 12s; }
    @keyframes slideWord {
      0%    { opacity: 0; transform: translateY(110%); }
      6%    { opacity: 1; transform: translateY(0); }
      22%   { opacity: 1; transform: translateY(0); }
      28%   { opacity: 0; transform: translateY(-110%); }
      100%  { opacity: 0; transform: translateY(-110%); }
    }

    .hero-sub {
      font-size: 17px;
      color: #374151;
      line-height: 1.7;
      margin-bottom: 36px;
      max-width: 560px;
      text-align: center;
    }
    @media (max-width: 640px) { .hero-sub { font-size: 15px; } }

    /* Hero form — centered card */
    .hero-form-wrap {
      width: 100%;
      max-width: 540px;
    }
    .hero-form {
      background: rgba(255,255,255,0.95);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-radius: 22px;
      padding: 28px 28px 22px;
      box-shadow: 0 12px 48px rgba(4,78,59,0.14), 0 2px 8px rgba(0,0,0,0.05);
      border: 1px solid rgba(5,150,105,0.12);
    }
    .hero-form-title {
      font-size: 16px;
      font-weight: 800;
      color: var(--text);
      margin-bottom: 3px;
      letter-spacing: -0.01em;
    }
    .hero-form-sub {
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 18px;
    }
    .form-field {
      margin-bottom: 12px;
    }
    .form-label {
      display: block;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      color: #374151;
      margin-bottom: 6px;
    }
    .form-input {
      width: 100%;
      padding: 12px 14px;
      border: 1.5px solid #e5e7eb;
      border-radius: 12px;
      font-size: 14px;
      font-family: inherit;
      color: var(--text);
      background: #f9fafb;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    }
    .form-input::placeholder { color: #9ca3af; }
    .form-input:focus {
      border-color: var(--green);
      background: white;
      box-shadow: 0 0 0 3px rgba(5,150,105,0.12);
    }
    .btn-hero {
      width: 100%;
      padding: 15px;
      background: linear-gradient(135deg, var(--green-deep) 0%, var(--green-dark) 100%);
      color: white;
      border: none;
      border-radius: 50px;
      font-family: inherit;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.25s;
      box-shadow: 0 6px 22px rgba(4,78,59,0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      margin-top: 4px;
      letter-spacing: -0.01em;
    }
    .btn-hero:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 32px rgba(4,78,59,0.4);
    }
    .form-badges {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 18px;
      margin-top: 14px;
      flex-wrap: wrap;
    }
    .form-badge {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 12px;
      color: var(--muted);
      font-weight: 500;
    }
    .form-badge-check { color: var(--green); font-size: 13px; }

    /* Hero CTA wrap (no card) */
    .hero-cta-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      width: 100%;
      max-width: 400px;
    }
    .hero-cta-wrap .btn-hero {
      width: 100%;
    }
    .hero-cta-wrap .form-badges .form-badge {
      color: var(--green-deep);
      font-weight: 600;
    }
    .hero-cta-wrap .form-badge-check {
      color: var(--green-dark);
    }

    /* Hero trust row */
    .hero-trust {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 28px;
      margin-top: 28px;
      flex-wrap: wrap;
    }
    .hero-trust-item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 600;
      color: var(--green-deep);
    }
    .hero-trust-icon {
      width: 32px; height: 32px;
      background: rgba(255,255,255,0.85);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      box-shadow: 0 2px 8px rgba(4,78,59,0.12);
    }

    /* ─── HOW IT WORKS ─── */
    .how-section { background: white; }
    .steps-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      margin-top: 56px;
      position: relative;
    }
    .steps-grid::before {
      content: '';
      position: absolute;
      top: 40px;
      left: calc(16.6% + 20px);
      right: calc(16.6% + 20px);
      height: 2px;
      background: linear-gradient(90deg, var(--green-mid), var(--green), var(--green-mid));
      z-index: 0;
    }
    @media (max-width: 640px) {
      .steps-grid { grid-template-columns: 1fr; gap: 32px; }
      .steps-grid::before { display: none; }
    }
    .step {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 0 24px;
      position: relative;
      z-index: 1;
    }
    .step-number {
      width: 80px; height: 80px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--green), #10b981);
      color: white;
      font-size: 32px;
      font-weight: 900;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
      box-shadow: 0 8px 24px rgba(5,150,105,0.35);
      flex-shrink: 0;
    }
    .step-title {
      font-size: 18px;
      font-weight: 800;
      color: var(--text);
      margin-bottom: 10px;
    }
    .step-desc {
      font-size: 14px;
      color: var(--muted);
      line-height: 1.6;
    }
    .step-icon-small {
      display: inline-block;
      width: 32px; height: 32px;
      background: var(--green-light);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      margin: 12px auto 0;
    }

    /* ─── CATEGORIES ─── */
    .categories-section { background: var(--green-light); }
    .categories-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-top: 48px;
    }
    @media (max-width: 768px) { .categories-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 480px) { .categories-grid { grid-template-columns: 1fr 1fr; gap: 12px; } }

    .category-card {
      background: white;
      border-radius: 16px;
      padding: 24px 20px;
      display: flex;
      align-items: center;
      gap: 14px;
      border: 1.5px solid rgba(5,150,105,0.08);
      text-decoration: none;
      color: inherit;
      transition: all 0.2s;
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }
    .category-card:hover {
      border-color: var(--green);
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(5,150,105,0.15);
    }
    .category-emoji {
      font-size: 32px;
      width: 56px; height: 56px;
      background: var(--green-light);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: transform 0.2s;
    }
    .category-card:hover .category-emoji { transform: scale(1.1); }
    .category-name {
      font-size: 15px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 3px;
    }
    .category-link {
      font-size: 12px;
      color: var(--green);
      font-weight: 600;
    }

    /* ─── TRUST ─── */
    .trust-section { background: white; }
    .trust-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
      margin-top: 56px;
    }
    @media (max-width: 768px) { .trust-grid { grid-template-columns: 1fr; gap: 20px; } }

    .trust-card {
      background: var(--green-light);
      border: 1.5px solid var(--green-mid);
      border-radius: 20px;
      padding: 32px 28px;
      position: relative;
      overflow: hidden;
    }
    .trust-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--green), #10b981);
    }
    .trust-icon {
      font-size: 36px;
      margin-bottom: 16px;
      display: block;
    }
    .trust-title {
      font-size: 17px;
      font-weight: 800;
      color: var(--green-deep);
      margin-bottom: 10px;
    }
    .trust-text {
      font-size: 14px;
      color: #374151;
      line-height: 1.7;
    }

    /* ─── ORIGINS ─── */
    .origins-section {
      background: var(--green-deep);
      color: white;
      padding: 64px 0;
    }
    .origins-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }
    @media (max-width: 768px) { .origins-grid { grid-template-columns: 1fr; gap: 36px; } }
    .origins-title {
      font-size: clamp(26px, 4vw, 36px);
      font-weight: 900;
      line-height: 1.2;
      margin-bottom: 16px;
    }
    .origins-sub {
      font-size: 15px;
      opacity: 0.7;
      line-height: 1.7;
      margin-bottom: 28px;
    }
    .origins-flags {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }
    .origin-pill {
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 50px;
      padding: 8px 16px;
      font-size: 13px;
      font-weight: 600;
      transition: background 0.2s;
    }
    .origin-pill:hover { background: rgba(255,255,255,0.18); }
    .origins-numbers {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .origin-stat {
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 16px;
      padding: 20px;
      text-align: center;
    }
    .origin-stat-n {
      font-size: 36px;
      font-weight: 900;
      color: #6ee7b7;
      line-height: 1;
      margin-bottom: 6px;
    }
    .origin-stat-l { font-size: 12px; opacity: 0.6; font-weight: 500; }

    /* ─── TESTIMONIALS ─── */
    .testi-section { background: #f9fafb; }
    .testi-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 48px;
    }
    @media (max-width: 900px) { .testi-grid { grid-template-columns: 1fr; max-width: 440px; margin-left: auto; margin-right: auto; } }

    /* WhatsApp style */
    .testi-bubble-wrap {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .testi-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
    }
    .testi-avatar {
      width: 40px; height: 40px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      font-weight: 800;
      color: white;
      flex-shrink: 0;
    }
    .testi-name { font-size: 13px; font-weight: 700; color: var(--text); }
    .testi-city { font-size: 11px; color: var(--muted); }

    .bubble {
      border-radius: 18px;
      padding: 13px 16px;
      font-size: 14px;
      line-height: 1.6;
      position: relative;
      max-width: 90%;
    }
    .bubble-incoming {
      background: white;
      border: 1px solid #e5e7eb;
      border-bottom-left-radius: 4px;
      align-self: flex-start;
      color: var(--text);
      box-shadow: 0 2px 6px rgba(0,0,0,0.06);
    }
    .bubble-outgoing {
      background: #dcf8c6;
      border-bottom-right-radius: 4px;
      align-self: flex-end;
      color: #1a3d1a;
      border: 1px solid #b7e09e;
    }
    .bubble-time {
      font-size: 10px;
      opacity: 0.55;
      margin-top: 4px;
      text-align: right;
    }
    .testi-stars {
      font-size: 13px;
      color: var(--amber);
      margin-top: 8px;
    }
    .testi-card {
      background: white;
      border-radius: 20px;
      padding: 22px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.05);
      border: 1.5px solid var(--border);
      display: flex;
      flex-direction: column;
    }

    /* ─── DELIVERY MODES ─── */
    .delivery-section { background: white; }
    .delivery-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin-top: 48px;
    }
    @media (max-width: 640px) { .delivery-grid { grid-template-columns: 1fr; } }
    .delivery-mode-card {
      border-radius: 20px;
      padding: 32px;
      position: relative;
      overflow: hidden;
    }
    .delivery-avion {
      background: linear-gradient(135deg, #eff6ff, #dbeafe);
      border: 2px solid #bfdbfe;
    }
    .delivery-bateau {
      background: linear-gradient(135deg, var(--green-light), var(--green-mid));
      border: 2px solid #6ee7b7;
    }
    .delivery-mode-icon { font-size: 48px; margin-bottom: 16px; }
    .delivery-mode-tag {
      display: inline-block;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: 6px;
      margin-bottom: 12px;
    }
    .delivery-avion .delivery-mode-tag { background: #1d4ed8; color: white; }
    .delivery-bateau .delivery-mode-tag { background: var(--green); color: white; }
    .delivery-mode-title {
      font-size: 22px;
      font-weight: 900;
      margin-bottom: 8px;
    }
    .delivery-avion .delivery-mode-title { color: #1e3a8a; }
    .delivery-bateau .delivery-mode-title { color: var(--green-deep); }
    .delivery-mode-delay {
      font-size: 15px;
      font-weight: 700;
      margin-bottom: 16px;
    }
    .delivery-avion .delivery-mode-delay { color: #1d4ed8; }
    .delivery-bateau .delivery-mode-delay { color: var(--green-dark); }
    .delivery-mode-points {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .delivery-mode-points li {
      font-size: 14px;
      color: #374151;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .delivery-mode-points li::before {
      content: '✓';
      color: var(--green);
      font-weight: 800;
      font-size: 13px;
      flex-shrink: 0;
    }

    /* ─── FAQ ─── */
    .faq-section { background: var(--green-light); }
    .faq-list {
      max-width: 720px;
      margin: 48px auto 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .faq-item {
      background: white;
      border: 1.5px solid var(--green-mid);
      border-radius: 14px;
      overflow: hidden;
    }
    .faq-question {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 18px 22px;
      background: none;
      border: none;
      font-family: inherit;
      font-size: 15px;
      font-weight: 700;
      color: var(--text);
      cursor: pointer;
      text-align: left;
      transition: background 0.15s;
    }
    .faq-question:hover { background: var(--green-light); }
    .faq-question.open { color: var(--green-dark); }
    .faq-chevron {
      width: 28px; height: 28px;
      background: var(--green-light);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      flex-shrink: 0;
      transition: transform 0.3s;
      color: var(--green);
    }
    .faq-question.open .faq-chevron { transform: rotate(180deg); background: var(--green-mid); }
    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s ease, padding 0.35s ease;
    }
    .faq-answer.open { max-height: 200px; }
    .faq-answer-inner {
      padding: 0 22px 18px;
      font-size: 14px;
      color: #374151;
      line-height: 1.7;
      border-top: 1px solid var(--green-mid);
      padding-top: 16px;
    }

    /* ─── CTA FINAL ─── */
    .cta-section {
      background: linear-gradient(135deg, var(--green-deep) 0%, #065f46 50%, #047857 100%);
      color: white;
      text-align: center;
      padding: 80px 0;
      position: relative;
      overflow: hidden;
    }
    .cta-section::before {
      content: '';
      position: absolute;
      top: -100px; right: -100px;
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(255,255,255,0.06) 0%, transparent 60%);
      border-radius: 50%;
      pointer-events: none;
    }
    .cta-section::after {
      content: '';
      position: absolute;
      bottom: -80px; left: -80px;
      width: 400px; height: 400px;
      background: radial-gradient(circle, rgba(16,185,129,0.15) 0%, transparent 60%);
      border-radius: 50%;
      pointer-events: none;
