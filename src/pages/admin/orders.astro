---
import { requireAuth } from '../../lib/auth';
import { getAllOrders } from '../../lib/orders';
import Layout from '../../layouts/Layout.astro';

const redirect = requireAuth(Astro);
if (redirect) return redirect;

const orders = getAllOrders();

const statusLabel: Record<string, string> = {
  en_attente: 'En attente',
  disponible: 'Disponible',
  recupere: 'Récupéré',
  annulee: 'Annulée',
};

const statusColor: Record<string, string> = {
  en_attente: 'bg-yellow-100 text-yellow-800',
  disponible: 'bg-green-100 text-green-800',
  recupere: 'bg-gray-100 text-gray-600',
  annulee: 'bg-red-100 text-red-700',
};
---

<Layout title="Gestion des commandes" isAdmin={true}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 space-y-6">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Commandes</h1>
        <p class="text-sm text-gray-500 mt-1">{orders.length} commande{orders.length !== 1 ? 's' : ''} au total</p>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <a
          href="/api/orders/export?format=xlsx"
          class="flex items-center gap-1.5 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold px-3 py-2.5 rounded-lg transition-colors shadow-sm"
          title="Exporter en Excel"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          <span class="hidden sm:inline">Excel</span>
        </a>
        <a
          href="/api/orders/export?format=csv"
          class="flex items-center gap-1.5 bg-gray-600 hover:bg-gray-700 text-white text-sm font-semibold px-3 py-2.5 rounded-lg transition-colors shadow-sm"
          title="Exporter en CSV"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          <span class="hidden sm:inline">CSV</span>
        </a>
        <button
          id="notify-btn"
          class="flex items-center gap-1.5 bg-green-500 hover:bg-green-600 text-white text-sm font-semibold px-3 py-2.5 rounded-lg transition-colors shadow-sm"
          title="Marquer les commandes en attente comme disponibles"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
          </svg>
          <span class="hidden sm:inline">Notifier disponible</span>
          <span id="notify-count" class="hidden bg-white/30 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full"></span>
        </button>
        <button
          id="remind-btn"
          class="flex items-center gap-1.5 bg-orange-500 hover:bg-orange-600 text-white text-sm font-semibold px-3 py-2.5 rounded-lg transition-colors shadow-sm"
          title="Envoyer un rappel aux clients dont la commande est disponible depuis 3+ jours"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span class="hidden sm:inline">Rappels</span>
          <span id="remind-count" class="hidden bg-white/30 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full"></span>
        </button>
        <a
          href="/admin"
          class="flex items-center gap-1.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-3 py-2.5 rounded-lg transition-colors shadow-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          <span class="hidden sm:inline">Nouvelle commande</span>
        </a>
      </div>
    </div>

    <!-- Search -->
    <div class="relative">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      <input
        id="search-input"
        type="text"
        placeholder="Rechercher par client ou numéro de commande..."
        class="w-full pl-9 pr-3 py-2.5 border border-gray-300 rounded-xl text-sm bg-white shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
    </div>
    <p id="search-count" class="text-xs text-gray-400 -mt-4 hidden"></p>

    <!-- Status Filters — icônes (mobile) -->
    <div class="flex md:hidden gap-2">
      <button class="filter-btn flex items-center gap-1.5 px-3 py-2 rounded-full border transition-all shrink-0 active" data-filter="all" title="Toutes">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h7"/></svg>
        <span class="text-xs font-bold">{orders.length}</span>
      </button>
      <button class="filter-btn flex items-center gap-1.5 px-3 py-2 rounded-full border transition-all shrink-0" data-filter="en_attente" title="En attente">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span class="text-xs font-bold">{orders.filter(o => o.status === 'en_attente').length}</span>
      </button>
      <button class="filter-btn flex items-center gap-1.5 px-3 py-2 rounded-full border transition-all shrink-0" data-filter="disponible" title="Disponible">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span class="text-xs font-bold">{orders.filter(o => o.status === 'disponible').length}</span>
      </button>
      <button class="filter-btn flex items-center gap-1.5 px-3 py-2 rounded-full border transition-all shrink-0" data-filter="recupere" title="Récupéré">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
        <span class="text-xs font-bold">{orders.filter(o => o.status === 'recupere').length}</span>
      </button>
      <button class="filter-btn flex items-center gap-1.5 px-3 py-2 rounded-full border transition-all shrink-0" data-filter="annulee" title="Annulée">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
        <span class="text-xs font-bold">{orders.filter(o => o.status === 'annulee').length}</span>
      </button>
    </div>

    <!-- Status Filters — texte (tablette/desktop) -->
    <div class="hidden md:flex gap-2 flex-wrap">
      {[
        { key: 'all',        label: 'Toutes',     count: orders.length },
        { key: 'en_attente', label: 'En attente', count: orders.filter(o => o.status === 'en_attente').length },
        { key: 'disponible', label: 'Disponible', count: orders.filter(o => o.status === 'disponible').length },
        { key: 'recupere',   label: 'Récupéré',   count: orders.filter(o => o.status === 'recupere').length },
        { key: 'annulee',    label: 'Annulées',   count: orders.filter(o => o.status === 'annulee').length },
      ].map(f => (
        <button
          class={`filter-btn px-4 py-1.5 rounded-full text-sm font-medium border transition-all whitespace-nowrap shrink-0 ${f.key === 'all' ? 'active' : ''}`}
          data-filter={f.key}
        >
          {f.label}
          <span class="ml-1.5 bg-black/10 px-1.5 py-0.5 rounded-full text-xs">{f.count}</span>
        </button>
      ))}
    </div>

    {orders.length === 0 ? (
      <div class="text-center py-20 bg-white rounded-2xl border border-gray-200">
        <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
        </div>
        <p class="font-semibold text-gray-700 text-lg">Aucune commande</p>
        <p class="text-gray-400 text-sm mt-1 mb-5">Commencez par créer votre première commande</p>
        <a href="/admin" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Créer une commande
        </a>
      </div>
    ) : (
      <>
        <!-- Mobile cards (hidden on md+) -->
        <div class="md:hidden space-y-3">
          {orders.map(order => (
            <div
              class="order-row bg-white rounded-2xl border border-gray-200 shadow-sm p-4"
              data-status={order.status}
              data-client={order.client_name.toLowerCase()}
              data-number={order.order_number.toLowerCase()}
              data-date={order.created_at?.slice(0, 10)}
              data-total={order.total_amount}
              data-order-id={order.id}
              data-order-name={order.client_name}
              data-order-num={order.order_number}
            >
              <!-- Top row: number + status -->
              <div class="flex items-center justify-between mb-2">
                <span class="font-mono text-xs font-bold text-blue-700 bg-blue-50 px-2 py-1 rounded-md">
                  {order.order_number}
                </span>
                <span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${statusColor[order.status ?? 'en_attente']}`}>
                  {statusLabel[order.status ?? 'en_attente']}
                </span>
              </div>
              <!-- Client + delivery -->
              <div class="font-semibold text-gray-900 text-sm">{order.client_name}</div>
              <div class="text-xs text-gray-400 mt-0.5 flex items-center gap-2">
                <span>{order.client_phone}</span>
                <span>·</span>
                <span>{order.delivery_type === 'avion' ? '✈️ EXPRESS' : '🚢 ECO'}</span>
                <span>·</span>
                <span>{new Date(order.created_at!).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short' })}</span>
              </div>
              <!-- Balance + actions -->
              <div class="flex items-center justify-between mt-3 pt-3 border-t border-gray-100">
                <div class="text-sm">
                  <span class="text-gray-500 text-xs">Reste : </span>
                  <span class={order.remaining_balance > 0 ? 'text-red-600 font-bold' : 'text-green-600 font-bold'}>
                    {order.remaining_balance.toLocaleString('fr-FR')} FCFA
                  </span>
                </div>
                <div class="flex items-center gap-1">
                  <button class="view-btn p-2 text-gray-500 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors" data-id={order.id} data-order={JSON.stringify(order)} title="Voir le détail">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                  </button>
                  {!order.products_paid_at && (
                    <button class="edit-btn p-2 text-gray-500 hover:text-amber-600 hover:bg-amber-50 rounded-lg transition-colors" data-id={order.id} data-order={JSON.stringify(order)} title="Modifier">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    </button>
                  )}
                  {order.status === 'en_attente' && (
                    <button class="confirm-available-btn p-2 text-gray-500 hover:text-green-600 hover:bg-green-50 rounded-lg transition-colors" data-id={order.id} data-name={order.client_name} title="Marquer disponible">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </button>
                  )}
                  {order.status === 'disponible' && (
                    <button class="confirm-pickup-btn p-2 rounded-lg transition-colors" data-id={order.id} data-name={order.client_name} data-number={order.order_number} data-remaining={order.remaining_balance}
                      class:list={order.remaining_balance > 0 ? 'text-gray-300 cursor-not-allowed' : 'text-gray-500 hover:text-purple-600 hover:bg-purple-50'}
                      title={order.remaining_balance > 0 ? `Solde restant : ${order.remaining_balance.toLocaleString('fr-FR')} FCFA` : 'Confirmer récupération'}>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                    </button>
                  )}
                  {order.remaining_balance > 0 && (
                    <button class="payment-btn p-2 text-gray-500 hover:text-emerald-600 hover:bg-emerald-50 rounded-lg transition-colors" data-id={order.id} data-name={order.client_name} data-number={order.order_number} data-total={order.total_amount} data-deposit={order.deposit} data-remaining={order.remaining_balance} title="Enregistrer un paiement">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </button>
                  )}
                  {!order.products_paid_at && (
                    <button class="notify-paid-btn p-2 text-gray-500 hover:text-green-600 hover:bg-green-50 rounded-lg transition-colors" data-id={order.id} data-name={order.client_name} data-number={order.order_number} title="Informer le client que les produits sont payés (WhatsApp)">
                      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                    </button>
                  )}
                  {(order.status === 'en_attente' || order.status === 'disponible') && (
                    <button class="cancel-order-btn p-2 text-gray-500 hover:text-orange-600 hover:bg-orange-50 rounded-lg transition-colors" data-id={order.id} data-name={order.client_name} data-number={order.order_number} title="Annuler la commande">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
                    </button>
                  )}
                  <div class="relative">
                    <button class="print-menu-btn p-2 text-gray-500 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors" title="Imprimer">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
                      </svg>
                    </button>
                    <div class="print-menu hidden absolute right-0 top-full mt-1 bg-white border border-gray-200 rounded-xl shadow-lg z-50 min-w-[200px] overflow-hidden">
                      <a href={`/admin/print/${order.order_number}`} target="_blank" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-700">
                        Facture
                      </a>
                      <div class="h-px bg-gray-100"></div>
                      {order.status === 'recupere' ? (
                        <a href={`/admin/print/livraison/${order.order_number}`} target="_blank" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-700">
                          Bon de livraison
                        </a>
                      ) : (
                        <span class="block px-4 py-2 text-sm text-gray-300 cursor-not-allowed" title="Disponible après récupération">
                          Bon de livraison 🔒
                        </span>
                      )}
                      <div class="h-px bg-gray-100"></div>
                      <a href={`/admin/print/remboursement/${order.order_number}`} target="_blank" class="block px-4 py-2 text-sm text-gray-700 hover:bg-red-50 hover:text-red-700">
                        Lettre d'engagement remboursement
                      </a>
                      <a href={`/admin/print/remboursement/bon/${order.order_number}`} target="_blank" class="block px-4 py-2 text-sm text-gray-700 hover:bg-red-50 hover:text-red-700">
                        Bon de remboursement
                      </a>
                    </div>
                  </div>
                  {!order.products_paid_at && (
                    <button class="delete-btn p-2 text-gray-500 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors" data-id={order.id} data-name={order.client_name} data-number={order.order_number} title="Supprimer">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    </button>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- Desktop table (hidden on mobile) -->
        <div class="hidden md:block bg-white rounded-2xl shadow-sm border border-gray-200">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-100">
              <tr>
                <th class="text-left px-5 py-3.5 font-semibold text-gray-600 text-xs uppercase tracking-wider">N° commande</th>
                <th class="text-left px-5 py-3.5 font-semibold text-gray-600 text-xs uppercase tracking-wider">Client</th>
                <th class="text-left px-5 py-3.5 font-semibold text-gray-600 text-xs uppercase tracking-wider">Livraison</th>
                <th class="text-right px-5 py-3.5 font-semibold text-gray-600 text-xs uppercase tracking-wider">Total</th>
                <th class="text-right px-5 py-3.5 font-semibold text-gray-600 text-xs uppercase tracking-wider">Reste</th>
                <th class="text-center px-5 py-3.5 font-semibold text-gray-600 text-xs uppercase tracking-wider">Statut</th>
                <th class="text-left px-5 py-3.5 font-semibold text-gray-600 text-xs uppercase tracking-wider">Date</th>
                <th class="px-5 py-3.5 text-center text-xs font-bold text-gray-500 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
              {orders.map(order => (
                <tr
                  class="order-row hover:bg-gray-50/80 transition-colors group"
                  data-status={order.status}
                  data-client={order.client_name.toLowerCase()}
                  data-number={order.order_number.toLowerCase()}
                  data-date={order.created_at?.slice(0, 10)}
                  data-total={order.total_amount}
                  data-order-id={order.id}
                  data-order-name={order.client_name}
                  data-order-num={order.order_number}
                >
                  <td class="px-5 py-4">
                    <span class="font-mono text-xs font-bold text-blue-700 bg-blue-50 px-2 py-1 rounded-md">
                      {order.order_number}
                    </span>
                  </td>
                  <td class="px-5 py-4">
                    <div class="font-semibold text-gray-900">{order.client_name}</div>
                    <div class="text-gray-400 text-xs mt-0.5">{order.client_phone}</div>
                  </td>
                  <td class="px-5 py-4 text-gray-600">
                    {order.delivery_type === 'avion' ? '✈️ EXPRESS' : '🚢 ECO'}
                  </td>
                  <td class="px-5 py-4 text-right font-semibold text-gray-900">
                    {order.total_amount.toLocaleString('fr-FR')} FCFA
                  </td>
                  <td class="px-5 py-4 text-right">
                    <span class={order.remaining_balance > 0 ? 'text-red-600 font-semibold' : 'text-green-600 font-semibold'}>
                      {order.remaining_balance.toLocaleString('fr-FR')} FCFA
                    </span>
                  </td>
                  <td class="px-5 py-4 text-center">
                    <span class={`inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold ${statusColor[order.status ?? 'en_attente']}`}>
                      {statusLabel[order.status ?? 'en_attente']}
                    </span>
                  </td>
                  <td class="px-5 py-4 text-gray-500 text-xs">
                    {new Date(order.created_at!).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' })}
                  </td>
                  <td class="px-5 py-4">
                    <div class="flex items-center gap-1 justify-end opacity-60 group-hover:opacity-100 transition-opacity">
                      <button class="view-btn p-2 text-gray-500 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors" data-id={order.id} data-order={JSON.stringify(order)} title="Voir le détail">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                      </button>
                      {!order.products_paid_at && (
                        <button class="edit-btn p-2 text-gray-500 hover:text-amber-600 hover:bg-amber-50 rounded-lg transition-colors" data-id={order.id} data-order={JSON.stringify(order)} title="Modifier">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                        </button>
                      )}
                      {order.status === 'en_attente' && (
                        <button class="confirm-available-btn p-2 text-gray-500 hover:text-green-600 hover:bg-green-50 rounded-lg transition-colors" data-id={order.id} data-name={order.client_name} title="Marquer disponible (envoi WhatsApp)">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </button>
                      )}
                      {order.status === 'disponible' && (
                        <button class="confirm-pickup-btn p-2 rounded-lg transition-colors" data-id={order.id} data-name={order.client_name} data-number={order.order_number} data-remaining={order.remaining_balance}
                          class:list={order.remaining_balance > 0 ? 'text-gray-300 cursor-not-allowed' : 'text-gray-500 hover:text-purple-600 hover:bg-purple-50'}
                          title={order.remaining_balance > 0 ? `Solde restant : ${order.remaining_balance.toLocaleString('fr-FR')} FCFA` : 'Confirmer récupération et paiement'}>
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                        </button>
                      )}
                      {order.remaining_balance > 0 && (
                        <button class="payment-btn p-2 text-gray-500 hover:text-emerald-600 hover:bg-emerald-50 rounded-lg transition-colors" data-id={order.id} data-name={order.client_name} data-number={order.order_number} data-total={order.total_amount} data-deposit={order.deposit} data-remaining={order.remaining_balance} title="Enregistrer un paiement">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </button>
                      )}
                      {!order.products_paid_at && (
                        <button class="notify-paid-btn p-2 text-gray-500 hover:text-green-600 hover:bg-green-50 rounded-lg transition-colors" data-id={order.id} data-name={order.client_name} data-number={order.order_number} title="Informer le client que les produits sont payés (WhatsApp)">
                          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                        </button>
                      )}
                      {(order.status === 'en_attente' || order.status === 'disponible') && (
                        <button class="cancel-order-btn p-2 text-gray-500 hover:text-orange-600 hover:bg-orange-50 rounded-lg transition-colors" data-id={order.id} data-name={order.client_name} data-number={order.order_number} title="Annuler la commande">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
                        </button>
                      )}
                      <div class="relative">
                        <button class="print-menu-btn p-2 text-gray-500 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors" title="Imprimer">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
                          </svg>
                        </button>
                        <div class="print-menu hidden absolute right-0 top-full mt-1 bg-white border border-gray-200 rounded-xl shadow-lg z-50 min-w-[200px] overflow-hidden">
                          <a href={`/admin/print/${order.order_number}`} target="_blank" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-700">
                            Facture
                          </a>
                          <div class="h-px bg-gray-100"></div>
                          {order.status === 'recupere' ? (
                            <a href={`/admin/print/livraison/${order.order_number}`} target="_blank" class="block px-4 py-2 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-700">
                              Bon de livraison
                            </a>
                          ) : (
                            <span class="block px-4 py-2 text-sm text-gray-300 cursor-not-allowed" title="Disponible après récupération">
                              Bon de livraison 🔒
                            </span>
                          )}
                          <div class="h-px bg-gray-100"></div>
                          <a href={`/admin/print/remboursement/${order.order_number}`} target="_blank" class="block px-4 py-2 text-sm text-gray-700 hover:bg-red-50 hover:text-red-700">
                            Lettre d'engagement remboursement
                          </a>
                          <a href={`/admin/print/remboursement/bon/${order.order_number}`} target="_blank" class="block px-4 py-2 text-sm text-gray-700 hover:bg-red-50 hover:text-red-700">
                            Bon de remboursement
                          </a>
                        </div>
                      </div>
                      {!order.products_paid_at && (
                        <button class="delete-btn p-2 text-gray-500 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors" data-id={order.id} data-name={order.client_name} data-number={order.order_number} title="Supprimer">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                        </button>
                      )}
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}
    <div id="orders-pagination"></div>
  </div>

  <!-- View Modal -->
  <div id="view-modal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center z-[200] p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 sticky top-0 bg-white rounded-t-2xl">
        <h2 class="text-base font-bold text-gray-900">Détail commande</h2>
        <button id="close-view-modal" class="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <div id="view-modal-content" class="p-6"></div>
    </div>
  </div>

  <!-- Edit Modal -->
  <div id="edit-modal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center z-[200] p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 sticky top-0 bg-white rounded-t-2xl">
        <h2 class="text-base font-bold text-gray-900">Modifier la commande</h2>
        <button id="close-edit-modal" class="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <form id="edit-form" class="p-6 space-y-5">
        <input type="hidden" id="edit-order-id" />
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wider">Nom client</label>
            <input id="edit-client-name" type="text" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wider">WhatsApp</label>
            <input id="edit-client-phone" type="tel" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wider">Livraison</label>
            <select id="edit-delivery" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
              <option value="avion">✈️ EXPRESS</option>
              <option value="bateau">🚢 ECO</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wider">Statut</label>
            <select id="edit-status" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
              <option value="en_attente">⏳ En attente</option>
              <option value="disponible">✅ Disponible</option>
              <option value="recupere">📦 Récupéré</option>
              <option value="annulee">🚫 Annulée</option>
            </select>
          </div>
        </div>

        <!-- Edit products -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wider">Produits</label>
            <button type="button" id="edit-add-product"
              class="text-xs text-blue-600 hover:text-blue-800 font-semibold flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
              Ajouter
            </button>
          </div>
          <div id="edit-products-list" class="space-y-2"></div>
        </div>

        <div class="grid grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wider">Total (FCFA)</label>
            <input id="edit-total" type="number" step="1" readonly class="w-full px-3 py-2 border border-gray-200 bg-gray-50 rounded-lg text-sm font-semibold cursor-not-allowed" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wider">Acompte (FCFA)</label>
            <input id="edit-deposit" type="number" step="1" min="0" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wider">Reste (FCFA)</label>
            <input id="edit-remaining" type="number" step="1" readonly class="w-full px-3 py-2 border border-gray-200 bg-gray-50 rounded-lg text-sm font-semibold cursor-not-allowed" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1.5 uppercase tracking-wider">Notes</label>
          <textarea id="edit-notes" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none"></textarea>
        </div>

        <div id="edit-error" class="hidden p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700"></div>

        <div class="flex justify-end gap-3 pt-2 border-t border-gray-100">
          <button type="button" id="cancel-edit"
            class="px-4 py-2.5 text-sm font-semibold text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
            Annuler
          </button>
          <button type="submit" id="edit-submit"
            class="px-4 py-2.5 text-sm font-semibold bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors flex items-center gap-2 disabled:opacity-60">
            <svg id="edit-submit-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <svg id="edit-submit-spinner" class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
            </svg>
            Enregistrer
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Payment Modal -->
  <div id="payment-modal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center z-[200] p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm">
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
        <h2 class="text-base font-bold text-gray-900">💰 Enregistrer un paiement</h2>
        <button id="close-payment-modal" class="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <div class="p-6 space-y-4">
        <div class="bg-gray-50 rounded-xl p-4 text-sm space-y-2">
          <div class="flex justify-between"><span class="text-gray-500">Client</span><span id="pay-client-name" class="font-semibold"></span></div>
          <div class="flex justify-between"><span class="text-gray-500">Commande</span><span id="pay-order-number" class="font-mono text-xs text-blue-700 font-bold"></span></div>
          <div class="flex justify-between"><span class="text-gray-500">Total</span><span id="pay-total" class="font-semibold"></span></div>
          <div class="flex justify-between"><span class="text-gray-500">Déjà versé</span><span id="pay-deposit" class="text-green-600 font-semibold"></span></div>
          <div class="flex justify-between pt-2 border-t border-gray-200 font-bold">
            <span>Reste à payer</span>
            <span id="pay-remaining" class="text-red-600"></span>
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Montant du paiement (FCFA)</label>
          <input
            id="pay-amount"
            type="number"
            min="1"
            step="1"
            class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
            placeholder="0"
          />
          <button id="pay-full-btn" type="button" class="mt-2 text-xs text-emerald-600 hover:text-emerald-800 font-medium underline">
            Solder le reste (tout payer)
          </button>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Mode de paiement</label>
          <select id="pay-method" class="w-full px-3 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent bg-white">
            <option value="">— Sélectionner —</option>
            <option value="Espèces">Espèces</option>
            <option value="Mix by Yas">Mix by Yas</option>
            <option value="Moov Money">Moov Money</option>
            <option value="Virement bancaire">Virement bancaire</option>
          </select>
        </div>
        <div id="pay-error" class="hidden text-sm text-red-600 bg-red-50 rounded-lg px-3 py-2"></div>
        <div class="flex gap-3">
          <button id="cancel-payment" class="flex-1 px-4 py-2.5 text-sm font-semibold text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
            Annuler
          </button>
          <button id="do-payment" class="flex-1 px-4 py-2.5 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg transition-colors flex items-center justify-center gap-2">
            <svg id="pay-spinner" class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
            </svg>
            <span id="pay-btn-label">Valider le paiement</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Notify Available Modal -->
  <div id="notify-modal" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center z-[200] p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md">
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
        <div>
          <h2 class="text-base font-bold text-gray-900">Marquer disponible</h2>
          <p id="notify-subtitle" class="text-xs text-gray-400 mt-0.5"></p>
        </div>
        <button id="close-notify-modal" class="text-gray-400 hover:text-gray-600 text-xl font-bold leading-none">✕</button>
      </div>
