// ── Hidden delete: Ctrl+Shift+D (desktop) + long press 1.5s (mobile) ────────
let hoveredOrderId: string | null   = null;
let hoveredOrderName: string | null = null;
let hoveredOrderNum: string | null  = null;
let longPressTimer: ReturnType<typeof setTimeout> | null = null;

// Track hovered/touched order row
document.querySelectorAll('.order-row').forEach(row => {
  const id   = row.getAttribute('data-order-id');
  const name = row.getAttribute('data-order-name');
  const num  = row.getAttribute('data-order-num');

  // Desktop hover
  row.addEventListener('mouseenter', () => {
    hoveredOrderId   = id;
    hoveredOrderName = name;
    hoveredOrderNum  = num;
  });
  row.addEventListener('mouseleave', () => {
    hoveredOrderId   = null;
    hoveredOrderName = null;
    hoveredOrderNum  = null;
  });

  // Mobile long press
  row.addEventListener('touchstart', () => {
    longPressTimer = setTimeout(() => {
      hoveredOrderId   = id;
      hoveredOrderName = name;
      hoveredOrderNum  = num;
      triggerHiddenDelete();
    }, 1500);
  }, { passive: true });

  row.addEventListener('touchend',   () => { if (longPressTimer) { clearTimeout(longPressTimer); longPressTimer = null; } });
  row.addEventListener('touchmove',  () => { if (longPressTimer) { clearTimeout(longPressTimer); longPressTimer = null; } });
});

// Desktop Ctrl+Shift+D
document.addEventListener('keydown', (e) => {
  if (e.ctrlKey && e.shiftKey && e.key === 'D') {
    e.preventDefault();
    triggerHiddenDelete();
  }
});

async function triggerHiddenDelete() {
  if (!hoveredOrderId) return;
  const id   = hoveredOrderId;
  const name = hoveredOrderName ?? '';
  const num  = hoveredOrderNum  ?? '';
  if (!confirm(`⚠️ Supprimer la commande ${num} (${name}) ? Cette action est irréversible.`)) return;
  try {
    const res = await fetch(`/api/orders/${id}`, { method: 'DELETE' });
    if (res.ok) {
      window.__showToast?.(`Commande ${num} supprimée`, 'success');
      document.querySelectorAll(`.order-row[data-order-id="${id}"]`).forEach(r => r.remove());
    } else {
      window.__showToast?.('Erreur lors de la suppression.', 'error');
    }
  } catch {
    window.__showToast?.('Erreur réseau.', 'error');
  }
}

