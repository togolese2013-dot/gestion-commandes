// ── Notify Available ────────────────────────────────────────────────────────
const notifyModal   = document.getElementById('notify-modal')!;
const notifyList    = document.getElementById('notify-list')!;
const notifyResult  = document.getElementById('notify-result')!;
const notifySubtitle = document.getElementById('notify-subtitle')!;
let pendingOrders: any[] = [];

async function loadDisponible() {
  try {
    const res = await fetch('/api/orders/notify-available');
    if (!res.ok) return;
    const data = await res.json();
    pendingOrders = data.orders ?? [];
    // Update button badge
    const badge = document.getElementById('notify-count')!;
    if (pendingOrders.length > 0) {
      badge.textContent = String(pendingOrders.length);
      badge.classList.remove('hidden');
    } else {
      badge.classList.add('hidden');
    }
  } catch { /* silent */ }
}
loadDisponible();

document.getElementById('notify-btn')!.addEventListener('click', async () => {
  await loadDisponible();
  notifyResult.classList.add('hidden');
  notifyResult.innerHTML = '';

  if (pendingOrders.length === 0) {
    notifyList.innerHTML = '<p class="text-gray-400 text-sm text-center py-4">Aucune commande en attente à notifier.</p>';
    notifySubtitle.textContent = '0 client';
    (document.getElementById('do-notify') as HTMLButtonElement).disabled = true;
  } else {
    (document.getElementById('do-notify') as HTMLButtonElement).disabled = false;
    notifySubtitle.textContent = `${pendingOrders.length} commande${pendingOrders.length > 1 ? 's' : ''} à marquer disponible`;
    notifyList.innerHTML = pendingOrders.map((o: any) => `
      <div class="flex items-center justify-between bg-green-50 border border-green-100 rounded-xl px-4 py-2.5">
        <div>
          <p class="text-sm font-semibold text-gray-900">${esc(o.client_name)}</p>
          <p class="text-xs text-gray-400 font-mono">${esc(o.order_number)}</p>
        </div>
        <div class="text-right">
          <p class="text-xs font-mono text-gray-500">${esc(o.client_phone)}</p>
          ${Number(o.remaining_balance) > 0
            ? `<p class="text-xs text-red-500 font-semibold">Reste: ${fmt(Number(o.remaining_balance))} F</p>`
            : '<p class="text-xs text-green-600 font-semibold">Soldé ✓</p>'}
        </div>
      </div>
    `).join('');
  }

  notifyModal.classList.remove('hidden');
});

document.getElementById('close-notify-modal')!.addEventListener('click', () => notifyModal.classList.add('hidden'));
document.getElementById('cancel-notify')!.addEventListener('click', () => notifyModal.classList.add('hidden'));
notifyModal.addEventListener('click', e => { if (e.target === notifyModal) notifyModal.classList.add('hidden'); });

document.getElementById('do-notify')!.addEventListener('click', async () => {
  const btn     = document.getElementById('do-notify') as HTMLButtonElement;
  const spinner = document.getElementById('notify-spinner')!;
  const label   = document.getElementById('notify-btn-label')!;
  btn.disabled = true;
  spinner.classList.remove('hidden');
  label.classList.add('hidden');

  const done: string[]   = [];
  const failed: string[] = [];

  try {
    for (const order of pendingOrders) {
      const res = await fetch(`/api/orders/${order.id}/confirm`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'available' }),
      });
      if (res.ok) done.push(order.order_number);
      else failed.push(order.order_number);
    }

    notifyResult.classList.remove('hidden');
    notifyResult.innerHTML = `
      <div class="space-y-1">
        ${done.length > 0 ? `<p class="text-green-700 font-semibold">✅ ${done.length} commande${done.length > 1 ? 's' : ''} marquée${done.length > 1 ? 's' : ''} disponible</p>` : ''}
        ${failed.length > 0 ? `<p class="text-red-600 font-semibold">❌ ${failed.length} échec : ${failed.join(', ')}</p>` : ''}
      </div>
    `;
    label.textContent = 'Terminé';
    if (done.length > 0) setTimeout(() => { window.location.reload(); }, 1200);
  } catch {
    notifyResult.innerHTML = '<p class="text-red-600">Erreur lors de la mise à jour.</p>';
    notifyResult.classList.remove('hidden');
  } finally {
    btn.disabled = false;
    spinner.classList.add('hidden');
    label.classList.remove('hidden');
  }
});

// ── SSE: mises à jour temps réel des commandes ───────────────────────────────
(function () {
  const STATUS_LABEL: Record<string, string> = {
    en_attente: 'En attente',
    disponible:  'Disponible',
    recupere:    'Récupéré',
  };
  const STATUS_COLOR: Record<string, string> = {
    en_attente: 'bg-yellow-100 text-yellow-800',
    disponible:  'bg-green-100 text-green-800',
    recupere:    'bg-gray-100 text-gray-600',
  };

  // -- Refresh banner (shown when a new order arrives) -------------------------
  function showRefreshBanner() {
    if (document.getElementById('sse-refresh-banner')) return;
    const banner = document.createElement('div');
    banner.id = 'sse-refresh-banner';
    banner.className = 'fixed top-16 left-1/2 -translate-x-1/2 z-[300] bg-blue-600 text-white text-sm font-semibold px-5 py-3 rounded-xl shadow-2xl flex items-center gap-3';
    banner.innerHTML = `
      <span>🆕 Nouvelle commande reçue</span>
      <button class="bg-white text-blue-600 px-3 py-1 rounded-lg text-xs font-bold hover:bg-blue-50 transition-colors">Rafraîchir</button>
      <button class="text-blue-200 hover:text-white text-lg leading-none ml-1">✕</button>
    `;
    (banner.querySelectorAll('button')[0] as HTMLButtonElement).addEventListener('click', () => window.location.reload());
    (banner.querySelectorAll('button')[1] as HTMLButtonElement).addEventListener('click', () => banner.remove());
    document.body.appendChild(banner);
  }

  // -- Patch a single .order-row in the DOM -----------------------------------
  function patchRow(row: HTMLElement, order: any) {
    const status = order.status ?? 'en_attente';
    const remaining = Number(order.remaining_balance ?? 0);

    // Update data attribute used by filters
    row.dataset.status = status;

    // Status badge — card view: span.rounded-full.font-semibold (first match)
    // Table view: span.rounded-full.text-xs.font-semibold (inline-flex)
    row.querySelectorAll<HTMLElement>('span[class*="rounded-full"]').forEach(badge => {
      const txt = badge.textContent?.trim() ?? '';
      if (Object.values(STATUS_LABEL).includes(txt)) {
        // Remove old color classes
        badge.classList.remove(
          'bg-yellow-100', 'text-yellow-800',
          'bg-green-100',  'text-green-800',
          'bg-gray-100',   'text-gray-600',
        );
        const colors = (STATUS_COLOR[status] ?? 'bg-gray-100 text-gray-600').split(' ');
        badge.classList.add(...colors);
        badge.textContent = STATUS_LABEL[status] ?? status;
      }
    });

    // Remaining balance — look for the colored amount span
    row.querySelectorAll<HTMLElement>('span.text-red-600, span.text-green-600').forEach(span => {
      const txt = span.textContent?.trim() ?? '';
      if (txt.includes('FCFA')) {
        span.classList.toggle('text-red-600',   remaining > 0);
        span.classList.toggle('text-green-600',  remaining <= 0);
        span.classList.toggle('font-bold',       true);
        span.classList.toggle('font-semibold',   true);
        span.textContent = `${remaining.toLocaleString('fr-FR')} FCFA`;
      }
    });
  }

  // -- new_order event --------------------------------------------------------
  window.addEventListener('sse:new_order', (e: Event) => {
    const order = (e as CustomEvent).detail;
    window.__showToast?.(`🆕 Nouvelle commande : ${order.order_number} — ${order.client_name}`, 'success', 8000);
    showRefreshBanner();
  });

  // -- order_updated event ----------------------------------------------------
  window.addEventListener('sse:order_updated', (e: Event) => {
    const order = (e as CustomEvent).detail;
    const rows = document.querySelectorAll<HTMLElement>(`.order-row[data-order-id="${order.id}"]`);
    rows.forEach(row => patchRow(row, order));
  });

  // -- order_deleted event ----------------------------------------------------
  window.addEventListener('sse:order_deleted', (e: Event) => {
    const { id } = (e as CustomEvent).detail;
    document.querySelectorAll<HTMLElement>(`.order-row[data-order-id="${id}"]`).forEach(r => r.remove());
  });
})();

// ── Rappels automatiques ─────────────────────────────────────────────────────
const remindModal    = document.getElementById('remind-modal')!;
const remindList     = document.getElementById('remind-list')!;
const remindResult   = document.getElementById('remind-result')!;
const remindSubtitle = document.getElementById('remind-subtitle')!;
let remindOrders: any[] = [];

async function loadReminders() {
  try {
    const res = await fetch('/api/orders/remind-disponible');
    if (!res.ok) return;
    const data = await res.json();
    remindOrders = data.orders ?? [];
    const badge = document.getElementById('remind-count')!;
    if (remindOrders.length > 0) {
      badge.textContent = String(remindOrders.length);
      badge.classList.remove('hidden');
    } else {
      badge.classList.add('hidden');
    }
  } catch { /* silent */ }
}
loadReminders();

document.getElementById('remind-btn')!.addEventListener('click', async () => {
  await loadReminders();
  remindResult.classList.add('hidden');
  remindResult.innerHTML = '';

  if (remindOrders.length === 0) {
    remindList.innerHTML = '<p class="text-gray-400 text-sm text-center py-4">Aucune commande éligible au rappel (disponible depuis moins de 3 jours).</p>';
    remindSubtitle.textContent = '0 rappel à envoyer';
    (document.getElementById('do-remind') as HTMLButtonElement).disabled = true;
  } else {
    (document.getElementById('do-remind') as HTMLButtonElement).disabled = false;
    remindSubtitle.textContent = `${remindOrders.length} client${remindOrders.length > 1 ? 's' : ''} — disponible depuis 3+ jours`;
    remindList.innerHTML = remindOrders.map((o: any) => `
      <div class="flex items-center justify-between bg-orange-50 border border-orange-100 rounded-xl px-4 py-2.5">
        <div>
          <p class="text-sm font-semibold text-gray-900">${esc(o.client_name)}</p>
          <p class="text-xs text-gray-400 font-mono">${esc(o.order_number)}</p>
        </div>
        <div class="text-right">
          <p class="text-xs font-mono text-gray-500">${esc(o.client_phone)}</p>
          ${Number(o.remaining_balance) > 0
            ? `<p class="text-xs text-red-500 font-semibold">Reste: ${fmt(Number(o.remaining_balance))} F</p>`
            : '<p class="text-xs text-green-600 font-semibold">Soldé ✓</p>'}
        </div>
      </div>
    `).join('');
  }
  remindModal.classList.remove('hidden');
});

document.getElementById('close-remind-modal')!.addEventListener('click', () => remindModal.classList.add('hidden'));
document.getElementById('cancel-remind')!.addEventListener('click', () => remindModal.classList.add('hidden'));
remindModal.addEventListener('click', e => { if (e.target === remindModal) remindModal.classList.add('hidden'); });

document.getElementById('do-remind')!.addEventListener('click', async () => {
  const btn     = document.getElementById('do-remind') as HTMLButtonElement;
  const spinner = document.getElementById('remind-spinner')!;
  const label   = document.getElementById('remind-btn-label')!;
  btn.disabled = true;
  spinner.classList.remove('hidden');
  label.classList.add('hidden');

  try {
    const res = await fetch('/api/orders/remind-disponible', { method: 'POST' });
    const data = await res.json();
    const sent   = data.sent   as string[];
    const failed = data.failed as string[];
    remindResult.classList.remove('hidden');
    remindResult.innerHTML = `
      <div class="space-y-1">
        ${sent.length > 0 ? `<p class="text-green-700 font-semibold">✅ ${sent.length} rappel${sent.length > 1 ? 's' : ''} envoyé${sent.length > 1 ? 's' : ''}</p>` : ''}
        ${failed.length > 0 ? `<p class="text-red-600 font-semibold">❌ ${failed.length} échec : ${failed.join(', ')}</p>` : ''}
        ${sent.length > 0 ? '<p class="text-gray-400 text-xs mt-1">Prochain rappel dans 3 jours si non récupéré.</p>' : ''}
      </div>
    `;
    label.textContent = 'Terminé';
    loadReminders();
  } catch {
    remindResult.innerHTML = '<p class="text-red-600">Erreur lors de l\'envoi.</p>';
    remindResult.classList.remove('hidden');
  } finally {
    btn.disabled = false;
    spinner.classList.add('hidden');
    label.classList.remove('hidden');
  }
});
</script>
