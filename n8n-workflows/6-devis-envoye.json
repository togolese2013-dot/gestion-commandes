      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [480, 0]
    },
    {
      "parameters": {
        "jsCode": "// Skip this iteration if already sent successfully\nconst sd = $getWorkflowStaticData('global');\nif (sd.whatsapp_sent) {\n  return []; // stops this iteration\n}\nconst item = $input.first().json;\nif (!item.phone_valid) {\n  console.error('[devis-envoye] Numéro invalide:', item.client_phone);\n  return [];\n}\nreturn [$input.first()];"
      },
