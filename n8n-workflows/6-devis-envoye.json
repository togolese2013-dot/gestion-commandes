      "parameters": {
        "jsCode": "const d = $input.first().json.body ?? $input.first().json;\n\n// Reset static data for this execution\nconst sd = $getWorkflowStaticData('global');\nsd.whatsapp_sent = false;\n\n// Strip ALL non-digit characters\nconst phone = String(d.client_phone ?? '').replace(/\\D/g, '');\n\n// Create 3 items = 3 max attempts for the loop\nconst item = {\n  client_name: String(d.client_name ?? '').trim(),\n  client_phone: phone,\n  devis_number: String(d.devis_number ?? '').trim(),\n  share_url: String(d.share_url ?? '').trim(),\n  phone_valid: phone.length >= 8\n};\n\nreturn [{ json: { ...item, attempt: 1 } }, { json: { ...item, attempt: 2 } }, { json: { ...item, attempt: 3 } }];"
      },
      "id": "e869f13d-32db-4653-b026-55d7a6567c93",
