---
import { requireAuth, getCurrentUser } from '../../../../lib/auth';
import { getOrderById, getPaymentsByOrderId } from '../../../../lib/orders';

const redirect = requireAuth(Astro);
if (redirect) return redirect;

const { id } = Astro.params;
const order = id ? getOrderById(parseInt(id)) : null;
const payments = order?.id ? getPaymentsByOrderId(order.id) : [];
const currentUser = getCurrentUser(Astro.request);

if (!order) {
  return new Response('Commande introuvable', { status: 404 });
}

const fmt = (n: number) => n.toLocaleString('fr-FR', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
const dateStr = (d: string) => new Date(d).toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });

const paymentMethodLabels: Record<string, string> = {
  especes: 'Espèces',
  mix_by_yas: 'Mix by Yas',
  moov_money: 'Moov Money',
  virement_bancaire: 'Virement bancaire',
  virement: 'Virement bancaire',
};

const totalPaid = payments.reduce((sum, p) => sum + p.amount, 0) + (order.deposit || 0);
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Bon de commande — {order.order_number}</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      font-size: 13px;
      color: #111;
      background: #f0f0f0;
    }

    .page {
      width: 210mm;
      min-height: 297mm;
      margin: 20px auto;
      background: #fff;
      padding: 14mm 14mm 12mm;
      box-shadow: 0 2px 20px rgba(0,0,0,0.12);
      position: relative;
    }

    /* ── Header ── */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding-bottom: 12px;
      border-bottom: 3px solid #065f46;
      margin-bottom: 18px;
    }
    .logo-block { display: flex; align-items: center; gap: 10px; }
    .logo-icon {
      width: 44px; height: 44px;
      background: #065f46;
      border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 20px; font-weight: 900;
    }
    .logo-text { font-size: 22px; font-weight: 800; color: #065f46; letter-spacing: -0.5px; }
    .logo-sub { font-size: 10px; color: #6b7280; margin-top: 1px; }

    .doc-info { text-align: right; }
    .doc-title {
      font-size: 18px; font-weight: 800;
      color: #065f46; text-transform: uppercase; letter-spacing: 1px;
    }
    .doc-num { font-size: 13px; font-weight: 700; color: #111; margin-top: 3px; }
    .doc-date { font-size: 11px; color: #6b7280; margin-top: 2px; }

    /* ── Status badge ── */
    .status-row { display: flex; justify-content: flex-end; margin-bottom: 16px; }
    .status-badge {
      padding: 4px 14px; border-radius: 20px;
      font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;
    }
    .status-en_attente { background: #fef3c7; color: #92400e; border: 1px solid #fbbf24; }
    .status-disponible  { background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }
    .status-recupere    { background: #f3f4f6; color: #374151; border: 1px solid #d1d5db; }

    /* ── Info grid ── */
    .info-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 10px; margin-bottom: 18px;
    }
    .info-card {
      border: 1px solid #e5e7eb; border-radius: 8px;
      padding: 10px 12px;
    }
    .info-card-title {
      font-size: 9px; font-weight: 700; color: #9ca3af;
      text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 6px;
    }
    .info-row { display: flex; justify-content: space-between; margin-bottom: 3px; }
    .info-label { color: #6b7280; font-size: 11px; }
    .info-value { font-weight: 600; font-size: 11px; color: #111; }

    /* ── Products table ── */
    .section-title {
      font-size: 10px; font-weight: 700; color: #6b7280;
      text-transform: uppercase; letter-spacing: 0.8px;
      margin-bottom: 8px;
    }
    table {
      width: 100%; border-collapse: collapse; margin-bottom: 16px;
    }
    thead tr { background: #065f46; }
    thead th {
      padding: 8px 10px; text-align: left;
      font-size: 10px; font-weight: 700;
      color: #fff; text-transform: uppercase; letter-spacing: 0.5px;
    }
    thead th:last-child { text-align: right; }
    tbody tr { border-bottom: 1px solid #f3f4f6; }
    tbody tr:nth-child(even) { background: #f9fafb; }
    tbody td { padding: 8px 10px; font-size: 12px; }
    tbody td:last-child { text-align: right; font-weight: 600; }
    .product-name { font-weight: 600; color: #111; }
    .product-cond {
      display: inline-block; font-size: 10px; font-weight: 600;
      padding: 1px 7px; border-radius: 10px; margin-left: 5px;
      background: #d1fae5; color: #065f46;
    }
    .product-cond.occasion { background: #fef3c7; color: #92400e; }

    /* ── Totaux ── */
    .totals-section {
      display: flex; justify-content: flex-end; margin-bottom: 18px;
    }
    .totals-box { width: 240px; }
    .totals-row {
      display: flex; justify-content: space-between;
      padding: 5px 0; font-size: 12px; border-bottom: 1px solid #f3f4f6;
    }
    .totals-row.total-final {
      font-size: 14px; font-weight: 800; color: #065f46;
      border-bottom: none; padding-top: 8px;
    }
    .totals-row.reste {
      font-size: 13px; font-weight: 700;
      color: #dc2626; border-bottom: none;
    }
    .totals-row.reste.solde { color: #065f46; }

    /* ── Paiements ── */
    .payments-section { margin-bottom: 18px; }
    .payment-row {
      display: flex; justify-content: space-between; align-items: center;
      padding: 6px 10px; background: #f9fafb;
      border-radius: 6px; margin-bottom: 4px; font-size: 11px;
    }
    .payment-amount { font-weight: 700; color: #065f46; }

    /* ── Notes ── */
    .notes-box {
      background: #f0fdf4; border: 1px solid #bbf7d0;
      border-radius: 8px; padding: 10px 12px; margin-bottom: 18px;
    }
    .notes-box p { font-size: 12px; color: #065f46; }

    /* ── Footer ── */
    .footer {
      position: absolute; bottom: 12mm; left: 14mm; right: 14mm;
      border-top: 1px solid #e5e7eb; padding-top: 8px;
      display: flex; justify-content: space-between; align-items: center;
    }
    .footer-text { font-size: 10px; color: #9ca3af; }
    .footer-brand { font-size: 10px; font-weight: 700; color: #065f46; }

    /* ── Signature ── */
    .signature-grid {
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 20px; margin-bottom: 60px; margin-top: 10px;
    }
    .signature-box {
      border-top: 1px solid #d1d5db; padding-top: 6px;
    }
    .signature-label { font-size: 10px; color: #6b7280; }

    /* ── Print ── */
    .no-print { }
    .print-btn {
      position: fixed; bottom: 20px; right: 20px;
      background: #065f46; color: #fff;
      border: none; border-radius: 12px;
      padding: 12px 24px; font-size: 14px; font-weight: 700;
      cursor: pointer; display: flex; align-items: center; gap-8px;
      box-shadow: 0 4px 12px rgba(6,95,70,0.4);
      z-index: 100;
    }
    .print-btn:hover { background: #047857; }
    .back-btn {
      position: fixed; bottom: 20px; left: 20px;
      background: #fff; color: #374151;
      border: 1px solid #d1d5db; border-radius: 12px;
      padding: 12px 24px; font-size: 14px; font-weight: 600;
      cursor: pointer; box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      z-index: 100; text-decoration: none;
    }

    @media print {
      body { background: #fff; }
      .page { margin: 0; box-shadow: none; padding: 10mm 12mm 20mm; }
      .no-print { display: none !important; }
      @page { size: A4; margin: 0; }
    }
  </style>
</head>
<body>

  <!-- Boutons action -->
  <div class="no-print">
    <a href="/admin/orders" class="back-btn">← Retour</a>
    <button class="print-btn" onclick="window.print()">🖨️ Imprimer</button>
  </div>

  <div class="page">

    <!-- Header -->
    <div class="header">
      <div class="logo-block">
        <div class="logo-icon">T</div>
        <div>
          <div class="logo-text">Togolese.</div>
          <div class="logo-sub">togolese.fr · Import depuis l'étranger</div>
        </div>
      </div>
      <div class="doc-info">
        <div class="doc-title">Bon de commande</div>
        <div class="doc-num">{order.order_number}</div>
        <div class="doc-date">Émis le {order.created_at ? dateStr(order.created_at) : '—'}</div>
      </div>
    </div>

    <!-- Status -->
    <div class="status-row">
      <span class={`status-badge status-${order.status ?? 'en_attente'}`}>
        {order.status === 'en_attente' ? '⏳ En préparation'
         : order.status === 'disponible' ? '✅ Prête à récupérer'
         : '📦 Récupérée'}
      </span>
    </div>

    <!-- Infos client + livraison -->
    <div class="info-grid">
      <div class="info-card">
        <div class="info-card-title">Client</div>
        <div class="info-row">
          <span class="info-label">Nom</span>
          <span class="info-value">{order.client_name}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Téléphone</span>
          <span class="info-value">{order.client_phone}</span>
        </div>
      </div>
      <div class="info-card">
        <div class="info-card-title">Livraison</div>
        <div class="info-row">
          <span class="info-label">Mode</span>
          <span class="info-value">{order.delivery_type === 'avion' ? '✈️ Express (avion)' : '🚢 Économique (bateau)'}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Délai estimé</span>
          <span class="info-value">{order.delivery_type === 'avion' ? '4 – 14 jours' : '30 – 45 jours'}</span>
        </div>
        {order.created_by && (
          <div class="info-row">
            <span class="info-label">Créé par</span>
            <span class="info-value">{order.created_by}</span>
          </div>
        )}
      </div>
    </div>

    <!-- Produits -->
    <div class="section-title">Produits commandés</div>
    <table>
      <thead>
        <tr>
          <th style="width:50%">Désignation</th>
          <th style="width:15%">État</th>
          <th style="width:10%; text-align:center">Qté</th>
          <th style="width:15%; text-align:right">Prix unit.</th>
          <th style="width:15%; text-align:right">Sous-total</th>
        </tr>
      </thead>
      <tbody>
        {(order.products ?? []).map(p => (
          <tr>
            <td><span class="product-name">{p.name}</span></td>
            <td>
              <span class={`product-cond${p.condition === 'Occasion' ? ' occasion' : ''}`}>
                {p.condition || 'Neuf'}
              </span>
            </td>
            <td style="text-align:center">{p.quantity}</td>
            <td style="text-align:right">{fmt(p.price)} FCFA</td>
            <td>{fmt(p.price * p.quantity)} FCFA</td>
          </tr>
        ))}
      </tbody>
    </table>

    <!-- Totaux -->
    <div class="totals-section">
      <div class="totals-box">
        <div class="totals-row total-final">
          <span>Total commande</span>
          <span>{fmt(order.total_amount)} FCFA</span>
        </div>
        <div class="totals-row">
          <span style="color:#6b7280">Acompte versé</span>
          <span style="color:#065f46;font-weight:700">− {fmt(order.deposit)} FCFA</span>
        </div>
        {payments.length > 0 && payments.map((p, i) => (
          <div class="totals-row">
            <span style="color:#6b7280">Paiement #{i + 1}</span>
            <span style="color:#065f46;font-weight:700">− {fmt(p.amount)} FCFA</span>
          </div>
        ))}
        <div class={`totals-row reste${order.remaining_balance <= 0 ? ' solde' : ''}`}>
          <span>Reste à payer</span>
          <span>{fmt(order.remaining_balance)} FCFA</span>
        </div>
      </div>
    </div>

    <!-- Historique paiements -->
    {(payments.length > 0 || order.deposit > 0) && (
      <div class="payments-section">
        <div class="section-title">Historique des paiements</div>
        {order.deposit > 0 && (
          <div class="payment-row">
            <span>Acompte initial ({order.deposit_payment_method ? paymentMethodLabels[order.deposit_payment_method] ?? order.deposit_payment_method : '—'})</span>
            <span class="payment-amount">+{fmt(order.deposit)} FCFA</span>
          </div>
        )}
        {payments.map((p, i) => (
          <div class="payment-row">
            <span>
              Paiement #{i + 1}
              {p.created_at && <span style="color:#9ca3af"> · {dateStr(p.created_at)}</span>}
              {p.payment_method && <span style="color:#9ca3af"> · {paymentMethodLabels[p.payment_method] ?? p.payment_method}</span>}
            </span>
            <span class="payment-amount">+{fmt(p.amount)} FCFA</span>
          </div>
        ))}
      </div>
    )}

    <!-- Notes -->
    {order.notes && (
      <div class="notes-box">
        <div class="section-title" style="margin-bottom:4px">Notes</div>
        <p>{order.notes}</p>
      </div>
    )}

    <!-- Signatures -->
    <div class="signature-grid">
      <div class="signature-box">
        <div class="signature-label">Signature du client</div>
      </div>
      <div class="signature-box">
        <div class="signature-label">Signature Togolese</div>
      </div>
    </div>

    <!-- Footer -->
    <div class="footer">
      <div class="footer-text">togolese.fr · Import depuis l'étranger · Service client : +228 90 22 64 91</div>
      <div class="footer-brand">Togolese.</div>
    </div>

  </div>

</body>
</html>
