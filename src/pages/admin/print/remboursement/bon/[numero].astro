---
import { requireAuth } from '../../../../../lib/auth';
import { getOrderByNumber, getPaymentsByOrderId } from '../../../../../lib/orders';

const redirect = requireAuth(Astro);
if (redirect) return redirect;

const { numero } = Astro.params;
const order = numero ? getOrderByNumber(numero) : null;
const payments = order?.id ? getPaymentsByOrderId(order.id) : [];

const fmt = (n: number) => n.toLocaleString('fr-FR');
const dateStr = (d: string) =>
  new Date(d).toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });

const today = dateStr(new Date().toISOString());
const todayISO = new Date().toISOString().split('T')[0];

const refBon = order ? `BDR-${order.order_number}` : '—';

const totalPaid = payments.reduce((sum, p) => sum + p.amount, order?.deposit ?? 0);
const montantARembourser = order ? Math.min(totalPaid, order.total_amount) : 0;

const motif = (order as any)?.cancellation_reason ?? order?.notes ?? 'Colis non livré';
const livraisonLabel = order?.delivery_type === 'avion' ? 'Express (Avion)' : 'Économique (Bateau)';
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bon de Remboursement — {order?.order_number ?? 'introuvable'}</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;
      font-size: 13px; color: #111; background: #f3f4f6;
    }

    .no-print {
      position: sticky; top: 0; z-index: 100;
      background: #1e40af; padding: 10px 24px;
      display: flex; align-items: center; gap: 16px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.15); flex-wrap: wrap;
    }
    .no-print button {
      background: #fff; color: #1e40af; border: none; border-radius: 6px;
      padding: 8px 18px; font-size: 14px; font-weight: 700; cursor: pointer;
      display: flex; align-items: center; gap: 6px; font-family: inherit;
    }
    .no-print button:hover { background: #e0e7ff; }
    .no-print a { color: #bfdbfe; text-decoration: none; font-size: 13px; font-weight: 600; }
    .no-print a:hover { color: #fff; }
    .no-print .spacer { flex: 1; }
    .no-print .hint { color: #93c5fd; font-size: 12px; }
    .date-field {
      display: flex; align-items: center; gap: 8px;
      background: rgba(255,255,255,0.15); border-radius: 6px; padding: 6px 12px;
    }
    .date-field label { color: #bfdbfe; font-size: 12px; font-weight: 600; white-space: nowrap; }
    .date-field input[type="date"] {
      background: #fff; color: #1e40af; border: none; border-radius: 4px;
      padding: 4px 8px; font-size: 13px; font-weight: 600; font-family: inherit; cursor: pointer;
    }

    .page-wrapper {
      display: flex; flex-direction: column; align-items: center;
      padding: 24px 16px 48px;
    }
    .page {
      background: #fff; width: 210mm; min-height: 297mm;
      padding: 15mm 18mm 14mm;
      box-shadow: 0 4px 24px rgba(0,0,0,0.10);
      border-radius: 4px; display: flex; flex-direction: column;
    }

    .doc-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px; }
    .logo-t {
      width: 48px; height: 48px; background: #1e40af; border-radius: 10px;
      display: flex; align-items: center; justify-content: center;
      color: #fff; font-size: 24px; font-weight: 900; flex-shrink: 0;
    }
    .contact-block { text-align: right; font-size: 11px; color: #111; line-height: 1.75; }
    .contact-block strong { color: #1e40af; }
    .divider { height: 3px; background: linear-gradient(90deg,#1e40af 0%,#3b82f6 60%,#bfdbfe 100%); border-radius: 2px; margin: 8px 0 16px; }

    .doc-title-row { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 18px; }
    .doc-badge {
      display: inline-flex; align-items: center;
      background: #1e40af; color: #fff;
      font-size: 13px; font-weight: 800; letter-spacing: 1.5px;
      padding: 8px 18px; border-radius: 6px; text-transform: uppercase;
    }
    .doc-ref {
      font-family: 'Courier New', Courier, monospace;
      font-size: 13px; font-weight: 700; color: #1e40af;
      background: #eff6ff; border: 1.5px solid #bfdbfe;
      padding: 4px 12px; border-radius: 5px; letter-spacing: 0.5px; margin-top: 7px;
    }
    .doc-meta { text-align: right; font-size: 11.5px; color: #111; line-height: 1.7; }
    .doc-meta strong { display: block; font-size: 13px; }
    .badge-green { display: inline-block; padding: 2px 10px; border-radius: 20px; font-size: 10px; font-weight: 700; background: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0; }
    .badge-orange { display: inline-block; padding: 2px 10px; border-radius: 20px; font-size: 10px; font-weight: 700; background: #fff7ed; color: #c2410c; border: 1px solid #fed7aa; }

    .amount-hero {
      background: linear-gradient(135deg, #1e40af 0%, #2563eb 100%);
      border-radius: 10px; padding: 22px 26px; color: #fff;
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 18px;
    }
    .amount-hero-label { font-size: 10px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; opacity: 0.8; margin-bottom: 5px; }
    .amount-hero-value { font-size: 34px; font-weight: 900; letter-spacing: -1px; line-height: 1; }
    .amount-hero-sub { font-size: 10.5px; opacity: 0.7; margin-top: 5px; }
    .ref-block { text-align: center; background: rgba(255,255,255,0.15); border-radius: 8px; padding: 12px 16px; }
    .ref-block-label { font-size: 9px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; opacity: 0.75; margin-bottom: 5px; }
    .ref-block-value { font-family: 'Courier New', Courier, monospace; font-size: 14px; font-weight: 700; letter-spacing: 1px; }
    .ref-block-hint { font-size: 9px; opacity: 0.6; margin-top: 4px; }

    .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 18px; }
    .info-box { border: 1px solid #111; border-radius: 6px; overflow: hidden; }
    .info-box-hd {
      background: #f8fafc; border-bottom: 1px solid #111;
      padding: 6px 14px; font-size: 9.5px; font-weight: 800;
      text-transform: uppercase; letter-spacing: 1.2px; color: #111;
    }
    .info-box-body { padding: 11px 14px; line-height: 1.85; }
    .lbl { font-size: 9.5px; color: #555; font-weight: 600; text-transform: uppercase; }
    .val { font-size: 13px; color: #111; font-weight: 600; }
    .val-big { font-size: 15px; font-weight: 700; color: #1e40af; text-transform: uppercase; }

    .sec-title {
      font-size: 10px; font-weight: 800; text-transform: uppercase;
      letter-spacing: 1.2px; color: #111;
      padding-bottom: 5px; border-bottom: 1px solid #111; margin-bottom: 10px;
    }

    .data-table { width: 100%; border-collapse: collapse; margin-bottom: 16px; font-size: 12.5px; }
    .data-table thead tr { background: #1e40af; color: #fff; }
    .data-table thead th { padding: 8px 12px; text-align: left; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; }
    .data-table thead th:last-child { text-align: right; }
    .data-table tbody tr:nth-child(even) { background: #f8fafc; }
    .data-table tbody td { padding: 8px 12px; border-bottom: 1px solid #e5e7eb; color: #111; }
    .data-table tbody td:last-child { text-align: right; font-weight: 600; }
    .data-table tfoot td { padding: 9px 12px; font-weight: 700; color: #1e40af; background: #eff6ff; border-top: 2px solid #bfdbfe; font-size: 14px; }
    .data-table tfoot td:last-child { text-align: right; font-size: 16px; }

    .engagement-box {
      background: #eff6ff; border: 1.5px solid #bfdbfe;
      border-radius: 8px; padding: 14px 18px; margin-bottom: 16px;
    }
    .engagement-box p { font-size: 12.5px; color: #111; line-height: 1.8; }

    .quittance-box {
      background: #f0fdf4; border: 1.5px solid #bbf7d0;
      border-radius: 8px; padding: 14px 18px; margin-bottom: 16px;
    }
    .quittance-box p { font-size: 12.5px; color: #111; line-height: 1.8; }

    .error-page {
      display: flex; flex-direction: column; align-items: center;
      justify-content: center; min-height: 300px; gap: 12px; color: #6b7280;
    }
    .error-page h2 { font-size: 20px; color: #374151; font-weight: 700; }

    .sig-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: auto; padding-top: 20px; }
    .sig-box { border: 1.5px dashed #aaa; border-radius: 6px; padding: 14px 18px; min-height: 120px; display: flex; flex-direction: column; }
    .sig-title { font-size: 9.5px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.2px; color: #111; margin-bottom: 5px; }
    .sig-name { font-size: 12px; color: #111; font-weight: 600; }
    .sig-role { font-size: 10px; color: #6b7280; margin-bottom: auto; }
    .sig-line { border-bottom: 1px solid #111; margin-top: auto; margin-bottom: 6px; }
    .sig-hint { font-size: 9.5px; color: #6b7280; font-style: italic; }

    .doc-footer {
      margin-top: 20px; padding-top: 10px; border-top: 1px solid #111;
      text-align: center; font-size: 10px; color: #111; line-height: 1.7;
    }
    .doc-footer strong { font-size: 11.5px; display: block; margin-bottom: 2px; }

    @media print {
      * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
      .no-print { display: none !important; }
      body { background: #fff !important; }
      .page-wrapper { padding: 0 !important; }
      .page { width: 100% !important; min-height: auto !important; box-shadow: none !important; border-radius: 0 !important; padding: 15mm 18mm 14mm !important; }
      @page { size: A4; margin: 0; }
    }
  </style>
</head>
<body>

  <div class="no-print">
    <button onclick="window.print()">
      <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
      </svg>
      Imprimer / PDF
    </button>
    <a href="/admin/orders">← Retour aux commandes</a>
    <div class="date-field">
      <label for="payment-date-input">Date du versement :</label>
      <input type="date" id="payment-date-input" value={todayISO} />
    </div>
    <span class="spacer"></span>
    {order && <span class="hint">Bon · {refBon}</span>}
  </div>

  <div class="page-wrapper">
    <div class="page">

      {!order ? (
        <div class="error-page">
          <svg width="48" height="48" fill="none" stroke="#d1d5db" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
          <h2>Commande introuvable</h2>
          <p>Le numéro <strong>{numero}</strong> n'existe pas.</p>
          <a href="/admin/orders" style="margin-top:8px; color:#1e40af; font-weight:600;">← Retour aux commandes</a>
        </div>
      ) : (
        <>
          <div class="doc-header">
            <div style="display:flex; align-items:center; gap:12px;">
              <div class="logo-t">T</div>
              <div>
                <div style="font-size:24px; font-weight:900; color:#111; letter-spacing:-0.5px; line-height:1;">Togolese.</div>
                <div style="font-size:10px; color:#6b7280; margin-top:3px;">togolese.fr · Import depuis l'étranger</div>
              </div>
            </div>
            <div class="contact-block">
              <div>Kégué derrière l'hôtel O'Balkan, Lomé - TOGO</div>
              <div><strong>Tél :</strong> +228 90 22 64 91</div>
              <div><strong>Email :</strong> contact@togolese.fr</div>
            </div>
          </div>
          <div class="divider"></div>

          <div class="doc-title-row">
            <div>
              <span class="doc-badge">Bon de Remboursement</span>
              <div class="doc-ref">{refBon}</div>
              <div style="font-size:10px; color:#6b7280; margin-top:4px;">Réf. commande : {order.order_number}</div>
            </div>
            <div class="doc-meta">
              <span style="font-size:10px; color:#555; text-transform:uppercase; letter-spacing:0.8px;">Émis le</span>
              <strong>{today}</strong>
              <div style="margin-top:7px;"><span class="badge-green">● Remboursement confirmé</span></div>
            </div>
          </div>

          <div class="amount-hero">
            <div>
              <div class="amount-hero-label">Montant remboursé</div>
              <div class="amount-hero-value">{fmt(montantARembourser)} FCFA</div>
              <div class="amount-hero-sub">Acompte versé · Commande {order.order_number}</div>
            </div>
            <div class="ref-block">
              <div class="ref-block-label">Référence</div>
              <div class="ref-block-value">{refBon}</div>
              <div class="ref-block-hint">À conserver</div>
            </div>
          </div>

          <div class="info-grid">
            <div class="info-box">
              <div class="info-box-hd">Bénéficiaire du remboursement</div>
              <div class="info-box-body">
                <div class="lbl">Nom</div>
                <div class="val-big">{order.client_name}</div>
                <div style="margin-top:9px;">
                  <div class="lbl">Téléphone</div>
                  <div class="val">{order.client_phone}</div>
                </div>
              </div>
            </div>
            <div class="info-box">
              <div class="info-box-hd">Commande annulée</div>
              <div class="info-box-body">
                <div class="lbl">Numéro</div>
                <div class="val" style="font-family:'Courier New',monospace; color:#1e40af; font-size:12.5px;">{order.order_number}</div>
                <div style="margin-top:8px;">
                  <div class="lbl">Mode de livraison</div>
                  <div class="val">{livraisonLabel}</div>
                </div>
                <div style="margin-top:8px;">
                  <div class="lbl">Motif du remboursement</div>
                  <div style="margin-top:2px;"><span class="badge-orange">{motif}</span></div>
                </div>
              </div>
            </div>
          </div>

          <div class="sec-title">Détail du remboursement</div>
          <table class="data-table">
            <thead>
              <tr>
                <th>Description</th>
                <th style="text-align:right;">Montant</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Acompte versé à la commande</td>
                <td>{fmt(order.deposit)} FCFA</td>
              </tr>
              {payments.filter(p => p.amount > 0).map((p) => (
                <tr>
                  <td>Versement complémentaire ({p.payment_method ?? '—'})</td>
                  <td>{fmt(p.amount)} FCFA</td>
                </tr>
              ))}
              <tr>
                <td>Frais de dossier retenus</td>
                <td style="color:#dc2626;">0 FCFA</td>
              </tr>
            </tbody>
            <tfoot>
              <tr>
                <td>Total remboursé</td>
                <td>{fmt(montantARembourser)} FCFA</td>
              </tr>
            </tfoot>
          </table>

          <div class="sec-title">Engagement de TOGOLESE</div>
          <div class="engagement-box">
            <p>
              TOGOLESE s'engage à verser la somme de <strong style="color:#1e40af;">{fmt(montantARembourser)} FCFA</strong> à <strong>{order.client_name}</strong>
              le <strong style="color:#1e40af;" id="payment-date-display">—</strong>.
              Ce bon de remboursement constitue la preuve écrite de cet engagement et vaut quittance une fois signé des deux parties.
            </p>
            <p style="margin-top:10px;">Mode de remboursement convenu : <strong style="color:#111;">_________________________________________________</strong></p>
          </div>

          <div class="sec-title">Accusé de réception du remboursement</div>
          <div class="quittance-box">
            <p>
              Je soussigné(e) <strong>{order.client_name}</strong> reconnais avoir reçu la somme de <strong style="color:#16a34a;">{fmt(montantARembourser)} FCFA</strong>
              à titre de remboursement intégral de mon acompte versé pour la commande <strong style="font-family:'Courier New',monospace;">{order.order_number}</strong>.
              Ce paiement solde toute dette de TOGOLESE à mon égard pour cette commande, et je renonce à tout recours ultérieur relatif à celle-ci.
            </p>
          </div>

          <div class="sig-grid">
            <div class="sig-box">
              <div class="sig-title">Signature du bénéficiaire</div>
              <div class="sig-name">{order.client_name}</div>
              <div class="sig-role">Signature précédée de « Lu et approuvé »</div>
              <div class="sig-line"></div>
              <div class="sig-hint">Date de réception : <span id="sig-date-display">____________________</span></div>
            </div>
            <div class="sig-box">
              <div class="sig-title">Visa TOGOLESE</div>
              <div class="sig-name">Kent · Gérant</div>
              <div class="sig-role">Cachet officiel + Signature</div>
              <div class="sig-line"></div>
              <div class="sig-hint">Date d'émission : {today}</div>
            </div>
          </div>

          <div class="doc-footer">
            <strong>TOGOLESE — Bon de Remboursement {refBon}</strong>
            Document valable uniquement avec les 2 signatures · togolese.fr · contact@togolese.fr · +228 90 22 64 91
          </div>
        </>
      )}

    </div>
  </div>

  <script>
    const input = document.getElementById('payment-date-input') as HTMLInputElement;
    const display = document.getElementById('payment-date-display');
    const sigDate = document.getElementById('sig-date-display');

    function updateDate() {
      if (!input) return;
      const val = input.value;
      if (!val) {
        if (display) display.textContent = '—';
        if (sigDate) sigDate.textContent = '____________________';
        return;
      }
      const d = new Date(val + 'T12:00:00');
      const formatted = d.toLocaleDateString('fr-FR', { day: '2-digit', month: 'long', year: 'numeric' });
      if (display) display.textContent = formatted;
      if (sigDate) sigDate.textContent = formatted;
    }

    input?.addEventListener('change', updateDate);
    updateDate();
  </script>

</body>
</html>
