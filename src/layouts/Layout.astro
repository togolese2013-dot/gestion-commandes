---
import '../styles/global.css';
import { getCurrentUser } from '../lib/auth';

interface Props {
  title: string;
  isAdmin?: boolean;
}

const { title, isAdmin = false } = Astro.props;
const currentUser = isAdmin ? getCurrentUser(Astro.request) : null;
const isAdminRole = currentUser?.role === 'admin';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#2563eb" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="TOGOLESE" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />

    <title>{title} — TOGOLESE</title>
    <script is:inline>
      if (localStorage.getItem('theme') === 'dark') document.documentElement.classList.add('dark');
      if (history.scrollRestoration) history.scrollRestoration = 'manual';
    </script>
  </head>
  <body class="bg-gray-50 min-h-screen text-gray-900">

    {isAdmin && (
      <header style="background:#047857;position:sticky;top:0;z-index:100;box-shadow:0 2px 20px rgba(0,0,0,0.18);">

        <!-- Barre principale -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6">
          <div class="flex justify-between sm:grid h-16 items-center" style="grid-template-columns:1fr auto 1fr;">

            <!-- Logo — gauche -->
            <a href="/admin/dashboard" class="font-black text-xl shrink-0 text-white justify-self-start" style="letter-spacing:-0.04em;">Togolese.</a>

            <!-- Nav centrale — desktop uniquement -->
            <nav class="hidden sm:flex items-center gap-0.5 text-sm font-medium justify-center">
              <a href="/admin/dashboard" class="nav-link py-1.5 px-3 rounded-lg transition-colors whitespace-nowrap" style="color:rgba(255,255,255,0.8);">Dashboard</a>
              <a href="/admin/orders" class="nav-link py-1.5 px-3 rounded-lg transition-colors whitespace-nowrap flex items-center gap-1.5" style="color:rgba(255,255,255,0.8);">
                Commandes
                <span id="pending-badge" class="hidden items-center justify-center min-w-[18px] h-[18px] px-1 bg-red-400 text-white text-[10px] font-bold rounded-full leading-none"></span>
              </a>
              <a href="/admin/inquiries" class="nav-link py-1.5 px-3 rounded-lg transition-colors whitespace-nowrap flex items-center gap-1.5" style="color:rgba(255,255,255,0.8);">
                Demandes
                <span id="inquiry-badge" class="hidden items-center justify-center min-w-[18px] h-[18px] px-1 bg-amber-400 text-white text-[10px] font-bold rounded-full leading-none"></span>
              </a>
              <a href="/admin/clients" class="nav-link py-1.5 px-3 rounded-lg transition-colors whitespace-nowrap" style="color:rgba(255,255,255,0.8);">Clients</a>
              {isAdminRole && (
                <a href="/admin/payments" class="nav-link py-1.5 px-3 rounded-lg transition-colors whitespace-nowrap" style="color:rgba(255,255,255,0.8);">Paiements</a>
              )}
              {isAdminRole && (
                <a href="/admin/settings" class="nav-link py-1.5 px-3 rounded-lg transition-colors whitespace-nowrap" style="color:rgba(255,255,255,0.8);">Paramètres</a>
              )}
            </nav>

            <!-- Droite : user + hamburger -->
            <div class="flex items-center gap-2 justify-self-end">

              <!-- Recherche masquée (conservée pour les raccourcis clavier) -->
              <div class="hidden">
                <input id="global-search" type="text" autocomplete="off" />
                <div id="global-results"></div>
              </div>

              <!-- Menu utilisateur — desktop -->
              {currentUser && (
                <div class="relative hidden sm:block" id="user-menu-wrapper">
                  <button id="profile-btn"
                    class="flex items-center gap-2 px-2.5 py-1.5 rounded-xl transition-colors cursor-pointer"
                    style="background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.18);"
                    data-id={currentUser.id}
                    data-name={currentUser.full_name}
                  >
                    <!-- Avatar initiales -->
                    <div class="w-6 h-6 rounded-full flex items-center justify-center text-[10px] font-black shrink-0"
                      style="background:rgba(255,255,255,0.25);color:white;">
                      {currentUser.full_name.split(' ').map((w: string) => w[0]).join('').slice(0,2).toUpperCase()}
                    </div>
                    <span class="text-xs font-semibold hidden md:block" style="color:white;">{currentUser.full_name}</span>
                    <svg class="w-3 h-3 shrink-0" style="color:rgba(255,255,255,0.6);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
                    </svg>
                  </button>

                  <!-- Dropdown -->
                  <div id="user-dropdown" class="hidden absolute right-0 top-full mt-2 w-52 bg-white rounded-2xl shadow-2xl overflow-hidden" style="z-index:300;border:1px solid #e5e7eb;">
                    <!-- Header -->
                    <div class="px-4 py-3" style="background:#f9fafb;border-bottom:1px solid #f3f4f6;">
                      <p class="text-[10px] font-semibold uppercase tracking-wider" style="color:#9ca3af;">Connecté en tant que</p>
                      <p class="text-sm font-bold mt-0.5" style="color:#111827;">{currentUser.full_name}</p>
                    </div>
                    <!-- Mon profil -->
                    <button id="profile-edit-btn" class="w-full text-left flex items-center gap-3 px-4 py-3 text-sm font-medium transition-colors hover:bg-gray-50" style="color:#374151;border:none;background:transparent;cursor:pointer;">
                      <svg class="w-4 h-4 shrink-0" style="color:#6b7280;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                      </svg>
                      Mon profil
                    </button>
                    <!-- Déconnexion -->
                    <form action="/api/auth/logout" method="POST" style="border-top:1px solid #f3f4f6;">
                      <button type="submit" class="w-full text-left flex items-center gap-3 px-4 py-3 text-sm font-medium transition-colors hover:bg-red-50" style="color:#dc2626;border:none;background:transparent;cursor:pointer;">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                        </svg>
                        Déconnexion
                      </button>
                    </form>
                  </div>
                </div>
              )}

              <!-- Hamburger — mobile uniquement -->
              <button id="mob-menu-btn" class="sm:hidden flex flex-col justify-center items-center w-9 h-9 rounded-lg gap-1.5" style="color:white;background:transparent;border:none;cursor:pointer;">
                <span class="block w-5 h-0.5 rounded bg-white transition-all" id="ham-1"></span>
                <span class="block w-5 h-0.5 rounded bg-white transition-all" id="ham-2"></span>
                <span class="block w-5 h-0.5 rounded bg-white transition-all" id="ham-3"></span>
              </button>

            </div>
          </div>
        </div>

        <!-- Menu mobile déroulant -->
        <div id="mob-menu" class="sm:hidden hidden" style="background:#047857;border-top:1px solid rgba(255,255,255,0.15);">
          <nav class="max-w-7xl mx-auto px-4 py-3 flex flex-col gap-1">
            <a href="/admin/dashboard" class="nav-link mob-nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium" style="color:rgba(255,255,255,0.9);">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
              Dashboard
            </a>
            <a href="/admin/orders" class="nav-link mob-nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium" style="color:rgba(255,255,255,0.9);">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
              Commandes
              <span id="mob-pending-badge" class="hidden items-center justify-center min-w-[18px] h-[18px] px-1 bg-red-400 text-white text-[10px] font-bold rounded-full leading-none ml-auto"></span>
            </a>
            <a href="/admin/inquiries" class="nav-link mob-nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium" style="color:rgba(255,255,255,0.9);">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
              Demandes
              <span id="mob-inquiry-badge" class="hidden items-center justify-center min-w-[18px] h-[18px] px-1 bg-amber-400 text-white text-[10px] font-bold rounded-full leading-none ml-auto"></span>
            </a>
            <a href="/admin/analytics" class="nav-link mob-nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium" style="color:rgba(255,255,255,0.9);">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
              Stats
            </a>
            <a href="/admin/clients" class="nav-link mob-nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium" style="color:rgba(255,255,255,0.9);">
              <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              Clients
            </a>
            {isAdminRole && (
              <a href="/admin/payments" class="nav-link mob-nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium" style="color:rgba(255,255,255,0.9);">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
                Paiements
              </a>
            )}
            {isAdminRole && (
              <a href="/admin/settings" class="nav-link mob-nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium" style="color:rgba(255,255,255,0.9);">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Paramètres
              </a>
            )}

            <!-- Séparateur -->
            <div style="height:1px;background:rgba(255,255,255,0.15);margin:4px 0;"></div>

            <!-- Profil + Déco -->
            {currentUser && (
              <button
                id="profile-btn"
                class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-left w-full"
                style="color:rgba(255,255,255,0.9);background:transparent;border:none;cursor:pointer;"
                data-id={currentUser.id}
                data-name={currentUser.full_name}
              >
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                {currentUser.full_name}
              </button>
            )}
            <form action="/api/auth/logout" method="POST">
              <button type="submit" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium w-full" style="color:rgba(255,100,100,0.9);background:transparent;border:none;cursor:pointer;">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                Déconnexion
              </button>
            </form>
          </nav>
        </div>

      </header>
    )}

    <!-- Profile edit modal -->
    {isAdmin && currentUser && (
      <div id="profile-modal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-[200] hidden p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg mx-auto flex flex-col max-h-[92vh]">

          <!-- Header modal -->
          <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
            <h2 class="text-base font-bold text-gray-900">Mon profil</h2>
            <button type="button" id="profile-cancel" class="text-gray-400 hover:text-gray-600 p-1 rounded-lg">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>

          <!-- Scrollable body -->
          <div class="overflow-y-auto flex-1 px-6 py-5">
            <form id="profile-form" class="space-y-5">
              <input type="hidden" name="id" value={currentUser.id} />

              <!-- Avatar -->
              <div class="flex flex-col items-center gap-3 pb-4 border-b border-gray-100">
                <div id="profile-avatar-preview" class="w-20 h-20 rounded-full flex items-center justify-center text-2xl font-black text-white overflow-hidden" style="background:#047857;">
                  {currentUser.avatar
                    ? <img src={currentUser.avatar} class="w-full h-full object-cover" />
                    : currentUser.full_name.split(' ').map((w: string) => w[0]).join('').slice(0,2).toUpperCase()
                  }
                </div>
                <label class="cursor-pointer text-xs font-medium px-4 py-1.5 rounded-full border border-gray-300 hover:bg-gray-50 transition-colors text-gray-600">
                  Changer la photo
                  <input type="file" name="avatar_file" accept="image/*" class="hidden" id="avatar-file-input" />
                </label>
                <input type="hidden" name="avatar" id="avatar-hidden" value={currentUser.avatar || ''} />
              </div>

              <!-- Infos personnelles -->
              <div>
                <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">Informations personnelles</p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div class="sm:col-span-2">
                    <label class="block text-xs font-medium text-gray-600 mb-1">Nom complet *</label>
                    <input type="text" name="full_name" required value={currentUser.full_name}
                      class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-600" />
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Email</label>
                    <input type="email" name="email" value={currentUser.email || ''}
                      placeholder="exemple@email.com"
                      class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-600" />
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Téléphone</label>
                    <input type="tel" name="phone" value={currentUser.phone || ''}
                      placeholder="+228 90 00 00 00"
                      class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-600" />
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Date de naissance</label>
                    <input type="date" name="birthdate" value={currentUser.birthdate || ''}
                      class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-600" />
                  </div>
                </div>
              </div>

              <!-- Sécurité -->
              <div>
                <p class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">Sécurité</p>
                <div>
                  <label class="block text-xs font-medium text-gray-600 mb-1">Nouveau mot de passe</label>
                  <input type="password" name="password" placeholder="Laisser vide pour ne pas changer"
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-600" />
                </div>
              </div>

              <p id="profile-error" class="text-sm text-red-600 hidden"></p>
              <p id="profile-success" class="text-sm text-green-600 hidden">Modifications enregistrées ✓</p>
            </form>
          </div>

          <!-- Footer -->
          <div class="px-6 py-4 border-t border-gray-100 flex gap-3">
            <button type="submit" form="profile-form"
              class="flex-1 text-white text-sm font-semibold py-2.5 rounded-xl transition-colors" style="background:#047857;">
              Enregistrer
            </button>
            <button type="button" id="profile-cancel-2"
              class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold py-2.5 rounded-xl transition-colors">
              Annuler
            </button>
          </div>
        </div>
      </div>
    )}

    <main class="max-w-7xl mx-auto px-3 sm:px-4 py-6 sm:py-8 w-full">
      <slot />
    </main>

    <div id="toast-container"></div>

    <script is:inline>
      // ── Active nav link ───────────────────────────────────────────────────
      (function () {
        var path = window.location.pathname;
        document.querySelectorAll('.nav-link').forEach(function (a) {
          var href = a.getAttribute('href');
          if (!href) return;
          var active = href === '/admin' ? path === '/admin' : path === href || path.startsWith(href + '/');
          if (active) a.classList.add('active');
        });
      })();

      // ── User dropdown ─────────────────────────────────────────────────────
      (function () {
        var btn  = document.getElementById('profile-btn');
        var drop = document.getElementById('user-dropdown');
        if (!btn || !drop) return;
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          drop.classList.toggle('hidden');
        });
        document.addEventListener('click', function () {
          drop.classList.add('hidden');
        });
        drop.addEventListener('click', function (e) { e.stopPropagation(); });
        // "Mon profil" ouvre la modale existante
        document.getElementById('profile-edit-btn')?.addEventListener('click', function () {
          drop.classList.add('hidden');
          document.getElementById('profile-modal')?.classList.remove('hidden');
        });
      })();

      // ── Hamburger menu mobile ─────────────────────────────────────────────
      (function () {
        var btn  = document.getElementById('mob-menu-btn');
        var menu = document.getElementById('mob-menu');
        var h1   = document.getElementById('ham-1');
        var h2   = document.getElementById('ham-2');
        var h3   = document.getElementById('ham-3');
        if (!btn || !menu) return;
        var open = false;
        btn.addEventListener('click', function () {
          open = !open;
          menu.classList.toggle('hidden', !open);
          // Animate to X
          if (h1) h1.style.transform = open ? 'translateY(8px) rotate(45deg)' : '';
          if (h2) h2.style.opacity   = open ? '0' : '1';
          if (h3) h3.style.transform = open ? 'translateY(-8px) rotate(-45deg)' : '';
        });
        // Close on link click
        menu.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', function () {
            open = false;
            menu.classList.add('hidden');
            if (h1) h1.style.transform = '';
            if (h2) h2.style.opacity = '1';
            if (h3) h3.style.transform = '';
          });
        });
      })();

      // ── Toast notifications ───────────────────────────────────────────────
      window.__showToast = function (message, type, duration) {
        type     = type     || 'info';
        duration = duration || 3500;
        var container = document.getElementById('toast-container');
        if (!container) return;
        var icons = { success: '✓', error: '✕', warning: '⚠', info: 'ℹ' };
        var toast = document.createElement('div');
        toast.className = 'toast toast-' + type;
        toast.innerHTML = '<span>' + (icons[type] || '') + '</span><span>' + message + '</span>';
        container.appendChild(toast);
        setTimeout(function () {
          toast.classList.add('hide');
          toast.addEventListener('animationend', function () { toast.remove(); }, { once: true });
        }, duration);
      };
    </script>

    {isAdmin && currentUser && (
      <script>
        const modal   = document.getElementById('profile-modal')!;
        const form    = document.getElementById('profile-form') as HTMLFormElement;
        const errEl   = document.getElementById('profile-error')!;
        const okEl    = document.getElementById('profile-success')!;

        // "Mon profil" dans le dropdown (desktop) et dans le menu mobile
        document.getElementById('profile-edit-btn')?.addEventListener('click', () => {
          errEl.classList.add('hidden');
          okEl.classList.add('hidden');
          (form.querySelector('[name=password]') as HTMLInputElement).value = '';
          modal.classList.remove('hidden');
        });
        // Bouton profil dans le menu mobile
        document.querySelector('#mob-menu button[data-id]')?.addEventListener('click', () => {
          errEl.classList.add('hidden');
          okEl.classList.add('hidden');
          (form.querySelector('[name=password]') as HTMLInputElement).value = '';
          modal.classList.remove('hidden');
        });

        const closeModal = () => modal.classList.add('hidden');
        document.getElementById('profile-cancel')?.addEventListener('click', closeModal);
        document.getElementById('profile-cancel-2')?.addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

        // Avatar file → base64 preview
        const avatarFileInput = document.getElementById('avatar-file-input') as HTMLInputElement;
        const avatarHidden    = document.getElementById('avatar-hidden') as HTMLInputElement;
        const avatarPreview   = document.getElementById('profile-avatar-preview')!;
        avatarFileInput?.addEventListener('change', () => {
          const file = avatarFileInput.files?.[0];
          if (!file) return;
          const reader = new FileReader();
          reader.onload = (ev) => {
            const b64 = ev.target?.result as string;
            avatarHidden.value = b64;
            avatarPreview.innerHTML = `<img src="${b64}" class="w-full h-full object-cover" />`;
          };
          reader.readAsDataURL(file);
        });

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          errEl.classList.add('hidden');
          okEl.classList.add('hidden');
          const id        = (form.querySelector('[name=id]') as HTMLInputElement).value;
          const full_name = (form.querySelector('[name=full_name]') as HTMLInputElement).value.trim();
          const password  = (form.querySelector('[name=password]') as HTMLInputElement).value.trim();
          const email     = (form.querySelector('[name=email]')     as HTMLInputElement).value.trim();
          const phone     = (form.querySelector('[name=phone]')     as HTMLInputElement).value.trim();
          const birthdate = (form.querySelector('[name=birthdate]') as HTMLInputElement).value;
          const avatar    = (form.querySelector('[name=avatar]')    as HTMLInputElement).value;

          const body: Record<string, string> = { full_name, email, phone, birthdate, avatar };
          if (password) body.password = password;

          const res = await fetch(`/api/users/${id}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });

          if (res.ok) {
            okEl.classList.remove('hidden');
            // Update header avatar/initials live
            const initials = full_name.split(' ').map((w: string) => w[0]).join('').slice(0,2).toUpperCase();
            document.querySelectorAll('#profile-btn .w-6').forEach((el: Element) => {
              if (avatar) {
                el.innerHTML = `<img src="${avatar}" class="w-full h-full object-cover rounded-full" />`;
              } else {
                el.textContent = initials;
              }
            });
            setTimeout(() => closeModal(), 1200);
          } else {
            const err = await res.json();
            errEl.textContent = err.error ?? 'Erreur';
            errEl.classList.remove('hidden');
          }
        });

        // ── Badges ───────────────────────────────────────────────────────────
        function setBadge(ids: string[], count: number) {
          ids.forEach(id => {
            const badge = document.getElementById(id);
            if (!badge) return;
            if (count > 0) {
              badge.textContent = count > 99 ? '99+' : String(count);
              badge.classList.remove('hidden');
              badge.classList.add('inline-flex');
            } else {
              badge.classList.add('hidden');
              badge.classList.remove('inline-flex');
            }
          });
        }
        // ── SSE — badges temps réel ───────────────────────────────────────────
        let sseSource: EventSource | null = null;

        function connectSSE() {
          if (sseSource) sseSource.close();
          sseSource = new EventSource('/api/sse');

          sseSource.addEventListener('badge_update', (e: MessageEvent) => {
            try {
              const data = JSON.parse(e.data);
              setBadge(['pending-badge',  'mob-pending-badge'],  data.orders_pending    ?? 0);
              setBadge(['inquiry-badge',  'mob-inquiry-badge'],  data.inquiries_pending ?? 0);
            } catch { /* ignore parse error */ }
          });

          // Relay all SSE events to window so page scripts can subscribe without a second connection
          const relayedEvents = ['new_order', 'order_updated', 'order_deleted', 'inquiry_new', 'inquiry_updated', 'inquiry_deleted', 'badge_update'];
          relayedEvents.forEach(evt => {
            sseSource!.addEventListener(evt, (e: MessageEvent) => {
              try {
                window.dispatchEvent(new CustomEvent(`sse:${evt}`, { detail: JSON.parse(e.data) }));
              } catch { /* ignore */ }
            });
          });

          sseSource.onerror = () => {
            sseSource?.close();
            sseSource = null;
            // Reconnect after 5s
            setTimeout(connectSSE, 5_000);
          };
        }

        connectSSE();

        // Clean up on page unload
        window.addEventListener('beforeunload', () => sseSource?.close());

        // ── Recherche globale ─────────────────────────────────────────────────
        const globalSearch  = document.getElementById('global-search') as HTMLInputElement | null;
        const globalResults = document.getElementById('global-results')!;

        const statusIcon: Record<string, string> = {
          en_attente: '⏳',
          disponible: '✅',
          recupere:   '📦',
        };

        function esc(s: string) {
          return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        function renderGlobalResults(data: { orders: any[]; clients: any[] }) {
          const { orders, clients } = data;
          if (!orders.length && !clients.length) {
            globalResults.innerHTML = '<div class="px-4 py-3 text-sm text-gray-400">Aucun résultat</div>';
            globalResults.classList.remove('hidden');
            return;
          }
          let html = '';
          if (orders.length) {
            html += `<div class="px-3 py-1.5 text-[10px] font-bold text-gray-400 uppercase tracking-wider bg-gray-50 border-b border-gray-100">Commandes</div>`;
            html += orders.map((o: any) => `
              <a href="/admin/orders" data-order="${esc(o.order_number)}"
                class="search-order-link flex items-center justify-between gap-3 px-4 py-2.5 hover:bg-emerald-50 transition-colors border-b border-gray-50">
                <div>
                  <span class="font-mono text-xs font-bold text-emerald-700">${esc(o.order_number)}</span>
                  <span class="ml-2 text-sm text-gray-700">${esc(o.client_name)}</span>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <span class="text-xs">${statusIcon[o.status] ?? ''}</span>
                  <span class="text-xs text-gray-500 font-semibold">${Number(o.total_amount).toLocaleString('fr-FR')} F</span>
                </div>
              </a>`).join('');
          }
          if (clients.length) {
            html += `<div class="px-3 py-1.5 text-[10px] font-bold text-gray-400 uppercase tracking-wider bg-gray-50 border-b border-gray-100 ${orders.length ? 'border-t border-gray-200' : ''}">Clients</div>`;
            html += clients.map((c: any) => `
              <a href="/admin/clients"
                class="flex items-center justify-between gap-3 px-4 py-2.5 hover:bg-emerald-50 transition-colors border-b border-gray-50">
                <span class="text-sm font-medium text-gray-900">${esc(c.name)}</span>
                <span class="text-xs text-gray-400 font-mono">${esc(c.phone)}</span>
              </a>`).join('');
          }
          globalResults.innerHTML = html;
          globalResults.classList.remove('hidden');
        }

        let searchTimer: ReturnType<typeof setTimeout>;
        globalSearch?.addEventListener('input', () => {
          clearTimeout(searchTimer);
          const q = globalSearch.value.trim();
          if (q.length < 2) { globalResults.classList.add('hidden'); return; }
          searchTimer = setTimeout(async () => {
            try {
              const res = await fetch(`/api/search?q=${encodeURIComponent(q)}`);
              if (res.ok) renderGlobalResults(await res.json());
            } catch { /* silent */ }
          }, 200);
        });

        globalSearch?.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') { globalResults.classList.add('hidden'); globalSearch.blur(); }
        });

        document.addEventListener('click', (e) => {
          if (!globalSearch?.contains(e.target as Node) && !globalResults?.contains(e.target as Node)) {
            globalResults?.classList.add('hidden');
          }
        });

        // ── Raccourcis clavier ────────────────────────────────────────────────
        document.addEventListener('keydown', (e) => {
          const tag = (e.target as HTMLElement).tagName;
          if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
          if (e.metaKey || e.ctrlKey || e.altKey) return;
          switch (e.key.toLowerCase()) {
            case 'n': window.location.href = '/admin'; break;
            case 'o': window.location.href = '/admin/orders'; break;
            case 'c': window.location.href = '/admin/clients'; break;
          }
        });
      </script>
    )}

  <!-- Service Worker registration -->
  <script is:inline>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js', { scope: '/' })
          .then(reg => {
            // Check for updates every time the page loads
            reg.update();
          })
          .catch(err => console.warn('[SW] Registration failed:', err));
      });
    }
  </script>
  </body>
</html>
