</Layout>

<style>
  .filter-btn { border-color: #e5e7eb; color: #6b7280; background: white; }
  .filter-btn.active { border-color: #2563eb; color: #2563eb; background: #eff6ff; }
  .filter-btn:hover:not(.active) { background: #f9fafb; }

</style>

<script>
// ---- Helpers ----
function esc(str: unknown): string {
  return String(str ?? '')
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function fmt(n: number) {
  return Number(n).toLocaleString('fr-FR');
}

// ---- Filter + Search + Pagination ----
let activeStatus = 'all';
const PAGE_SIZE = 25;
let currentPage = 1;

function applyFilters() {
  const search = (document.getElementById('search-input') as HTMLInputElement).value.toLowerCase().trim();
  const rows = Array.from(document.querySelectorAll('.order-row')) as HTMLElement[];
  const filtered: HTMLElement[] = [];

  rows.forEach(row => {
    const status = row.dataset.status ?? '';
    const client = row.dataset.client ?? '';
    const number = row.dataset.number ?? '';
    const matchStatus = activeStatus === 'all' || status === activeStatus;
    const matchSearch = !search || client.includes(search) || number.includes(search);
    if (matchStatus && matchSearch) filtered.push(row);
    else row.style.display = 'none';
  });

  const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
  if (currentPage > totalPages) currentPage = totalPages;
  const start = (currentPage - 1) * PAGE_SIZE;
  const end = start + PAGE_SIZE;
  filtered.forEach((row, i) => { row.style.display = (i >= start && i < end) ? '' : 'none'; });

  const countEl = document.getElementById('search-count')!;
  countEl.textContent = `${filtered.length} commande${filtered.length !== 1 ? 's' : ''} trouvée${filtered.length !== 1 ? 's' : ''}`;
  countEl.classList.toggle('hidden', !search && activeStatus === 'all');

  renderPagination(filtered.length, totalPages);
}

function renderPagination(total: number, totalPages: number) {
  const el = document.getElementById('orders-pagination');
  if (!el) return;
  if (totalPages <= 1) { el.innerHTML = ''; return; }
  const s = (currentPage - 1) * PAGE_SIZE + 1;
  const e = Math.min(currentPage * PAGE_SIZE, total);
  const pages: (number | string)[] = [];
  for (let p = 1; p <= totalPages; p++) {
    if (p === 1 || p === totalPages || Math.abs(p - currentPage) <= 1) pages.push(p);
    else if (pages[pages.length - 1] !== '…') pages.push('…');
  }
  const btns = pages.map(p => {
    if (p === '…') return `<span class="px-2 text-gray-400">…</span>`;
    if (p === currentPage) return `<button class="px-3 py-1.5 rounded-lg bg-blue-600 text-white font-semibold text-sm">${p}</button>`;
    return `<button onclick="goToPage(${p})" class="px-3 py-1.5 rounded-lg border border-gray-200 hover:bg-gray-50 text-sm transition">${p}</button>`;
  }).join('');
  el.innerHTML = `<div class="flex items-center justify-between text-sm text-gray-500 py-3 px-1 mt-2">
    <span class="text-xs text-gray-400">${s}–${e} sur ${total} commandes</span>
    <div class="flex items-center gap-1">
      <button onclick="goToPage(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg border border-gray-200 hover:bg-gray-50 disabled:opacity-40 disabled:cursor-not-allowed text-sm transition">‹</button>
      ${btns}
      <button onclick="goToPage(${currentPage + 1})" ${currentPage === totalPages ? 'disabled' : ''} class="px-2.5 py-1.5 rounded-lg border border-gray-200 hover:bg-gray-50 disabled:opacity-40 disabled:cursor-not-allowed text-sm transition">›</button>
    </div>
  </div>`;
}

(window as any).goToPage = (p: number) => {
  currentPage = p;
  applyFilters();
  window.scrollTo({ top: 0, behavior: 'smooth' });
};

document.querySelectorAll('.filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    activeStatus = btn.getAttribute('data-filter') ?? 'all';
    currentPage = 1;
    applyFilters();
  });
});

document.getElementById('search-input')?.addEventListener('input', () => { currentPage = 1; applyFilters(); });


// ---- View Modal ----
const viewModal = document.getElementById('view-modal')!;
const viewContent = document.getElementById('view-modal-content')!;

document.querySelectorAll('.view-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    const order = JSON.parse(btn.getAttribute('data-order')!);
    const statusMap: Record<string, string> = {
      en_attente: '⏳ En attente',
      disponible: '✅ Disponible',
      recupere: '📦 Récupéré',
      annulee: '🚫 Annulée',
    };
    const productsHtml = (order.products ?? []).map((p: any) => `
      <div class="flex items-start justify-between py-2 border-b border-gray-50 last:border-0">
        <div>
          <span class="font-medium text-gray-900">${esc(p.name)}</span>
          <span class="text-gray-400 text-xs ml-2">${esc(p.condition)}</span>
        </div>
        <div class="text-right text-xs text-gray-600 shrink-0 ml-4">
          ${esc(p.quantity)} × ${fmt(p.price)} = <strong>${fmt(p.quantity * p.price)} FCFA</strong>
        </div>
      </div>
    `).join('');

    // Fetch payment history
    let paymentsHtml = '';
    try {
      const res = await fetch(`/api/orders/${order.id}/payments`);
      if (res.ok) {
        const payments: any[] = await res.json();
        if (payments.length > 0) {
          paymentsHtml = `
            <div>
              <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Historique des paiements</p>
              <div class="bg-gray-50 rounded-xl divide-y divide-gray-100">
                ${payments.map((p, i) => `
                  <div class="flex items-center justify-between px-4 py-2.5 text-sm">
                    <div>
                      <span class="font-medium text-gray-700">Paiement #${i + 1}</span>
                      <span class="text-xs text-gray-400 ml-2">${new Date(p.created_at).toLocaleDateString('fr-FR', {day:'2-digit',month:'short',year:'numeric'})}</span>
                      ${p.payment_method ? `<span class="ml-2 text-xs bg-white border border-gray-200 px-1.5 py-0.5 rounded text-gray-600">${esc(p.payment_method)}</span>` : ''}
                      ${p.performed_by ? `<span class="ml-2 text-xs text-blue-600 font-medium">par ${esc(p.performed_by)}</span>` : ''}
                    </div>
                    <span class="font-bold text-green-600">+${fmt(p.amount)} FCFA</span>
                  </div>
                `).join('')}
              </div>
            </div>
          `;
        }
      }
    } catch {}

    viewContent.innerHTML = `
      <div class="space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-gray-100">
          <span class="font-mono text-sm font-bold text-blue-700 bg-blue-50 px-3 py-1 rounded-lg">${esc(order.order_number)}</span>
          <span class="text-xs text-gray-400">${new Date(order.created_at).toLocaleDateString('fr-FR', {day:'2-digit',month:'long',year:'numeric'})}</span>
        </div>
        <div class="grid grid-cols-2 gap-3 text-sm">
          <div><span class="text-gray-400 text-xs block">Client</span><span class="font-semibold">${esc(order.client_name)}</span></div>
          <div><span class="text-gray-400 text-xs block">WhatsApp</span><span class="font-mono">${esc(order.client_phone)}</span></div>
          <div><span class="text-gray-400 text-xs block">Livraison</span><span>${order.delivery_type === 'avion' ? '✈️ EXPRESS' : '🚢 ECO'}</span></div>
          <div><span class="text-gray-400 text-xs block">Statut</span><span>${esc(statusMap[order.status] ?? order.status)}</span></div>
        </div>
        <div>
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Produits</p>
          <div class="bg-gray-50 rounded-xl px-4 py-1">${productsHtml}</div>
        </div>
        <div class="bg-gray-50 rounded-xl p-4 space-y-2 text-sm">
          <div class="flex justify-between"><span class="text-gray-500">Montant total</span><span class="font-bold">${fmt(order.total_amount)} FCFA</span></div>
          <div class="flex justify-between"><span class="text-gray-500">Total versé</span><span class="text-green-600">− ${fmt(order.deposit)} FCFA</span></div>
          <div class="flex justify-between pt-2 border-t border-gray-200 font-bold">
            <span>Reste à payer</span>
            <span class="${Number(order.remaining_balance) > 0 ? 'text-red-600' : 'text-green-600'}">${fmt(order.remaining_balance)} FCFA</span>
          </div>
        </div>
        ${paymentsHtml}
        ${(order.created_by || order.marked_available_by || order.picked_up_by) ? `
        <div>
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Traçabilité</p>
          <div class="bg-gray-50 rounded-xl px-4 py-3 space-y-2 text-sm">
            ${order.created_by ? `<div class="flex items-center gap-2"><span class="text-gray-400 text-xs w-32 shrink-0">Commande créée</span><span class="font-medium text-gray-700">${esc(order.created_by)}</span></div>` : ''}
            ${order.marked_available_by ? `<div class="flex items-center gap-2"><span class="text-gray-400 text-xs w-32 shrink-0">Marquée disponible</span><span class="font-medium text-gray-700">${esc(order.marked_available_by)}</span></div>` : ''}
            ${order.picked_up_by ? `<div class="flex items-center gap-2"><span class="text-gray-400 text-xs w-32 shrink-0">Récupérée</span><span class="font-medium text-gray-700">${esc(order.picked_up_by)}</span></div>` : ''}
          </div>
        </div>
        ` : ''}
        ${order.notes ? `<div class="bg-blue-50 rounded-xl px-4 py-3 text-sm text-blue-800"><span class="font-semibold">Note : </span>${esc(order.notes)}</div>` : ''}
        <a href="/commande/${esc(order.order_number)}" target="_blank"
          class="flex items-center gap-1.5 text-blue-600 hover:text-blue-800 text-sm font-medium">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
          Voir la page client
        </a>
      </div>
    `;
    viewModal.classList.remove('hidden');
  });
});
document.getElementById('close-view-modal')!.addEventListener('click', () => viewModal.classList.add('hidden'));
viewModal.addEventListener('click', e => { if (e.target === viewModal) viewModal.classList.add('hidden'); });

// ---- Edit Modal ----
const editModal = document.getElementById('edit-modal')!;
const editProductsList = document.getElementById('edit-products-list')!;
const editTotalInput = document.getElementById('edit-total') as HTMLInputElement;
const editDepositInput = document.getElementById('edit-deposit') as HTMLInputElement;
const editRemainingInput = document.getElementById('edit-remaining') as HTMLInputElement;

function recalcEditTotal() {
  let total = 0;
  editProductsList.querySelectorAll('.edit-p-row').forEach(row => {
    const price = parseFloat((row.querySelector('.ep-price') as HTMLInputElement).value) || 0;
    const qty = parseInt((row.querySelector('.ep-qty') as HTMLInputElement).value) || 0;
    total += price * qty;
  });
  editTotalInput.value = Math.round(total).toString();
  editRemainingInput.value = Math.max(0, total - (parseFloat(editDepositInput.value) || 0)).toFixed(0);
}

function addEditProductRow(p?: {name:string; condition:string; price:number; quantity:number}) {
  const row = document.createElement('div');
  row.className = 'edit-p-row grid grid-cols-12 gap-2 items-center bg-gray-50 rounded-xl p-2.5 border border-gray-200';
  row.innerHTML = `
    <div class="col-span-4"><input type="text" class="ep-name w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs focus:outline-none focus:ring-1 focus:ring-blue-500" value="${esc(p?.name??'')}" placeholder="Produit..." required /></div>
    <div class="col-span-3"><input type="text" class="ep-condition w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs focus:outline-none focus:ring-1 focus:ring-blue-500" value="${esc(p?.condition??'')}" placeholder="État..." required /></div>
    <div class="col-span-2"><input type="number" class="ep-price w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs focus:outline-none focus:ring-1 focus:ring-blue-500" value="${p?.price??0}" min="0" step="1" /></div>
    <div class="col-span-2"><input type="number" class="ep-qty w-full px-2.5 py-1.5 border border-gray-300 rounded-lg text-xs focus:outline-none focus:ring-1 focus:ring-blue-500" value="${p?.quantity??1}" min="1" /></div>
    <div class="col-span-1 flex justify-center">
      <button type="button" class="ep-remove p-1 text-gray-300 hover:text-red-500 rounded transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
  `;
  row.querySelector('.ep-price')!.addEventListener('input', recalcEditTotal);
  row.querySelector('.ep-qty')!.addEventListener('input', recalcEditTotal);
  row.querySelector('.ep-remove')!.addEventListener('click', () => { row.remove(); recalcEditTotal(); });
  editProductsList.appendChild(row);
}

document.getElementById('edit-add-product')!.addEventListener('click', () => { addEditProductRow(); recalcEditTotal(); });
editDepositInput.addEventListener('input', recalcEditTotal);

document.querySelectorAll('.edit-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const order = JSON.parse(btn.getAttribute('data-order')!);
    (document.getElementById('edit-order-id') as HTMLInputElement).value = order.id;
    (document.getElementById('edit-client-name') as HTMLInputElement).value = order.client_name;
    (document.getElementById('edit-client-phone') as HTMLInputElement).value = order.client_phone;
    (document.getElementById('edit-delivery') as HTMLSelectElement).value = order.delivery_type;
    (document.getElementById('edit-status') as HTMLSelectElement).value = order.status;
    editDepositInput.value = order.deposit;
    editTotalInput.value = Math.round(Number(order.total_amount)).toString();
    editRemainingInput.value = Math.round(Number(order.remaining_balance)).toString();
    (document.getElementById('edit-notes') as HTMLTextAreaElement).value = order.notes ?? '';
    editProductsList.innerHTML = '';
    (order.products ?? []).forEach((p: any) => addEditProductRow(p));
    (document.getElementById('edit-error') as HTMLElement).classList.add('hidden');
    editModal.classList.remove('hidden');
  });
});

document.getElementById('close-edit-modal')!.addEventListener('click', () => editModal.classList.add('hidden'));
document.getElementById('cancel-edit')!.addEventListener('click', () => editModal.classList.add('hidden'));
editModal.addEventListener('click', e => { if (e.target === editModal) editModal.classList.add('hidden'); });

document.getElementById('edit-form')!.addEventListener('submit', async e => {
  e.preventDefault();
  const id = (document.getElementById('edit-order-id') as HTMLInputElement).value;
  const submitBtn = document.getElementById('edit-submit') as HTMLButtonElement;
  const submitIcon = document.getElementById('edit-submit-icon')!;
  const submitSpinner = document.getElementById('edit-submit-spinner')!;
  const errorDiv = document.getElementById('edit-error') as HTMLElement;

  submitBtn.disabled = true;
  submitIcon.classList.add('hidden');
  submitSpinner.classList.remove('hidden');
  errorDiv.classList.add('hidden');

  const products = Array.from(editProductsList.querySelectorAll('.edit-p-row')).map(row => ({
    name: (row.querySelector('.ep-name') as HTMLInputElement).value.trim(),
    condition: (row.querySelector('.ep-condition') as HTMLInputElement).value.trim(),
    price: parseFloat((row.querySelector('.ep-price') as HTMLInputElement).value) || 0,
    quantity: parseInt((row.querySelector('.ep-qty') as HTMLInputElement).value) || 1,
  }));

  const total = parseFloat(editTotalInput.value) || 0;
  const deposit = parseFloat(editDepositInput.value) || 0;

  const payload = {
    client_name: (document.getElementById('edit-client-name') as HTMLInputElement).value.trim(),
    client_phone: (document.getElementById('edit-client-phone') as HTMLInputElement).value.trim(),
    delivery_type: (document.getElementById('edit-delivery') as HTMLSelectElement).value,
    status: (document.getElementById('edit-status') as HTMLSelectElement).value,
    total_amount: total,
    deposit: deposit,
    remaining_balance: Math.max(0, total - deposit),
    notes: (document.getElementById('edit-notes') as HTMLTextAreaElement).value,
    products,
  };

  try {
    const res = await fetch(`/api/orders/${id}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (res.ok) {
      window.location.reload();
    } else {
      const data = await res.json();
      errorDiv.textContent = data.error ?? 'Erreur lors de la modification.';
      errorDiv.classList.remove('hidden');
    }
  } catch {
    errorDiv.textContent = 'Erreur de connexion.';
    errorDiv.classList.remove('hidden');
  } finally {
    submitBtn.disabled = false;
    submitIcon.classList.remove('hidden');
    submitSpinner.classList.add('hidden');
  }
});

// ---- Confirm Modal (shared for available, pickup, delete) ----
const confirmModal = document.getElementById('confirm-modal')!;
let confirmAction: (() => Promise<void>) | null = null;

function showConfirm(opts: {
  title: string;
  msg: string;
  btnLabel: string;
  btnColor: string;
  iconHtml: string;
  iconBg: string;
  action: () => Promise<void>;
}) {
  document.getElementById('confirm-title')!.textContent = opts.title;
  document.getElementById('confirm-msg')!.textContent = opts.msg;
  document.getElementById('confirm-btn-label')!.textContent = opts.btnLabel;
  const doBtn = document.getElementById('do-confirm') as HTMLButtonElement;
  doBtn.className = `flex-1 px-4 py-2.5 text-sm font-semibold text-white rounded-lg transition-colors flex items-center justify-center gap-2 ${opts.btnColor}`;
  document.getElementById('confirm-icon-wrap')!.className = `w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-4 ${opts.iconBg}`;
  document.getElementById('confirm-icon-wrap')!.innerHTML = opts.iconHtml;
  confirmAction = opts.action;
  confirmModal.classList.remove('hidden');
}

document.getElementById('cancel-confirm')!.addEventListener('click', () => confirmModal.classList.add('hidden'));
confirmModal.addEventListener('click', e => { if (e.target === confirmModal) confirmModal.classList.add('hidden'); });

document.getElementById('do-confirm')!.addEventListener('click', async () => {
  if (!confirmAction) return;
  const doBtn = document.getElementById('do-confirm') as HTMLButtonElement;
  const spinner = document.getElementById('confirm-spinner')!;
  const label = document.getElementById('confirm-btn-label')!;
  doBtn.disabled = true;
  spinner.classList.remove('hidden');
  label.classList.add('hidden');
  await confirmAction();
  doBtn.disabled = false;
  spinner.classList.add('hidden');
  label.classList.remove('hidden');
});

