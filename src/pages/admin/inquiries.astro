---
import Layout from '../../layouts/Layout.astro';
import { requireAuth } from '../../lib/auth';
import { getAllInquiries, updateInquiry } from '../../lib/inquiries';

const redirect = requireAuth(Astro);
if (redirect) return redirect;

const inquiries = getAllInquiries();

const statusLabels: Record<string, { label: string; color: string }> = {
  'en_attente': { label: 'En attente', color: 'yellow' },
  'acceptee':   { label: 'Acceptée',   color: 'green' },
  'refusee':    { label: 'Refusée',    color: 'red' },
  'annulee':    { label: 'Annulée',    color: 'gray' },
};

const fmt = (n: number) => n.toLocaleString('fr-FR');
const dateStr = (d: string) => new Date(d).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' });

const statusColors: Record<string, string> = {
  'yellow': 'bg-yellow-50 text-yellow-700 border-yellow-200',
  'green':  'bg-green-50 text-green-700 border-green-200',
  'red':    'bg-red-50 text-red-700 border-red-200',
  'gray':   'bg-gray-50 text-gray-500 border-gray-200',
};

const statusBadgeColors: Record<string, string> = {
  'yellow': 'bg-yellow-100 text-yellow-800',
  'green':  'bg-green-100 text-green-800',
  'red':    'bg-red-100 text-red-800',
  'gray':   'bg-gray-100 text-gray-600',
};

function getDevisNumber(id: number): string {
  return `DEV-${String(id).padStart(4, '0')}`;
}
---

<Layout title="Demandes" isAdmin>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
    <div class="flex items-center justify-between gap-4 mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Demandes de Devis</h1>
        <p class="text-sm text-gray-600 mt-1">{inquiries.length} demande{inquiries.length !== 1 ? 's' : ''}</p>
      </div>
      <a href="/demande" target="_blank" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-50 text-blue-700 hover:bg-blue-100 rounded-lg font-medium text-sm transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
        Voir formulaire
      </a>
    </div>

    <!-- Filtres -->
    <div class="flex flex-wrap gap-2 mb-6">
      {[
        { key: 'toutes',     label: 'Toutes',     count: inquiries.length },
        { key: 'en_attente', label: 'En attente', count: inquiries.filter(i => (i.status || 'en_attente') === 'en_attente').length },
        { key: 'acceptee',   label: 'Acceptée',   count: inquiries.filter(i => i.status === 'acceptee').length },
        { key: 'refusee',    label: 'Refusée',    count: inquiries.filter(i => i.status === 'refusee').length },
        { key: 'annulee',    label: 'Annulée',    count: inquiries.filter(i => i.status === 'annulee').length },
      ].map(({ key, label, count }) => (
        <button
          class="filter-btn flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium border transition-colors"
          data-filter={key}
          style={key === 'toutes' ? 'background:#047857;color:white;border-color:#047857;' : 'background:white;color:#6b7280;border-color:#e5e7eb;'}
        >
          {label}
          <span class="text-xs font-bold px-1.5 py-0.5 rounded-full" style={key === 'toutes' ? 'background:rgba(255,255,255,0.25);' : 'background:#f3f4f6;'}>{count}</span>
        </button>
      ))}
    </div>

    <!-- Cartes mobile (md:hidden) -->
    <div class="md:hidden space-y-3">
      {inquiries.length === 0 ? (
        <div class="bg-white rounded-2xl border border-gray-200 p-8 text-center text-gray-500 text-sm">
          Aucune demande reçue
        </div>
      ) : inquiries.map((inquiry) => {
        const status = inquiry.status || 'en_attente';
        const { label, color } = statusLabels[status] ?? statusLabels['en_attente'];
        return (
          <div class="inquiry-card bg-white rounded-2xl border border-gray-200 shadow-sm p-4" data-status={status}>
            <!-- Top row: n° devis + statut -->
            <div class="flex items-center justify-between mb-2">
              <span class="font-mono text-xs font-bold text-blue-700 bg-blue-50 px-2 py-1 rounded-md">
                {getDevisNumber(inquiry.id!)}
              </span>
              <span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${statusColors[color]}`}>{label}</span>
            </div>
            <!-- Client -->
            <div class="font-semibold text-gray-900 text-sm">{inquiry.client_name}</div>
            <div class="text-xs text-gray-400 mt-0.5 flex items-center gap-2">
              <span>{inquiry.client_phone}</span>
              <span>·</span>
              <span>{inquiry.delivery_type === 'bateau' ? '🚢 ECO' : '✈️ EXPRESS'}</span>
              <span>·</span>
              <span>{dateStr(inquiry.created_at!)}</span>
            </div>
            <!-- Actions -->
            <div class="flex items-center justify-end gap-1 mt-3 pt-3 border-t border-gray-100">
              <button class="confirm-btn p-2 text-emerald-600 hover:text-emerald-700 hover:bg-emerald-50 rounded-lg transition-colors" data-id={inquiry.id} title="Confirmer le devis">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              </button>
              <button class="view-btn p-2 text-blue-600 hover:text-blue-700 hover:bg-blue-50 rounded-lg transition-colors" data-id={inquiry.id} title="Voir détails">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              </button>
              <button class="delete-btn p-2 text-red-500 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors" data-id={inquiry.id} title="Supprimer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              </button>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Table desktop (hidden on mobile) -->
    <div class="hidden md:block bg-white rounded-xl border border-gray-200 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-200">
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">N° Devis</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Client</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Livraison</th>
              <th class="px-4 py-3 text-center text-xs font-semibold text-gray-700 uppercase tracking-wider">Statut</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Date</th>
              <th class="px-4 py-3 text-center text-xs font-semibold text-gray-700 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody>
            {inquiries.length === 0 ? (
              <tr>
                <td colspan="6" class="px-4 py-8 text-center text-gray-500 text-sm">
                  Aucune demande reçue
                </td>
              </tr>
            ) : (
              inquiries.map((inquiry) => {
                const status = inquiry.status || 'en_attente';
                const { label, color } = statusLabels[status] ?? statusLabels['en_attente'];
                const products = inquiry.products || [];
                return (
                  <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors" data-id={inquiry.id} data-status={status}>
                    <td class="px-4 py-3">
                      <span class="font-mono text-xs font-bold text-blue-700 bg-blue-50 px-2 py-1 rounded">
                        {getDevisNumber(inquiry.id!)}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-sm">
                      <div class="font-medium text-gray-900">{inquiry.client_name}</div>
                      <div class="text-xs text-gray-500">{inquiry.client_phone}</div>
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-700">
                      {inquiry.delivery_type === 'bateau' ? 'ECO' : 'EXPRESS'}
                    </td>
                    <td class="px-4 py-3 text-center">
                      <span class={`text-xs font-semibold px-2.5 py-1 rounded-full ${statusBadgeColors[color]}`}>{label}</span>
                    </td>
                    <td class="px-4 py-3 text-xs text-gray-600">{dateStr(inquiry.created_at!)}</td>
                    <td class="px-4 py-3 text-center">
                      <div class="flex items-center justify-center gap-1">
                        <!-- Confirmer -->
                        <button class="confirm-btn p-1.5 text-emerald-600 hover:text-emerald-700 hover:bg-emerald-50 rounded-lg transition-colors" data-id={inquiry.id} title="Confirmer le devis">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                          </svg>
                        </button>
                        <!-- Voir -->
                        <button class="view-btn text-blue-600 hover:text-blue-700 p-1.5 hover:bg-blue-50 rounded-lg" data-id={inquiry.id} title="Voir détails">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                          </svg>
                        </button>
                        <!-- Supprimer -->
                        <button class="delete-btn text-red-500 hover:text-red-600 p-1.5 hover:bg-red-50 rounded-lg" data-id={inquiry.id} title="Supprimer">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                          </svg>
                        </button>
                      </div>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════
       MODAL DÉTAIL
  ══════════════════════════════════════════════════ -->
  <div id="detail-modal" class="fixed inset-0 bg-black/40 flex items-end sm:items-center justify-center z-[200] hidden p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-auto">
      <div class="sticky top-0 bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between">
        <h2 class="text-lg font-semibold text-gray-900">Détails de la demande</h2>
        <button id="close-detail-modal" class="text-gray-400 hover:text-gray-600">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <div id="detail-modal-content" class="p-6 space-y-4"></div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════
       LIGHTBOX
  ══════════════════════════════════════════════════ -->
  <div id="lightbox" class="fixed inset-0 bg-black/90 flex items-center justify-center z-[100] hidden">
    <button id="lb-close" class="absolute top-4 right-4 text-white/70 hover:text-white p-2">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
    <button id="lb-prev" class="absolute left-4 text-white/70 hover:text-white p-3 bg-white/10 rounded-full">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    </button>
    <img id="lb-img" src="" alt="" class="max-h-[85vh] max-w-[85vw] rounded-lg object-contain shadow-2xl"/>
    <button id="lb-next" class="absolute right-4 text-white/70 hover:text-white p-3 bg-white/10 rounded-full">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </button>
    <div id="lb-counter" class="absolute bottom-5 text-white/60 text-sm font-medium"></div>
  </div>

  <!-- ══════════════════════════════════════════════════
       MODAL CONFIRMER — Proposition A : "Fiche Devis"
       Design SaaS avec cartes produits, photos visibles
  ══════════════════════════════════════════════════ -->
  <div id="confirm-modal-a" class="fixed inset-0 bg-black/50 flex items-center justify-center z-[200] hidden p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[92vh] flex flex-col overflow-hidden">
      <!-- Header -->
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 flex-shrink-0">
        <div class="flex items-center gap-3 min-w-0">
          <div class="w-9 h-9 bg-emerald-100 rounded-xl flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <div class="min-w-0">
            <h2 class="text-base font-bold text-gray-900 truncate">Fiche de Devis</h2>
            <p id="cma-devis-num" class="text-xs text-gray-500 font-mono truncate"></p>
          </div>
        </div>
        <button class="close-confirm-modal text-gray-400 hover:text-gray-600 p-1 flex-shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- Scrollable content -->
      <div class="overflow-auto flex-1">
        <div class="px-4 sm:px-6 py-6 space-y-6">
          <!-- Client info card -->
          <div class="bg-gradient-to-br from-emerald-50 to-teal-50 rounded-xl border border-emerald-100 p-4 sm:p-5 space-y-4">
            <!-- Name & Phone on same line -->
            <div class="grid grid-cols-2 gap-4 items-start">
              <div>
                <p class="text-xs font-bold text-emerald-600 uppercase tracking-wider mb-1.5">👤 Client</p>
                <p id="cma-client" class="text-base font-semibold text-gray-900 leading-snug"></p>
              </div>
              <div>
                <p class="text-xs font-bold text-emerald-600 uppercase tracking-wider mb-1.5">📱 Téléphone</p>
                <p id="cma-phone" class="text-base font-semibold text-gray-900 font-mono break-all"></p>
              </div>
            </div>

            <!-- Delivery mode -->
            <div class="space-y-2 pt-2 border-t border-emerald-200">
              <p class="text-xs font-bold text-emerald-600 uppercase tracking-wider">🚚 Mode de livraison</p>
              <select id="cma-delivery" class="w-full text-sm font-semibold text-gray-900 bg-white border-2 border-emerald-200 rounded-lg px-3 py-2 focus:outline-none focus:border-emerald-400 cursor-pointer transition-colors">
                <option value="avion">✈️ Express (avion) - 4 à 14 jours</option>
                <option value="bateau">🚢 Économique (bateau) - 45 à 60 jours</option>
              </select>
            </div>
          </div>

          <!-- Divider -->
          <div class="border-t border-gray-200"></div>

          <!-- Products cards -->
          <div id="cma-products-container" class="space-y-4">
            <!-- Produits seront insérés ici en JS -->
          </div>

          <!-- Divider -->
          <div class="border-t border-gray-200"></div>

          <!-- Notes -->
          <div>
            <label class="text-xs font-bold text-gray-500 uppercase block mb-2">Note au client (optionnel)</label>
            <textarea id="cma-note" rows="2" placeholder="Message accompagnant le devis..." class="w-full text-sm px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:border-emerald-400 resize-none"></textarea>
          </div>
        </div>
      </div>

      <!-- Footer with total -->
      <div class="border-t border-gray-100 px-4 sm:px-6 py-4 flex-shrink-0 bg-gray-50">
        <div class="text-center mb-4">
          <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">Total devis</p>
          <p id="cma-total" class="text-3xl font-black text-gray-900">0 FCFA</p>
        </div>
        <button id="cma-send" class="w-full py-3 bg-emerald-500 hover:bg-emerald-600 text-white font-bold rounded-xl transition-colors flex items-center justify-center gap-2 text-sm sm:text-base">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
          Envoyer au client
        </button>
      </div>
    </div>
  </div>

  <style>
    .cma-state-radio { accent-color: rgb(16 185 129); }
  </style>

  <!-- ══════════════════════════════════════════════════
       MODAL CONFIRMER — Proposition B : "Confirmateur rapide"
       Compact, inline, aperçu visuel
  ══════════════════════════════════════════════════ -->
  <div id="confirm-modal-b" class="fixed inset-0 bg-black/50 flex items-center justify-center z-[200] hidden p-4">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg max-h-[92vh] flex flex-col overflow-hidden">
      <!-- Colored header -->
      <div class="bg-gradient-to-r from-emerald-500 to-teal-500 px-6 pt-6 pb-8 text-white relative">
        <button class="close-confirm-modal absolute top-4 right-4 text-white/70 hover:text-white">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
        <p class="text-sm font-semibold text-emerald-100 mb-1">Confirmer le devis</p>
        <h2 id="cmb-devis-num" class="text-2xl font-black font-mono tracking-wider"></h2>
        <div class="mt-3 flex gap-4 text-sm">
          <span>👤 <span id="cmb-client" class="font-semibold"></span></span>
          <span>📞 <span id="cmb-phone"></span></span>
        </div>
      </div>

      <div class="overflow-auto flex-1 px-6 py-5 -mt-4">
        <!-- Products -->
        <div id="cmb-products-list" class="space-y-3 mb-5"></div>

        <!-- Delivery -->
        <div class="mb-5">
          <p class="text-xs font-bold text-gray-500 uppercase mb-2">Mode de livraison</p>
          <div class="grid grid-cols-2 gap-2">
            <label id="cmb-del-avion" class="flex items-center gap-2 p-3 border-2 border-emerald-400 bg-emerald-50 rounded-xl cursor-pointer text-sm font-semibold text-emerald-700">
              <input type="radio" name="cmb-delivery" value="avion" class="accent-emerald-500" checked /> ✈️ Express
            </label>
            <label id="cmb-del-bateau" class="flex items-center gap-2 p-3 border-2 border-gray-200 rounded-xl cursor-pointer text-sm font-semibold text-gray-600">
              <input type="radio" name="cmb-delivery" value="bateau" class="accent-emerald-500" /> 🚢 Économique
            </label>
          </div>
        </div>

        <!-- Total pill -->
        <div class="bg-gray-900 rounded-2xl px-5 py-4 flex items-center justify-between text-white mb-5">
          <span class="text-sm font-semibold text-gray-300">Total</span>
          <span id="cmb-total" class="text-3xl font-black">0 F</span>
        </div>
      </div>

      <div class="border-t border-gray-100 px-6 pb-6 pt-4">
        <button id="cmb-send" class="w-full py-3.5 bg-gray-900 hover:bg-gray-800 text-white font-bold rounded-2xl transition-colors text-sm tracking-wide">
          → Envoyer au client
        </button>
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════
       MODAL CONFIRMER — Proposition C : "Wizard 2 étapes"
       Étape 1 = éditer | Étape 2 = aperçu + envoi
  ══════════════════════════════════════════════════ -->
  <div id="confirm-modal-c" class="fixed inset-0 bg-black/50 flex items-center justify-center z-[200] hidden p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[92vh] flex flex-col">
      <!-- Step indicator -->
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
        <div class="flex items-center gap-3">
          <div id="cmc-step1-badge" class="flex items-center gap-2 text-sm font-semibold text-blue-600">
            <span class="w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center text-xs font-bold">1</span>
            Modifier
          </div>
          <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <div id="cmc-step2-badge" class="flex items-center gap-2 text-sm font-semibold text-gray-400">
            <span class="w-6 h-6 bg-gray-200 text-gray-400 rounded-full flex items-center justify-center text-xs font-bold">2</span>
            Aperçu & Envoi
          </div>
        </div>
        <button class="close-confirm-modal text-gray-400 hover:text-gray-600">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- Step 1 -->
      <div id="cmc-step1" class="overflow-auto flex-1 px-6 py-5 space-y-5">
        <div class="flex gap-4 text-sm">
          <div class="flex-1 bg-blue-50 rounded-xl p-3">
            <p class="text-xs font-bold text-blue-400 uppercase">Client</p>
            <p id="cmc-client" class="font-bold text-blue-900 mt-0.5"></p>
            <p id="cmc-phone" class="text-blue-700 text-xs mt-0.5"></p>
          </div>
          <div class="flex-1 bg-blue-50 rounded-xl p-3">
            <p class="text-xs font-bold text-blue-400 uppercase mb-1.5">Livraison</p>
            <select id="cmc-delivery" class="w-full text-sm font-semibold bg-white border border-blue-200 rounded-lg px-2 py-1.5 focus:outline-none focus:border-blue-400">
              <option value="avion">✈️ Express (avion)</option>
              <option value="bateau">🚢 Économique (bateau)</option>
            </select>
          </div>
        </div>

        <div>
          <p class="text-xs font-bold text-gray-500 uppercase mb-3">Produits & Prix</p>
          <div id="cmc-products-edit" class="space-y-2"></div>
        </div>
      </div>

      <!-- Step 2 -->
      <div id="cmc-step2" class="overflow-auto flex-1 px-6 py-5 hidden">
        <!-- Preview receipt -->
        <div class="border-2 border-dashed border-gray-200 rounded-2xl p-5 mb-4">
          <div class="text-center mb-4">
            <p class="text-xs font-bold text-gray-400 uppercase tracking-widest">Devis</p>
            <p id="cmc-preview-num" class="text-xl font-black font-mono text-gray-900"></p>
            <p id="cmc-preview-client" class="text-sm text-gray-600 mt-1"></p>
          </div>
          <div id="cmc-preview-products" class="space-y-2 border-t border-b border-gray-100 py-3 mb-3 text-sm"></div>
          <div class="flex justify-between text-sm text-gray-500 mb-1">
            <span>Livraison</span><span id="cmc-preview-delivery"></span>
          </div>
          <div class="flex justify-between font-black text-lg">
            <span>Total</span><span id="cmc-preview-total" class="text-blue-700"></span>
          </div>
        </div>
        <div>
          <label class="text-xs font-bold text-gray-500 uppercase block mb-1">Message au client</label>
          <textarea id="cmc-note" rows="3" placeholder="Votre devis est prêt..." class="w-full text-sm px-3 py-2 border border-gray-200 rounded-xl focus:outline-none focus:border-blue-400 resize-none"></textarea>
        </div>
      </div>

      <!-- Footer -->
      <div class="border-t border-gray-100 px-6 py-4 flex gap-3">
        <button id="cmc-back" class="hidden px-5 py-2.5 border border-gray-200 text-gray-600 font-semibold rounded-xl hover:bg-gray-50 text-sm transition-colors">
          ← Retour
        </button>
        <button id="cmc-next" class="flex-1 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl transition-colors text-sm flex items-center justify-center gap-2">
          Continuer → Aperçu
        </button>
        <button id="cmc-send" class="hidden flex-1 py-2.5 bg-emerald-500 hover:bg-emerald-600 text-white font-bold rounded-xl transition-colors text-sm flex items-center justify-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
          Envoyer au client
        </button>
      </div>
    </div>
  </div>

  <style>
    .line-clamp-2 {
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
  </style>

  <script>
    // ── Filtres ────────────────────────────────────────────────────────────
    (function () {
      const btns = document.querySelectorAll('.filter-btn');
      const rows = document.querySelectorAll('tbody tr[data-status]');
      const cards = document.querySelectorAll('.inquiry-card[data-status]');

      btns.forEach(btn => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');

          // Style boutons
          btns.forEach(b => {
            b.style.background = 'white';
            b.style.color = '#6b7280';
            b.style.borderColor = '#e5e7eb';
            const badge = b.querySelector('span');
            if (badge) badge.style.background = '#f3f4f6';
          });
          btn.style.background = '#047857';
          btn.style.color = 'white';
          btn.style.borderColor = '#047857';
          const activeBadge = btn.querySelector('span');
          if (activeBadge) activeBadge.style.background = 'rgba(255,255,255,0.25)';

          // Filtrer lignes tableau + cartes mobile
          [...rows, ...cards].forEach(el => {
            const status = el.getAttribute('data-status');
            (el as HTMLElement).style.display = (filter === 'toutes' || status === filter) ? '' : 'none';
          });
        });
      });
    })();
  </script>

  <script define:vars={{ inquiries }}>
    const ACTIVE_MODAL = 'a'; // 'a', 'b', ou 'c' — à changer selon le choix

    function getDevisNum(id) {
      return `DEV-${String(id).padStart(4, '0')}`;
    }

    function fmt(n) {
      return Number(n || 0).toLocaleString('fr-FR');
    }

    // ── Status select ──────────────────────────────────────────
    document.querySelectorAll('.status-select').forEach(select => {
      select.value = select.getAttribute('data-status') || 'en_attente';
      select.addEventListener('change', async (e) => {
        const id = e.target.dataset.id;
        const status = e.target.value;
        try {
          const res = await fetch(`/api/inquiries/${id}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status }),
          });
          if (!res.ok) alert('Erreur lors de la mise à jour');
        } catch (err) {
          alert('Erreur réseau');
        }
      });
    });

    // ── Lightbox ───────────────────────────────────────────────
    let lbPhotos = [];
    let lbIndex = 0;

    function openLightbox(photos, startIndex) {
      lbPhotos = photos;
      lbIndex = startIndex;
      updateLightbox();
      document.getElementById('lightbox').classList.remove('hidden');
    }

    function updateLightbox() {
      document.getElementById('lb-img').src = lbPhotos[lbIndex];
      document.getElementById('lb-counter').textContent = `${lbIndex + 1} / ${lbPhotos.length}`;
      document.getElementById('lb-prev').style.display = lbPhotos.length > 1 ? '' : 'none';
      document.getElementById('lb-next').style.display = lbPhotos.length > 1 ? '' : 'none';
    }

    document.getElementById('lb-close')?.addEventListener('click', () => {
      document.getElementById('lightbox').classList.add('hidden');
    });
    document.getElementById('lightbox')?.addEventListener('click', (e) => {
      if (e.target.id === 'lightbox' || e.target.id === 'lb-img') return;
      if (e.target.closest('#lb-prev') || e.target.closest('#lb-next') || e.target.closest('#lb-close')) return;
      document.getElementById('lightbox').classList.add('hidden');
    });
    document.getElementById('lb-prev')?.addEventListener('click', () => {
      lbIndex = (lbIndex - 1 + lbPhotos.length) % lbPhotos.length;
      updateLightbox();
    });
    document.getElementById('lb-next')?.addEventListener('click', () => {
      lbIndex = (lbIndex + 1) % lbPhotos.length;
      updateLightbox();
    });
    document.addEventListener('keydown', (e) => {
      const lb = document.getElementById('lightbox');
      if (lb.classList.contains('hidden')) return;
      if (e.key === 'ArrowLeft') { lbIndex = (lbIndex - 1 + lbPhotos.length) % lbPhotos.length; updateLightbox(); }
      if (e.key === 'ArrowRight') { lbIndex = (lbIndex + 1) % lbPhotos.length; updateLightbox(); }
      if (e.key === 'Escape') lb.classList.add('hidden');
    });

    // ── View detail ────────────────────────────────────────────
    document.querySelectorAll('.view-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.id;
        const inquiry = inquiries.find(i => i.id == id);
        if (!inquiry) return;
        const products = inquiry.products || [];
        const globalPhotos = inquiry.photos || [];

        // Build per-product photo sections
        // Products from demande form may include photos stored globally; we show global photos attributed to the gallery
        const productsHtml = products.length > 0 ? `
          <div>
            <p class="text-xs font-bold text-gray-500 uppercase mb-3">Produits</p>
            <div class="space-y-3">
              ${products.map((p, i) => {
                const prodPhotos = (p.photos || []);
                const prodLinks = (p.links || []);
                const thumbsHtml = prodPhotos.length > 0 ? `
                  <div class="flex flex-wrap gap-1.5 mt-2 prod-photo-row" data-photos='${JSON.stringify(prodPhotos)}'>
                    ${prodPhotos.map((src, pi) => `
                      <img src="${src}" data-pi="${pi}" class="lb-thumb w-14 h-14 rounded-lg object-cover border border-gray-200 cursor-zoom-in hover:opacity-90 transition-opacity"/>
                    `).join('')}
                  </div>
                ` : '';
                const linksHtml = prodLinks.length > 0
                  ? prodLinks.map(l => `<a href="${l}" target="_blank" rel="noopener" class="text-blue-600 text-xs underline break-all">🔗 ${l}</a>`).join('<br/>')
                  : '';
                return `
                  <div class="bg-gray-50 rounded-xl p-3">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="w-5 h-5 bg-blue-100 text-blue-700 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0">${i+1}</span>
                      <span class="font-semibold text-gray-900 text-sm">${p.name}</span>
                      <span class="text-gray-400 text-xs">×${p.quantity || 1}</span>
                      ${p.state ? `<span class="text-xs text-gray-500 italic bg-white px-1.5 py-0.5 rounded border border-gray-200">${p.state}</span>` : ''}
                    </div>
                    ${linksHtml ? `<div class="mt-1">${linksHtml}</div>` : ''}
                    ${thumbsHtml}
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        ` : `<div><p class="text-xs font-bold text-gray-500 uppercase">Description</p><p class="text-sm text-gray-900 mt-1 p-3 bg-gray-50 rounded-lg">${inquiry.description}</p></div>`;

        const globalPhotosHtml = globalPhotos.length > 0 ? `
          <div>
            <p class="text-xs font-bold text-gray-500 uppercase mb-2">Photos jointes</p>
            <div class="flex flex-wrap gap-2 global-photo-row" data-photos='${JSON.stringify(globalPhotos)}'>
              ${globalPhotos.map((src, pi) => `
                <img src="${src}" data-pi="${pi}" class="lb-thumb w-20 h-20 rounded-xl object-cover border border-gray-200 cursor-zoom-in hover:opacity-90 transition-opacity shadow-sm"/>
              `).join('')}
            </div>
          </div>
        ` : '';

        const content = document.getElementById('detail-modal-content');
        content.innerHTML = `
          <div class="space-y-4">
            <div>
              <p class="text-sm font-bold text-gray-700 uppercase mb-3">👤 Informations client</p>
              <div class="bg-blue-50 rounded-xl p-4 border border-blue-100">
                <div class="grid grid-cols-2 gap-6">
                  <div>
                    <p class="text-xs text-blue-500 font-semibold">Nom</p>
                    <p class="font-semibold text-gray-900">${inquiry.client_name}</p>
                  </div>
                  <div>
                    <p class="text-xs text-blue-500 font-semibold">Téléphone</p>
                    <p class="font-semibold text-gray-900">${inquiry.client_phone}</p>
                  </div>
                </div>
              </div>
            </div>
            ${productsHtml}
            <div class="grid grid-cols-2 gap-3">
              <div class="bg-gray-50 rounded-xl p-3">
                <p class="text-xs font-bold text-gray-400 uppercase">Livraison</p>
                <p class="text-sm text-gray-900 mt-0.5">${inquiry.delivery_type === 'bateau' ? 'ECO' : 'EXPRESS'}</p>
              </div>
              <div class="bg-gray-50 rounded-xl p-3">
                <p class="text-xs font-bold text-gray-400 uppercase">Date</p>
                <p class="text-sm text-gray-900 mt-0.5">${new Date(inquiry.created_at).toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' })}</p>
              </div>
            </div>
            ${globalPhotosHtml}
            ${inquiry.notes ? `<div class="bg-blue-50 rounded-xl p-3"><p class="text-xs font-bold text-blue-400 uppercase">Notes</p><p class="text-sm text-blue-900 mt-1">${inquiry.notes}</p></div>` : ''}
          </div>
        `;

        // Wire lightbox for per-product photos
        content.querySelectorAll('.prod-photo-row').forEach(row => {
          const photos = JSON.parse(row.dataset.photos);
          row.querySelectorAll('.lb-thumb').forEach(img => {
            img.addEventListener('click', () => openLightbox(photos, parseInt(img.dataset.pi)));
          });
        });

        // Wire lightbox for global photos
        content.querySelectorAll('.global-photo-row').forEach(row => {
          const photos = JSON.parse(row.dataset.photos);
          row.querySelectorAll('.lb-thumb').forEach(img => {
            img.addEventListener('click', () => openLightbox(photos, parseInt(img.dataset.pi)));
          });
        });

        document.getElementById('detail-modal').classList.remove('hidden');
      });
    });

    document.getElementById('close-detail-modal')?.addEventListener('click', () => {
      document.getElementById('detail-modal').classList.add('hidden');
    });
    document.getElementById('detail-modal')?.addEventListener('click', (e) => {
      if (e.target.id === 'detail-modal') document.getElementById('detail-modal').classList.add('hidden');
    });

    // ── Delete ─────────────────────────────────────────────────
    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id;
        if (!confirm('Êtes-vous sûr ?')) return;
        try {
          const res = await fetch(`/api/inquiries/${id}`, { method: 'DELETE' });
          if (res.ok) document.querySelector(`tr[data-id="${id}"]`).remove();
          else alert('Erreur');
        } catch { alert('Erreur réseau'); }
      });
    });

    // ── Confirm modal helpers ──────────────────────────────────
    function calcTotal(products) {
      return products.reduce((sum, p) => sum + (parseFloat(p._price || 0) * parseInt(p._qty || p.quantity || 1)), 0);
    }

    function openConfirmModal(inquiry) {
      const products = (inquiry.products || []).map(p => ({
        ...p,
        _price: 0,
        _qty: p.quantity || 1,
      }));
      inquiry._editProducts = products;

      if (ACTIVE_MODAL === 'a') openModalA(inquiry);
      else if (ACTIVE_MODAL === 'b') openModalB(inquiry);
      else openModalC(inquiry);
    }

    document.querySelectorAll('.confirm-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.id;
        const inquiry = inquiries.find(i => i.id == id);
        if (inquiry) openConfirmModal(inquiry);
      });
    });

    document.querySelectorAll('.close-confirm-modal').forEach(btn => {
      btn.addEventListener('click', () => {
        document.getElementById('confirm-modal-a').classList.add('hidden');
        document.getElementById('confirm-modal-b').classList.add('hidden');
        document.getElementById('confirm-modal-c').classList.add('hidden');
      });
    });

    // ── MODAL A ────────────────────────────────────────────────
    function openModalA(inquiry) {
      document.getElementById('cma-devis-num').textContent = getDevisNum(inquiry.id);
      document.getElementById('cma-client').textContent = inquiry.client_name;
      document.getElementById('cma-phone').textContent = inquiry.client_phone;
      document.getElementById('cma-delivery').value = inquiry.delivery_type || 'avion';

      const container = document.getElementById('cma-products-container');
      container.innerHTML = '';

      // Per-product new photos storage
      inquiry._editProducts.forEach(p => { p._newPhotos = p._newPhotos || []; });

      inquiry._editProducts.forEach((p, i) => {
        const card = document.createElement('div');
        card.className = 'bg-white border border-gray-200 rounded-lg p-4 sm:p-5 space-y-3 cma-product-card';
        card.dataset.idx = i;

        // Product name with border
        const nameWrap = document.createElement('div');
        nameWrap.className = 'border border-gray-200 rounded-lg px-3 py-2 bg-gray-50 focus-within:border-emerald-400 focus-within:bg-white transition-colors';
        const nameInput = document.createElement('input');
        nameInput.type = 'text';
        nameInput.value = p.name.replace(/"/g,'&quot;');
        nameInput.className = 'w-full text-sm font-semibold text-gray-900 bg-transparent border-0 p-0 focus:outline-none focus:ring-0 cma-name';
        nameInput.dataset.idx = i;
        nameInput.placeholder = 'Nom du produit';
        nameWrap.appendChild(nameInput);
        card.appendChild(nameWrap);

        // Qty & Price inline
        const qtyPriceDiv = document.createElement('div');
        qtyPriceDiv.className = 'grid grid-cols-2 gap-3 sm:gap-4';
        qtyPriceDiv.innerHTML = `
          <div>
            <p class="text-xs font-bold text-gray-500 uppercase mb-1">Qté</p>
            <input type="number" min="1" value="${p._qty}" class="w-full text-center border border-gray-200 rounded-lg px-2 py-1.5 text-sm font-medium focus:outline-none focus:border-emerald-400 cma-qty" data-idx="${i}"/>
          </div>
          <div>
            <p class="text-xs font-bold text-gray-500 uppercase mb-1">Prix unit. (FCFA)</p>
            <input type="number" min="0" value="0" placeholder="0" class="w-full text-right border border-gray-200 rounded-lg px-2 py-1.5 text-sm font-medium focus:outline-none focus:border-emerald-400 cma-price" data-idx="${i}"/>
          </div>
        `;
        card.appendChild(qtyPriceDiv);

        // State (Neuf / Occasion)
        const stateDiv = document.createElement('div');
        stateDiv.className = 'space-y-2';
        stateDiv.innerHTML = `
          <p class="text-xs font-bold text-gray-500 uppercase">État</p>
          <div class="flex gap-4">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name="cma-state-${i}" value="Neuf" ${p.state === 'Neuf' ? 'checked' : ''} class="cma-state-radio" data-idx="${i}"/>
              <span class="text-sm text-gray-700">Neuf</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name="cma-state-${i}" value="Occasion" ${p.state === 'Occasion' ? 'checked' : ''} class="cma-state-radio" data-idx="${i}"/>
              <span class="text-sm text-gray-700">Occasion</span>
            </label>
          </div>
        `;
        card.appendChild(stateDiv);

        // Photo upload section
        const photoDiv = document.createElement('div');
        photoDiv.className = 'space-y-2';
        photoDiv.innerHTML = `
          <label class="flex items-center justify-center gap-2 px-4 py-3 border-2 border-dashed border-emerald-300 bg-emerald-50 rounded-lg cursor-pointer hover:border-emerald-400 hover:bg-emerald-100 transition-colors cma-upload-label" data-idx="${i}">
            <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            <span class="text-sm font-semibold text-emerald-700">📸 Ajouter des photos</span>
            <input type="file" accept="image/*" multiple class="hidden cma-file-input" data-idx="${i}"/>
          </label>
          <div class="flex flex-wrap gap-2 cma-photo-grid" data-idx="${i}"></div>
        `;
        card.appendChild(photoDiv);

        // Subtotal
        const subtotalDiv = document.createElement('div');
        subtotalDiv.className = 'pt-3 border-t border-gray-200 text-right';
        subtotalDiv.innerHTML = `<p class="text-sm font-semibold text-gray-900">Sous-total : <span class="cma-subtotal" data-idx="${i}">0 FCFA</span></p>`;
        card.appendChild(subtotalDiv);

        container.appendChild(card);

        // Wire up file input
        const fileInput = card.querySelector('.cma-file-input');
        const photoGrid = card.querySelector('.cma-photo-grid');
        fileInput.addEventListener('change', () => {
          Array.from(fileInput.files).forEach(file => {
            if (!file.type.startsWith('image/')) return;
            p._newPhotos.push(file);
            const reader = new FileReader();
            reader.onload = e => {
              const thumb = document.createElement('div');
              thumb.className = 'relative w-16 h-16 rounded-lg overflow-hidden border border-gray-300 flex-shrink-0 bg-gray-100';
              const fileRef = file;
              thumb.innerHTML = `<img src="${e.target.result}" class="w-full h-full object-cover"/>
                <button type="button" class="absolute top-0.5 right-0.5 w-5 h-5 bg-black/70 text-white rounded text-[11px] flex items-center justify-center font-bold cma-rm-photo hover:bg-black/90">✕</button>`;
              thumb.querySelector('.cma-rm-photo').addEventListener('click', (ev) => {
                ev.preventDefault();
                p._newPhotos = p._newPhotos.filter(f => f !== fileRef);
                thumb.remove();
              });
              photoGrid.appendChild(thumb);
            };
            reader.readAsDataURL(file);
          });
          fileInput.value = '';
        });
      });

      function refreshTotalA() {
        let total = 0;
        inquiry._editProducts.forEach((p, i) => {
          p._qty = parseInt(container.querySelector(`.cma-qty[data-idx="${i}"]`).value) || 1;
          p._price = parseFloat(container.querySelector(`.cma-price[data-idx="${i}"]`).value) || 0;
          const nameEl = container.querySelector(`.cma-name[data-idx="${i}"]`);
          if (nameEl) p.name = nameEl.value;

          const stateRadios = container.querySelectorAll(`input[name="cma-state-${i}"]:checked`);
          if (stateRadios.length > 0) p.state = stateRadios[0].value;

          const subtotal = p._qty * p._price;
          total += subtotal;
          const subtotalEl = container.querySelector(`.cma-subtotal[data-idx="${i}"]`);
          if (subtotalEl) subtotalEl.textContent = fmt(subtotal) + ' FCFA';
        });
        document.getElementById('cma-total').textContent = fmt(total) + ' FCFA';
      }

      container.addEventListener('input', refreshTotalA);
      refreshTotalA();

      document.getElementById('cma-send').onclick = () => sendConfirm(inquiry, 'a');
      document.getElementById('confirm-modal-a').classList.remove('hidden');
    }

    // ── MODAL B ────────────────────────────────────────────────
    function openModalB(inquiry) {
      document.getElementById('cmb-devis-num').textContent = getDevisNum(inquiry.id);
      document.getElementById('cmb-client').textContent = inquiry.client_name;
      document.getElementById('cmb-phone').textContent = inquiry.client_phone;

      const avionLabel = document.getElementById('cmb-del-avion');
      const bateauLabel = document.getElementById('cmb-del-bateau');
      const delivery = inquiry.delivery_type || 'avion';
      document.querySelector(`input[name="cmb-delivery"][value="${delivery}"]`).checked = true;
      avionLabel.className = delivery === 'avion'
        ? 'flex items-center gap-2 p-3 border-2 border-emerald-400 bg-emerald-50 rounded-xl cursor-pointer text-sm font-semibold text-emerald-700'
        : 'flex items-center gap-2 p-3 border-2 border-gray-200 rounded-xl cursor-pointer text-sm font-semibold text-gray-600';
      bateauLabel.className = delivery === 'bateau'
        ? 'flex items-center gap-2 p-3 border-2 border-emerald-400 bg-emerald-50 rounded-xl cursor-pointer text-sm font-semibold text-emerald-700'
        : 'flex items-center gap-2 p-3 border-2 border-gray-200 rounded-xl cursor-pointer text-sm font-semibold text-gray-600';

      document.querySelectorAll('input[name="cmb-delivery"]').forEach(r => {
        r.addEventListener('change', () => {
          avionLabel.className = r.value === 'avion' && r.checked
            ? 'flex items-center gap-2 p-3 border-2 border-emerald-400 bg-emerald-50 rounded-xl cursor-pointer text-sm font-semibold text-emerald-700'
            : 'flex items-center gap-2 p-3 border-2 border-gray-200 rounded-xl cursor-pointer text-sm font-semibold text-gray-600';
          bateauLabel.className = r.value === 'bateau' && r.checked
            ? 'flex items-center gap-2 p-3 border-2 border-emerald-400 bg-emerald-50 rounded-xl cursor-pointer text-sm font-semibold text-emerald-700'
            : 'flex items-center gap-2 p-3 border-2 border-gray-200 rounded-xl cursor-pointer text-sm font-semibold text-gray-600';
        });
      });

      const list = document.getElementById('cmb-products-list');
      list.innerHTML = '';
      inquiry._editProducts.forEach((p, i) => {
        const div = document.createElement('div');
        div.className = 'bg-gray-50 rounded-xl p-3';
        div.innerHTML = `
          <p class="text-sm font-semibold text-gray-800 mb-2">${p.name} ${p.state ? `<span class='text-xs text-gray-400 font-normal'>(${p.state})</span>` : ''}</p>
          <div class="flex gap-3">
            <div class="flex-1">
              <p class="text-xs text-gray-500 mb-1">Qté</p>
              <input type="number" min="1" value="${p._qty}" class="w-full border border-gray-200 rounded-lg px-2 py-1.5 text-sm text-center focus:outline-none focus:border-emerald-400 cmb-qty" data-idx="${i}"/>
            </div>
            <div class="flex-1">
              <p class="text-xs text-gray-500 mb-1">Prix unit. (F)</p>
              <input type="number" min="0" value="0" placeholder="0" class="w-full border border-gray-200 rounded-lg px-2 py-1.5 text-sm text-right focus:outline-none focus:border-emerald-400 cmb-price" data-idx="${i}"/>
            </div>
            <div class="flex-1 text-right">
              <p class="text-xs text-gray-500 mb-1">Sous-total</p>
              <p class="text-sm font-bold text-gray-900 py-1.5 cmb-row-total" data-idx="${i}">0 F</p>
            </div>
          </div>
        `;
        list.appendChild(div);
      });

      function refreshTotalB() {
        inquiry._editProducts.forEach((p, i) => {
          p._qty = parseInt(list.querySelector(`.cmb-qty[data-idx="${i}"]`).value) || 1;
          p._price = parseFloat(list.querySelector(`.cmb-price[data-idx="${i}"]`).value) || 0;
          list.querySelector(`.cmb-row-total[data-idx="${i}"]`).textContent = fmt(p._price * p._qty) + ' F';
        });
        document.getElementById('cmb-total').textContent = fmt(calcTotal(inquiry._editProducts)) + ' F';
      }

      list.addEventListener('input', refreshTotalB);
      refreshTotalB();

      document.getElementById('cmb-send').onclick = () => sendConfirm(inquiry, 'b');
      document.getElementById('confirm-modal-b').classList.remove('hidden');
    }

    // ── MODAL C ────────────────────────────────────────────────
    function openModalC(inquiry) {
      // Reset to step 1
      document.getElementById('cmc-step1').classList.remove('hidden');
      document.getElementById('cmc-step2').classList.add('hidden');
      document.getElementById('cmc-next').classList.remove('hidden');
      document.getElementById('cmc-send').classList.add('hidden');
      document.getElementById('cmc-back').classList.add('hidden');
      document.getElementById('cmc-step1-badge').className = 'flex items-center gap-2 text-sm font-semibold text-blue-600';
      document.getElementById('cmc-step1-badge').querySelector('span').className = 'w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center text-xs font-bold';
      document.getElementById('cmc-step2-badge').className = 'flex items-center gap-2 text-sm font-semibold text-gray-400';
      document.getElementById('cmc-step2-badge').querySelector('span').className = 'w-6 h-6 bg-gray-200 text-gray-400 rounded-full flex items-center justify-center text-xs font-bold';

      document.getElementById('cmc-client').textContent = inquiry.client_name;
      document.getElementById('cmc-phone').textContent = inquiry.client_phone;
      document.getElementById('cmc-delivery').value = inquiry.delivery_type || 'avion';

      const editContainer = document.getElementById('cmc-products-edit');
      editContainer.innerHTML = '';
      inquiry._editProducts.forEach((p, i) => {
        const div = document.createElement('div');
        div.className = 'flex items-center gap-3 bg-gray-50 rounded-xl px-3 py-2.5';
        div.innerHTML = `
          <div class="flex-1 text-sm font-medium text-gray-800">${p.name} ${p.state ? `<span class='text-xs text-gray-400'>(${p.state})</span>` : ''}</div>
          <div>
            <p class="text-xs text-gray-400 mb-0.5 text-center">Qté</p>
            <input type="number" min="1" value="${p._qty}" class="w-16 border border-gray-200 rounded-lg px-2 py-1 text-sm text-center focus:outline-none focus:border-blue-400 cmc-qty" data-idx="${i}"/>
          </div>
          <div>
            <p class="text-xs text-gray-400 mb-0.5 text-center">Prix (F)</p>
            <input type="number" min="0" value="0" placeholder="0" class="w-28 border border-gray-200 rounded-lg px-2 py-1 text-sm text-right focus:outline-none focus:border-blue-400 cmc-price" data-idx="${i}"/>
          </div>
        `;
        editContainer.appendChild(div);
      });

      // Next → step 2
      document.getElementById('cmc-next').onclick = () => {
        // Save values
        inquiry._editProducts.forEach((p, i) => {
          p._qty = parseInt(editContainer.querySelector(`.cmc-qty[data-idx="${i}"]`).value) || 1;
          p._price = parseFloat(editContainer.querySelector(`.cmc-price[data-idx="${i}"]`).value) || 0;
        });

        // Build preview
        const deliveryVal = document.getElementById('cmc-delivery').value;
        document.getElementById('cmc-preview-num').textContent = getDevisNum(inquiry.id);
        document.getElementById('cmc-preview-client').textContent = `${inquiry.client_name} · ${inquiry.client_phone}`;
        document.getElementById('cmc-preview-delivery').textContent = deliveryVal === 'bateau' ? '🚢 Bateau' : '✈️ Avion';
        document.getElementById('cmc-preview-total').textContent = fmt(calcTotal(inquiry._editProducts)) + ' F';

        const preview = document.getElementById('cmc-preview-products');
        preview.innerHTML = inquiry._editProducts.map(p => `
          <div class="flex justify-between">
            <span class="text-gray-700">${p.name} ×${p._qty}</span>
            <span class="font-semibold text-gray-900">${fmt(p._price * p._qty)} F</span>
          </div>
        `).join('');

        document.getElementById('cmc-step1').classList.add('hidden');
        document.getElementById('cmc-step2').classList.remove('hidden');
        document.getElementById('cmc-next').classList.add('hidden');
        document.getElementById('cmc-send').classList.remove('hidden');
        document.getElementById('cmc-back').classList.remove('hidden');
        document.getElementById('cmc-step1-badge').className = 'flex items-center gap-2 text-sm font-semibold text-gray-400';
        document.getElementById('cmc-step1-badge').querySelector('span').className = 'w-6 h-6 bg-gray-200 text-gray-400 rounded-full flex items-center justify-center text-xs font-bold';
        document.getElementById('cmc-step2-badge').className = 'flex items-center gap-2 text-sm font-semibold text-blue-600';
        document.getElementById('cmc-step2-badge').querySelector('span').className = 'w-6 h-6 bg-blue-600 text-white rounded-full flex items-center justify-center text-xs font-bold';
      };

      document.getElementById('cmc-back').onclick = () => {
        document.getElementById('cmc-step1').classList.remove('hidden');
        document.getElementById('cmc-step2').classList.add('hidden');
        document.getElementById('cmc-next').classList.remove('hidden');
        document.getElementById('cmc-send').classList.add('hidden');
        document.getElementById('cmc-back').classList.add('hidden');
      };

      document.getElementById('cmc-send').onclick = () => sendConfirm(inquiry, 'c');
      document.getElementById('confirm-modal-c').classList.remove('hidden');
    }

    // ── Send confirm (shared) ──────────────────────────────────
    async function sendConfirm(inquiry, modalId) {
      const delivery = modalId === 'a'
        ? document.getElementById('cma-delivery').value
        : modalId === 'b'
        ? document.querySelector('input[name="cmb-delivery"]:checked')?.value || 'avion'
        : document.getElementById('cmc-delivery').value;

      const note = modalId === 'a'
        ? document.getElementById('cma-note').value
        : modalId === 'c'
        ? document.getElementById('cmc-note').value
        : '';

      try {
        const res = await fetch(`/api/inquiries/confirm`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            inquiry_id: inquiry.id,
            products: inquiry._editProducts.map(p => ({
              name: p.name,
              state: p.state,
              quantity: p._qty,
              price: p._price,
              photos: p.photos || [],
            })),
            total: calcTotal(inquiry._editProducts),
            delivery_type: delivery,
            note,
          }),
        });

        if (res.ok) {
          const data = await res.json();
          ['a','b','c'].forEach(id => document.getElementById(`confirm-modal-${id}`).classList.add('hidden'));

          // Update status select in row
          const select = document.querySelector(`.status-select[data-id="${inquiry.id}"]`);
          if (select) {
            select.value = 'acceptee';
            select.className = select.className.replace(/bg-\w+-100|text-\w+-800/g, '');
            select.classList.add('bg-green-100', 'text-green-800');
          }

          // Show success with devis link
          const baseUrl = window.location.origin;
          const devisLink = `${baseUrl}/devis/${data.access_token}`;
          const message = `✓ Devis créé : ${data.devis_number}\n\nLien client :\n${devisLink}\n\n(Copié dans le presse-papiers)`;

          // Copy link to clipboard
          navigator.clipboard.writeText(devisLink).catch(() => {});

          alert(message);
        } else {
          const error = await res.json();
          alert(`Erreur : ${error.error || 'Confirmation échouée'}`);
        }
      } catch (e) {
        console.error(e);
        alert('Erreur réseau');
      }
    }
  </script>
</Layout>
